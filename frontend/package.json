{
  "name": "veredito-frontend",
  "version": "0.4.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/write-build-info.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/write-build-info.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/write-build-info.mjs",
    "test": "ng test",
    "prei18n:extract": "node scripts/write-build-info.mjs",
    "i18n:extract": "ng extract-i18n --format=xlf2 --output-path src/locale",
    "prei18n:check": "node scripts/write-build-info.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/localize": "^22.2.6",
    "@playwright/test": "1.65.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
