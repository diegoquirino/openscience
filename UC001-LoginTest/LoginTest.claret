systemName "Email"
usecase "Login User" {
  version "2.2" type "Maintenance (Split): one invalid-credentials exception per condition, same generic alert" user "Dalton" date "01/01/2018"
  requirements "REQ-07, REQ-08, REQ-09"
  actor emailUser "Email User"
  preCondition "There is an active network connection."
  basic {
    step 1 emailUser "launches the authentication screen"
    step 2 system "allows users to authenticate using their username and password through a form with username field, masked password field, and submit button"
    step 3 emailUser "fills out the username and password fields and clicks on the submit button" af[1]
    step 4 system "confirms successful authentication and grants session access" ef[1,2,3]
    step 5 emailUser "continues into the authenticated session"
    step 6 system "notifies the user via email of the successful login"
    step 7 emailUser "opens the login notification email"
    step 8 system "records the login event in the audit log with timestamp and user identity"
  }
  alternative 1 "Username is predicted" {
    step 1 emailUser "chooses one of the username alternatives recommended by the system and subsequently enters the corresponding confidential credentials into the designated masked password field. Once the required authentication information has been properly provided, the user proceeds with the login attempt by activating the control responsible for submitting the completed form" bs 4
  }
  exception 1 "Invalid credentials: unknown username" {
    step 1 system "rejects the unknown username and alerts: Invalid credentials: unknown username or incorrect password"
  }
  exception 2 "Invalid credentials: incorrect password" {
    step 1 system "rejects the incorrect password and alerts: Invalid credentials: unknown username or incorrect password"
  }
  exception 3 "Unified password policy (formerly separate length and uppercase checks)" {
    step 1 system "alerts: password contains fewer than some characters or no suitable letter"
  }
  postCondition "User successfully authenticated, notified by email, and login recorded in the audit log"
}
