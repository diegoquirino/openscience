ALTS_SPECIFICATION "Administrador Deleta Terminal" {
  VERSION: "1.0"
  PRE_CONDITION: "Administrador logado; Existe ao menos um Terminal cadastrado."
  POST_CONDITION: "Terminal foi deletado."

  ACTORS {
    Administrador: "Usuario Administrador"
    system: "Bazooca"
  }

  STATES {
    S_INIT [initial, guard: "Administrador logado; Existe ao menos um Terminal cadastrado."]
    S_BF_1 [flow: "basic", actor: "Administrador", action: "Entra na tela de Listagem de Terminais"]
    S_BF_2 [flow: "basic", actor: "system", action: "lista o conjunto de termianis cadastrados no sistema"]
    S_BF_3 [flow: "basic", actor: "Administrador", action: "clica em um dos terminais listados", branches_af: [1, 2]]
    S_BF_4 [flow: "basic", actor: "system", action: "apresenta tela de edicao de Terminal"]
    S_BF_5 [flow: "basic", actor: "Administrador", action: "clica em botao de 'Remover' na tela de edicao"]
    S_BF_6 [flow: "basic", actor: "system", action: "exibe popup de confirmacao"]
    S_BF_7 [flow: "basic", actor: "Administrador", action: "confirma clicando no botao 'Sim'", branches_af: [3]]
    S_BF_8 [flow: "basic", actor: "system", action: "noficica usuario de que Terminal foi deletado com sucesso."]
    S_AF1_1 [flow: "alternative_1", description: "Navega pelas paginas da lista", actor: "Administrador", action: "navega nas paginas da lista", returns_to_bf: 2]
    S_AF2_1 [flow: "alternative_2", description: "Usuario ordena lista de Terminais", actor: "Administrador", action: "ordena os terminais por seus atributos", returns_to_bf: 2]
    S_AF3_1 [flow: "alternative_3", description: "Cancela delecao do Terinal", actor: "Administrador", action: "clica no botao 'Não' do popup", returns_to_bf: 4]
    S_END [terminal, guard: "Terminal foi deletado."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: lista o conjunto de termianis cadastrados no sistema"]
    S_BF_2 -> S_BF_3 [event: "Administrador: clica em um dos terminais listados"]
    S_BF_3 -> S_BF_4 [event: "system: apresenta tela de edicao de Terminal"]
    S_BF_3 -> S_AF1_1 [branch: "AF_1 - Navega pelas paginas da lista"]
    S_BF_3 -> S_AF2_1 [branch: "AF_2 - Usuario ordena lista de Terminais"]
    S_BF_4 -> S_BF_5 [event: "Administrador: clica em botao de 'Remover' na tela de edicao"]
    S_BF_5 -> S_BF_6 [event: "system: exibe popup de confirmacao"]
    S_BF_6 -> S_BF_7 [event: "Administrador: confirma clicando no botao 'Sim'"]
    S_BF_7 -> S_BF_8 [event: "system: noficica usuario de que Terminal foi deletado com sucesso."]
    S_BF_7 -> S_AF3_1 [branch: "AF_3 - Cancela delecao do Terinal"]
    S_BF_8 -> S_END [event: "Complete"]
    S_AF1_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF2_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF3_1 -> S_BF_4 [resume_basic_flow: 4]
  }
}
