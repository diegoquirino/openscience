ALTS_SPECIFICATION "Administrador Resolve Ocorrencia De Nota" {
  VERSION: "1.0"
  PRE_CONDITION: "Usuario Administrador esta logado no sistema. Existe pelo meno uma nota com ocorrencia registrada."
  POST_CONDITION: "A ocorrencia esta resolvida e nota possui estado de ocorrencia resolvida"

  ACTORS {
    Administrador: "Usuario Administrador"
    system: "Bazooca"
  }

  STATES {
    S_INIT [initial, guard: "Usuario Administrador esta logado no sistema. Existe pelo meno uma nota com ocorrencia registrada."]
    S_BF_1 [flow: "basic", actor: "Administrador", action: "clica na opcao 'Central de Operacoes' no menu da tela principal"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe Dashboard do sistema"]
    S_BF_3 [flow: "basic", actor: "Administrador", action: "clica em contador de 'Notas Pendentes' no card de 'Ocorrencias'", branches_af: [1, 3, 4, 5]]
    S_BF_4 [flow: "basic", actor: "system", action: "abre uma tela com a lista de 'Notas'"]
    S_BF_5 [flow: "basic", actor: "Administrador", action: "seleciona alguma Nota da lista", branches_af: [2]]
    S_BF_6 [flow: "basic", actor: "system", action: "exibe os dados da Nota"]
    S_BF_7 [flow: "basic", actor: "Administrador", action: "clica no botao de 'Resolver'", branches_af: [6]]
    S_BF_8 [flow: "basic", actor: "system", action: "abre modal para detalhamento de 'Contato'"]
    S_BF_9 [flow: "basic", actor: "Administrador", action: "digita detalhamento de Contato e clica em 'Confirmar'", branches_af: [4]]
    S_BF_10 [flow: "basic", actor: "system", action: "notifica que Ocorrencia foi resolvida com sucesso"]
    S_AF1_1 [flow: "alternative_1", description: "Navega pelas paginas da lista", actor: "Administrador", action: "seleciona outra pagina", returns_to_bf: 4]
    S_AF2_1 [flow: "alternative_2", description: "Clica no botao Voltar", actor: "Administrador", action: "clica no botao 'Voltar'", returns_to_bf: 2]
    S_AF3_1 [flow: "alternative_3", description: "Ordena Notas", actor: "Administrador", action: "ordenas as coletas por alguma coluna", returns_to_bf: 4]
    S_AF4_1 [flow: "alternative_4", description: "Cancela resolucao de ocorrencia", actor: "Administrador", action: "clica em botao 'Cancelar'", returns_to_bf: 6]
    S_AF5_1 [flow: "alternative_5", description: "Filtra notas da lista", actor: "Administrador", action: "filtra as notas por algum campo", returns_to_bf: 4]
    S_AF6_1 [flow: "alternative_6", description: "Volta para lista de notas", actor: "Administrador", action: "clica em botao 'Voltar'", returns_to_bf: 4]
    S_END [terminal, guard: "A ocorrencia esta resolvida e nota possui estado de ocorrencia resolvida"]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe Dashboard do sistema"]
    S_BF_2 -> S_BF_3 [event: "Administrador: clica em contador de 'Notas Pendentes' no card de 'Ocorrencias'"]
    S_BF_3 -> S_BF_4 [event: "system: abre uma tela com a lista de 'Notas'"]
    S_BF_3 -> S_AF1_1 [branch: "AF_1 - Navega pelas paginas da lista"]
    S_BF_3 -> S_AF3_1 [branch: "AF_3 - Ordena Notas"]
    S_BF_3 -> S_AF4_1 [branch: "AF_4 - Cancela resolucao de ocorrencia"]
    S_BF_3 -> S_AF5_1 [branch: "AF_5 - Filtra notas da lista"]
    S_BF_4 -> S_BF_5 [event: "Administrador: seleciona alguma Nota da lista"]
    S_BF_5 -> S_BF_6 [event: "system: exibe os dados da Nota"]
    S_BF_5 -> S_AF2_1 [branch: "AF_2 - Clica no botao Voltar"]
    S_BF_6 -> S_BF_7 [event: "Administrador: clica no botao de 'Resolver'"]
    S_BF_7 -> S_BF_8 [event: "system: abre modal para detalhamento de 'Contato'"]
    S_BF_7 -> S_AF6_1 [branch: "AF_6 - Volta para lista de notas"]
    S_BF_8 -> S_BF_9 [event: "Administrador: digita detalhamento de Contato e clica em 'Confirmar'"]
    S_BF_9 -> S_BF_10 [event: "system: notifica que Ocorrencia foi resolvida com sucesso"]
    S_BF_9 -> S_AF4_1 [branch: "AF_4 - Cancela resolucao de ocorrencia"]
    S_BF_10 -> S_END [event: "Complete"]
    S_AF1_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF2_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF3_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF4_1 -> S_BF_6 [resume_basic_flow: 6]
    S_AF5_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF6_1 -> S_BF_4 [resume_basic_flow: 4]
  }
}
