ALTS_SPECIFICATION "CRUD Laboratorios" {
  VERSION: "1.0"
  PRE_CONDITION: "Estar logado como super administrador"
  POST_CONDITION: ""

  ACTORS {
    superAdmin: "Super administrador"
  }

  STATES {
    S_INIT [initial, guard: "Estar logado como super administrador"]
    S_BF_1 [flow: "basic", actor: "superAdmin", action: "seleciona opção 'Laboratories' no menu Settings"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe lista de laboratórios"]
    S_BF_3 [flow: "basic", actor: "superAdmin", action: "seleciona o botão 'Create Laboratories'"]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe página com campos de cadastro de novo Laboratório"]
    S_BF_5 [flow: "basic", actor: "superAdmin", action: "preenche corretamente os campos 'Name', 'Country' e 'Description' e pressiona o botão 'Create'", branches_af: [1, 2, 4]]
    S_BF_6 [flow: "basic", actor: "system", action: "exibe página com dados do novo Laboratório e mensagem que um novo entrada foi adicionado"]
    S_BF_7 [flow: "basic", actor: "superAdmin", action: "seleciona opção 'Laboratories' no menu Settings"]
    S_BF_8 [flow: "basic", actor: "system", action: "exibe lista de laboratórios"]
    S_BF_9 [flow: "basic", actor: "superAdmin", action: "clica no nome de um Laboratório"]
    S_BF_10 [flow: "basic", actor: "system", action: "exibe dados do Laboratório e lista de usuários associados a este"]
    S_BF_11 [flow: "basic", actor: "superAdmin", action: "clica no botão 'Cancel'", branches_af: [3]]
    S_BF_12 [flow: "basic", actor: "system", action: "retorna a lista de laboratórios"]
    S_AF1_1 [flow: "alternative_1", description: "Campo fora da formatação esperada, e.g, Country = xx", actor: "superAdmin", action: "preenche incorretamente algum dos campos 'Name', 'Country' ou 'Description' e pressiona o botão 'Create'"]
    S_AF1_2 [flow: "alternative_1", description: "Campo fora da formatação esperada, e.g, Country = xx", actor: "system", action: "exibe mensagem informando que os dados não correspondem a formatação esperada", returns_to_bf: 5]
    S_AF2_1 [flow: "alternative_2", description: "Cancela criação", actor: "superAdmin", action: "cancela criação", returns_to_bf: 2]
    S_AF3_1 [flow: "alternative_3", description: "Edita dados", actor: "superAdmin", action: "clica no botão 'Edit'"]
    S_AF3_2 [flow: "alternative_3", description: "Edita dados", actor: "system", action: "exibe campos do Laboratório com valores atuais que podem ser editados"]
    S_AF3_3 [flow: "alternative_3", description: "Edita dados", actor: "superAdmin", action: "preenche os novos valores e pressiona o botão 'Update", returns_to_bf: 2]
    S_AF4_1 [flow: "alternative_4", description: "Nome de Laboratório já existente", actor: "superAdmin", action: "preenche o campo 'Name' com um nome de laboratório jã existente. Preenche corretamente os campos 'Country' e 'Description' e pressiona o botão 'Create'"]
    S_AF4_2 [flow: "alternative_4", description: "Nome de Laboratório já existente", actor: "system", action: "exibe mensagem informando que já existe laboratório cadastrado com esse nome", returns_to_bf: 5]
    S_END [terminal, guard: ""]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe lista de laboratórios"]
    S_BF_2 -> S_BF_3 [event: "superAdmin: seleciona o botão 'Create Laboratories'"]
    S_BF_3 -> S_BF_4 [event: "system: exibe página com campos de cadastro de novo Laboratório"]
    S_BF_4 -> S_BF_5 [event: "superAdmin: preenche corretamente os campos 'Name', 'Country' e 'Description' e pressiona o botão 'Create'"]
    S_BF_5 -> S_BF_6 [event: "system: exibe página com dados do novo Laboratório e mensagem que um novo entrada foi adicionado"]
    S_BF_5 -> S_AF1_1 [branch: "AF_1 - Campo fora da formatação esperada, e.g, Country = xx"]
    S_BF_5 -> S_AF2_1 [branch: "AF_2 - Cancela criação"]
    S_BF_5 -> S_AF4_1 [branch: "AF_4 - Nome de Laboratório já existente"]
    S_BF_6 -> S_BF_7 [event: "superAdmin: seleciona opção 'Laboratories' no menu Settings"]
    S_BF_7 -> S_BF_8 [event: "system: exibe lista de laboratórios"]
    S_BF_8 -> S_BF_9 [event: "superAdmin: clica no nome de um Laboratório"]
    S_BF_9 -> S_BF_10 [event: "system: exibe dados do Laboratório e lista de usuários associados a este"]
    S_BF_10 -> S_BF_11 [event: "superAdmin: clica no botão 'Cancel'"]
    S_BF_11 -> S_BF_12 [event: "system: retorna a lista de laboratórios"]
    S_BF_11 -> S_AF3_1 [branch: "AF_3 - Edita dados"]
    S_BF_12 -> S_END [event: "Complete"]
    S_AF1_1 -> S_AF1_2 [event: "system: exibe mensagem informando que os dados não correspondem a formatação esperada"]
    S_AF1_2 -> S_BF_5 [resume_basic_flow: 5]
    S_AF2_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF3_1 -> S_AF3_2 [event: "system: exibe campos do Laboratório com valores atuais que podem ser editados"]
    S_AF3_2 -> S_AF3_3 [event: "superAdmin: preenche os novos valores e pressiona o botão 'Update"]
    S_AF3_3 -> S_BF_2 [resume_basic_flow: 2]
    S_AF4_1 -> S_AF4_2 [event: "system: exibe mensagem informando que já existe laboratório cadastrado com esse nome"]
    S_AF4_2 -> S_BF_5 [resume_basic_flow: 5]
  }
}
