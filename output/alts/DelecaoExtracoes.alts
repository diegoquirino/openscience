ALTS_SPECIFICATION "Delecao de Extracoes" {
  VERSION: "1.0"
  PRE_CONDITION: "Usuario deve estar logado no servidor e extrator como administrador ; 705 extracoes ja foram realizadas (pasta “EXTRACT_FILE_IPP320_AKIRA”)"
  POST_CONDITION: ""

  ACTORS {
    administrador: "Administrador do sistema"
  }

  STATES {
    S_INIT [initial, guard: "Usuario deve estar logado no servidor e extrator como administrador ; 705 extracoes ja foram realizadas (pasta “EXTRACT_FILE_IPP320_AKIRA”)"]
    S_BF_1 [flow: "basic", actor: "administrador", action: "seleciona o check box referente a extracao referente ao numero serial 12311PP30154516”", branches_af: [2, 3]]
    S_BF_2 [flow: "basic", actor: "system", action: "marca selecao com um tick"]
    S_BF_3 [flow: "basic", actor: "administrador", action: "pressiona o botao “Delete extractions”"]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe uma mensagem pop-up solicitando a confirmação da delecao"]
    S_BF_5 [flow: "basic", actor: "administrador", action: "confirma delecao", branches_af: [1]]
    S_BF_6 [flow: "basic", actor: "system", action: "exibe a lista de extracoes com 704 entradas"]
    S_AF1_1 [flow: "alternative_1", description: "Cancela delecao", actor: "administrador", action: "cancela delecao"]
    S_AF1_2 [flow: "alternative_1", description: "Cancela delecao", actor: "system", action: "fecha janela pop-up", returns_to_bf: 1]
    S_AF2_1 [flow: "alternative_2", description: "Realiza Filtro e delecao", actor: "administrador", action: "seleciona combo box referente ao filtro por “State”"]
    S_AF2_2 [flow: "alternative_2", description: "Realiza Filtro e delecao", actor: "system", action: "exibe opcoes “Activated”, “Alert Interruption”, “Deactivated”, “Mockup” e “Error”"]
    S_AF2_3 [flow: "alternative_2", description: "Realiza Filtro e delecao", actor: "administrador", action: "seleciona opcao “Activated” no campo de filtro “State”"]
    S_AF2_4 [flow: "alternative_2", description: "Realiza Filtro e delecao", actor: "system", action: "atualiza pagina mostrando 608 extracoes"]
    S_AF2_5 [flow: "alternative_2", description: "Realiza Filtro e delecao", actor: "administrador", action: "seleciona o check box que marca todas extracoes para delecao"]
    S_AF2_6 [flow: "alternative_2", description: "Realiza Filtro e delecao", actor: "system", action: "marca todas extracoes após o filtro com um tick"]
    S_AF2_7 [flow: "alternative_2", description: "Realiza Filtro e delecao", actor: "administrador", action: "pressiona o botao “Delete extractions”"]
    S_AF2_8 [flow: "alternative_2", description: "Realiza Filtro e delecao", actor: "system", action: "exibe uma mensagem pop-up solicitando a confirmacao da delecao"]
    S_AF2_9 [flow: "alternative_2", description: "Realiza Filtro e delecao", actor: "administrador", action: "confirma delecao"]
    S_AF2_10 [flow: "alternative_2", description: "Realiza Filtro e delecao", actor: "system", action: "exibe a lista de extracoes com 96 entradas"]
    S_AF3_1 [flow: "alternative_3", description: "Deleta todas extracoes", actor: "administrador", action: "seleciona o check box que marca todas extracoes para delecao"]
    S_AF3_2 [flow: "alternative_3", description: "Deleta todas extracoes", actor: "system", action: "marca o check box com um tick"]
    S_AF3_3 [flow: "alternative_3", description: "Deleta todas extracoes", actor: "administrador", action: "pressiona o botao “Delete extractions”"]
    S_AF3_4 [flow: "alternative_3", description: "Deleta todas extracoes", actor: "system", action: "exibe uma mensagem pop-up indicando que nao existem extracoes para serem deletadas"]
    S_END [terminal, guard: ""]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: marca selecao com um tick"]
    S_BF_1 -> S_AF2_1 [branch: "AF_2 - Realiza Filtro e delecao"]
    S_BF_1 -> S_AF3_1 [branch: "AF_3 - Deleta todas extracoes"]
    S_BF_2 -> S_BF_3 [event: "administrador: pressiona o botao “Delete extractions”"]
    S_BF_3 -> S_BF_4 [event: "system: exibe uma mensagem pop-up solicitando a confirmação da delecao"]
    S_BF_4 -> S_BF_5 [event: "administrador: confirma delecao"]
    S_BF_5 -> S_BF_6 [event: "system: exibe a lista de extracoes com 704 entradas"]
    S_BF_5 -> S_AF1_1 [branch: "AF_1 - Cancela delecao"]
    S_BF_6 -> S_END [event: "Complete"]
    S_AF1_1 -> S_AF1_2 [event: "system: fecha janela pop-up"]
    S_AF1_2 -> S_BF_1 [resume_basic_flow: 1]
    S_AF2_1 -> S_AF2_2 [event: "system: exibe opcoes “Activated”, “Alert Interruption”, “Deactivated”, “Mockup” e “Error”"]
    S_AF2_2 -> S_AF2_3 [event: "administrador: seleciona opcao “Activated” no campo de filtro “State”"]
    S_AF2_3 -> S_AF2_4 [event: "system: atualiza pagina mostrando 608 extracoes"]
    S_AF2_4 -> S_AF2_5 [event: "administrador: seleciona o check box que marca todas extracoes para delecao"]
    S_AF2_5 -> S_AF2_6 [event: "system: marca todas extracoes após o filtro com um tick"]
    S_AF2_6 -> S_AF2_7 [event: "administrador: pressiona o botao “Delete extractions”"]
    S_AF2_7 -> S_AF2_8 [event: "system: exibe uma mensagem pop-up solicitando a confirmacao da delecao"]
    S_AF2_8 -> S_AF2_9 [event: "administrador: confirma delecao"]
    S_AF2_9 -> S_AF2_10 [event: "system: exibe a lista de extracoes com 96 entradas"]
    S_AF2_10 -> S_END [event: "Complete"]
    S_AF3_1 -> S_AF3_2 [event: "system: marca o check box com um tick"]
    S_AF3_2 -> S_AF3_3 [event: "administrador: pressiona o botao “Delete extractions”"]
    S_AF3_3 -> S_AF3_4 [event: "system: exibe uma mensagem pop-up indicando que nao existem extracoes para serem deletadas"]
    S_AF3_4 -> S_END [event: "Complete"]
  }
}
