ALTS_SPECIFICATION "Delecao de Extracoes" {
  VERSION: "1.0"
  PRE_CONDITION: "Usuário deve estar logado no servidor e extrator como administrador ; 705 extrações já realizadas (pasta “EXTRACT_FILE_IPP320_AKIRA”)"
  POST_CONDITION: ""

  ACTORS {
    administrador: "Administrador do sistema"
  }

  STATES {
    S_INIT [initial, guard: "Usuário deve estar logado no servidor e extrator como administrador ; 705 extrações já realizadas (pasta “EXTRACT_FILE_IPP320_AKIRA”)"]
    S_BF_1 [flow: "basic", actor: "administrador", action: "seleciona o check box referente a extração referente ao número serial 12311PP30154516”", branches_af: [2, 3]]
    S_BF_2 [flow: "basic", actor: "system", action: "marca seleção com um tick"]
    S_BF_3 [flow: "basic", actor: "administrador", action: "pressiona o botão “Delete extractions”"]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe uma mensagem pop-up solicitando a confirmação da deleção"]
    S_BF_5 [flow: "basic", actor: "administrador", action: "confirma deleção", branches_af: [1]]
    S_BF_6 [flow: "basic", actor: "system", action: "exibe a lista de extrações com 704 entradas"]
    S_AF1_1 [flow: "alternative_1", description: "Cancela deleção", actor: "administrador", action: "cancela deleção"]
    S_AF1_2 [flow: "alternative_1", description: "Cancela deleção", actor: "system", action: "fecha janela pop-up", returns_to_bf: 1]
    S_AF2_1 [flow: "alternative_2", description: "Realiza Filtro e deleção", actor: "administrador", action: "seleciona combo box referente ao filtro por “State”"]
    S_AF2_2 [flow: "alternative_2", description: "Realiza Filtro e deleção", actor: "system", action: "exibe opções “Activated”, “Alert Interruption”, “Deactivated”, “Mockup” e “Error”"]
    S_AF2_3 [flow: "alternative_2", description: "Realiza Filtro e deleção", actor: "administrador", action: "seleciona opção “Activated” no campo de filtro “State”"]
    S_AF2_4 [flow: "alternative_2", description: "Realiza Filtro e deleção", actor: "system", action: "atualiza página mostrando 608 extrações"]
    S_AF2_5 [flow: "alternative_2", description: "Realiza Filtro e deleção", actor: "administrador", action: "seleciona o check box que marca todas extrações para deleção"]
    S_AF2_6 [flow: "alternative_2", description: "Realiza Filtro e deleção", actor: "system", action: "marca todas extrações após o filtro com um tick"]
    S_AF2_7 [flow: "alternative_2", description: "Realiza Filtro e deleção", actor: "administrador", action: "pressiona o botão “Delete extractions”"]
    S_AF2_8 [flow: "alternative_2", description: "Realiza Filtro e deleção", actor: "system", action: "exibe uma mensagem pop-up solicitando a confirmação da deleção"]
    S_AF2_9 [flow: "alternative_2", description: "Realiza Filtro e deleção", actor: "administrador", action: "confirma deleção"]
    S_AF2_10 [flow: "alternative_2", description: "Realiza Filtro e deleção", actor: "system", action: "exibe a lista de extrações com 96 entradas"]
    S_AF3_1 [flow: "alternative_3", description: "Deleta todas extrações", actor: "administrador", action: "seleciona o check box que marca todas extrações para deleção"]
    S_AF3_2 [flow: "alternative_3", description: "Deleta todas extrações", actor: "system", action: "marca o check box com um tick"]
    S_AF3_3 [flow: "alternative_3", description: "Deleta todas extrações", actor: "administrador", action: "pressiona o botão “Delete extractions”"]
    S_AF3_4 [flow: "alternative_3", description: "Deleta todas extrações", actor: "system", action: "exibe uma mensagem pop-up indicando que não existem extrações para serem deletadas"]
    S_END [terminal, guard: ""]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: marca seleção com um tick"]
    S_BF_1 -> S_AF2_1 [branch: "AF_2 - Realiza Filtro e deleção"]
    S_BF_1 -> S_AF3_1 [branch: "AF_3 - Deleta todas extrações"]
    S_BF_2 -> S_BF_3 [event: "administrador: pressiona o botão “Delete extractions”"]
    S_BF_3 -> S_BF_4 [event: "system: exibe uma mensagem pop-up solicitando a confirmação da deleção"]
    S_BF_4 -> S_BF_5 [event: "administrador: confirma deleção"]
    S_BF_5 -> S_BF_6 [event: "system: exibe a lista de extrações com 704 entradas"]
    S_BF_5 -> S_AF1_1 [branch: "AF_1 - Cancela deleção"]
    S_BF_6 -> S_END [event: "Complete"]
    S_AF1_1 -> S_AF1_2 [event: "system: fecha janela pop-up"]
    S_AF1_2 -> S_BF_1 [resume_basic_flow: 1]
    S_AF2_1 -> S_AF2_2 [event: "system: exibe opções “Activated”, “Alert Interruption”, “Deactivated”, “Mockup” e “Error”"]
    S_AF2_2 -> S_AF2_3 [event: "administrador: seleciona opção “Activated” no campo de filtro “State”"]
    S_AF2_3 -> S_AF2_4 [event: "system: atualiza página mostrando 608 extrações"]
    S_AF2_4 -> S_AF2_5 [event: "administrador: seleciona o check box que marca todas extrações para deleção"]
    S_AF2_5 -> S_AF2_6 [event: "system: marca todas extrações após o filtro com um tick"]
    S_AF2_6 -> S_AF2_7 [event: "administrador: pressiona o botão “Delete extractions”"]
    S_AF2_7 -> S_AF2_8 [event: "system: exibe uma mensagem pop-up solicitando a confirmação da deleção"]
    S_AF2_8 -> S_AF2_9 [event: "administrador: confirma deleção"]
    S_AF2_9 -> S_AF2_10 [event: "system: exibe a lista de extrações com 96 entradas"]
    S_AF2_10 -> S_END [event: "Complete"]
    S_AF3_1 -> S_AF3_2 [event: "system: marca o check box com um tick"]
    S_AF3_2 -> S_AF3_3 [event: "administrador: pressiona o botão “Delete extractions”"]
    S_AF3_3 -> S_AF3_4 [event: "system: exibe uma mensagem pop-up indicando que não existem extrações para serem deletadas"]
    S_AF3_4 -> S_END [event: "Complete"]
  }
}
