ALTS_SPECIFICATION "Administrador Edita Compatibilidade" {
  VERSION: "1.0"
  PRE_CONDITION: "Administrador logado; Existe Compatibilidade registrada no sistema."
  POST_CONDITION: "A nova Compatibilidade esta atualizada no banco."

  ACTORS {
    Administrador: "Usuario Administrador"
    system: "Bazooca"
  }

  STATES {
    S_INIT [initial, guard: "Administrador logado; Existe Compatibilidade registrada no sistema."]
    S_BF_1 [flow: "basic", actor: "Administrador", action: "Clicar na opcao 'Compatibildiade' no menu da tela principal"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe a tela de listagem das Compatibilidades"]
    S_BF_3 [flow: "basic", actor: "Administrador", action: "clica em uma Compatibilidade existente'", branches_af: [1, 2, 3]]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe a tela de edicao de Compatibilidade"]
    S_BF_5 [flow: "basic", actor: "Administrador", action: "preenche os dados da Compatibilidade e clica em botao 'Atualizar'", branches_af: [4]]
    S_BF_6 [flow: "basic", actor: "system", action: "notifica usuario que os nova Compatibilidade foi atualizado com sucesso", branches_ef: [1, 2, 3]]
    S_AF1_1 [flow: "alternative_1", description: "Usuario ordena lista de Compatibilidades", actor: "Administrador", action: "clica em um dos botões de ordenacao associada a uma coluna da tabela", returns_to_bf: 2]
    S_AF2_1 [flow: "alternative_2", description: "Usuario filtra lista de Compatibilidades", actor: "Administrador", action: "preenche campos de filtragem", returns_to_bf: 2]
    S_AF3_1 [flow: "alternative_3", description: "Usuario navega por paginas de tabela", actor: "Administrador", action: "clica em botao de navegacao de paginas de tabela", returns_to_bf: 2]
    S_AF4_1 [flow: "alternative_4", description: "Usuario cancela atualizacao de Compatibilidade", actor: "Administrador", action: "clica no botao Cancelar", returns_to_bf: 2]
    S_EF1_1 [flow: "exception_1", description: "Nao insere algum dado obrigatorio'", actor: "system", action: "informa que os dados obrigatorios devem ser preenchidos"]
    S_EF1_2 [flow: "exception_1", description: "Nao insere algum dado obrigatorio'", actor: "Administrador", action: "preenche dados obrigatorios e clica em Atualizar"]
    S_EF2_1 [flow: "exception_2", description: "Usuario insere Tipo de Mercadoria invalido", actor: "system", action: "alerta que Horario de Inicio é invalido"]
    S_EF2_2 [flow: "exception_2", description: "Usuario insere Tipo de Mercadoria invalido", actor: "Administrador", action: "preenche um Tipo de Mercadoria valida e clica em Atualizar"]
    S_EF3_1 [flow: "exception_3", description: "Usuario insere NCM invalido", actor: "system", action: "alerta que NCM é invalido"]
    S_EF3_2 [flow: "exception_3", description: "Usuario insere NCM invalido", actor: "Administrador", action: "preenche um NCM valido e clica em Atualizar"]
    S_END [terminal, guard: "A nova Compatibilidade esta atualizada no banco."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe a tela de listagem das Compatibilidades"]
    S_BF_2 -> S_BF_3 [event: "Administrador: clica em uma Compatibilidade existente'"]
    S_BF_3 -> S_BF_4 [event: "system: exibe a tela de edicao de Compatibilidade"]
    S_BF_3 -> S_AF1_1 [branch: "AF_1 - Usuario ordena lista de Compatibilidades"]
    S_BF_3 -> S_AF2_1 [branch: "AF_2 - Usuario filtra lista de Compatibilidades"]
    S_BF_3 -> S_AF3_1 [branch: "AF_3 - Usuario navega por paginas de tabela"]
    S_BF_4 -> S_BF_5 [event: "Administrador: preenche os dados da Compatibilidade e clica em botao 'Atualizar'"]
    S_BF_5 -> S_BF_6 [event: "system: notifica usuario que os nova Compatibilidade foi atualizado com sucesso"]
    S_BF_5 -> S_AF4_1 [branch: "AF_4 - Usuario cancela atualizacao de Compatibilidade"]
    S_BF_6 -> S_END [event: "Complete"]
    S_BF_6 -> S_EF1_1 [branch: "EF_1 - Nao insere algum dado obrigatorio'"]
    S_BF_6 -> S_EF2_1 [branch: "EF_2 - Usuario insere Tipo de Mercadoria invalido"]
    S_BF_6 -> S_EF3_1 [branch: "EF_3 - Usuario insere NCM invalido"]
    S_AF1_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF2_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF3_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF4_1 -> S_BF_2 [resume_basic_flow: 2]
    S_EF1_1 -> S_EF1_2 [event: "Administrador: preenche dados obrigatorios e clica em Atualizar"]
    S_EF1_2 -> S_END [event: "ErrorExit"]
    S_EF2_1 -> S_EF2_2 [event: "Administrador: preenche um Tipo de Mercadoria valida e clica em Atualizar"]
    S_EF2_2 -> S_END [event: "ErrorExit"]
    S_EF3_1 -> S_EF3_2 [event: "Administrador: preenche um NCM valido e clica em Atualizar"]
    S_EF3_2 -> S_END [event: "ErrorExit"]
  }
}
