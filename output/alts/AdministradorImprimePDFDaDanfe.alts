ALTS_SPECIFICATION "Administrador Imprime Pdf Da Danfe" {
  VERSION: "1.0"
  PRE_CONDITION: "Usuario Administrador esta logado no sistema."
  POST_CONDITION: "A Danfe esta impressa"

  ACTORS {
    Administrador: "Usuario Administrador"
    system: "Bazooca"
  }

  STATES {
    S_INIT [initial, guard: "Usuario Administrador esta logado no sistema."]
    S_BF_1 [flow: "basic", actor: "Administrador", action: "abre tela inicial do sistema"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe tela inicial do sistema"]
    S_BF_3 [flow: "basic", actor: "Administrador", action: "clica na opcao 'Central de Operacoes' no menu da tela principal"]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe dashboard do sistema"]
    S_BF_5 [flow: "basic", actor: "Administrador", action: "clica em algum contador de 'Engine' na secao de 'Notas'", branches_af: [1, 2, 3, 4, 5]]
    S_BF_6 [flow: "basic", actor: "system", action: "abre uma tela com as listas das 'Notas'"]
    S_BF_7 [flow: "basic", actor: "Administrador", action: "seleciona alguma Nota na lista", branches_af: [6, 7, 8]]
    S_BF_8 [flow: "basic", actor: "system", action: "exibe os dados da nota selecionada"]
    S_BF_9 [flow: "basic", actor: "Administrador", action: "clica no botao de 'Visualizar DANFE'"]
    S_BF_10 [flow: "basic", actor: "system", action: "abre uma nova aba com a versao da Danfe em PDF"]
    S_BF_11 [flow: "basic", actor: "Administrador", action: "clica no botao 'Imprimir'", branches_af: [9]]
    S_BF_12 [flow: "basic", actor: "system", action: "envia documento para impressora"]
    S_AF1_1 [flow: "alternative_1", description: "Seleciona contador de 'Conferencia'", actor: "Administrador", action: "clica em algum contador de 'Conferencia' na secao de 'Notas'", returns_to_bf: 6]
    S_AF2_1 [flow: "alternative_2", description: "Seleciona contador de 'Picking'", actor: "Administrador", action: "clica em algum contador de 'Picking' na secao de 'Notas'", returns_to_bf: 6]
    S_AF3_1 [flow: "alternative_3", description: "Seleciona contador de 'Atrasos'", actor: "Administrador", action: "clica em algum contador de 'Atrasos' na secao de 'Notas'", returns_to_bf: 6]
    S_AF4_1 [flow: "alternative_4", description: "Seleciona contador de 'Retornos'", actor: "Administrador", action: "clica em algum contador de 'Retornos' na secao de 'Notas'", returns_to_bf: 6]
    S_AF5_1 [flow: "alternative_5", description: "Seleciona contador de 'Ocorrencias'", actor: "Administrador", action: "clica em algum contador de 'Ocorrencias' na secao de 'Notas'", returns_to_bf: 6]
    S_AF6_1 [flow: "alternative_6", description: "Navega pelas paginas da lista", actor: "Administrador", action: "seleciona outra pagina", returns_to_bf: 6]
    S_AF7_1 [flow: "alternative_7", description: "Clica no botao voltar", actor: "Administrador", action: "clica no botao 'Voltar'", returns_to_bf: 4]
    S_AF8_1 [flow: "alternative_8", description: "Ordena Notas", actor: "Administrador", action: "ordenas as notas por alguma coluna", returns_to_bf: 6]
    S_AF9_1 [flow: "alternative_9", description: "Cancela impressao de Danfe", actor: "Administrador", action: "clica em botao 'Cancelar'", returns_to_bf: 8]
    S_END [terminal, guard: "A Danfe esta impressa"]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe tela inicial do sistema"]
    S_BF_2 -> S_BF_3 [event: "Administrador: clica na opcao 'Central de Operacoes' no menu da tela principal"]
    S_BF_3 -> S_BF_4 [event: "system: exibe dashboard do sistema"]
    S_BF_4 -> S_BF_5 [event: "Administrador: clica em algum contador de 'Engine' na secao de 'Notas'"]
    S_BF_5 -> S_BF_6 [event: "system: abre uma tela com as listas das 'Notas'"]
    S_BF_5 -> S_AF1_1 [branch: "AF_1 - Seleciona contador de 'Conferencia'"]
    S_BF_5 -> S_AF2_1 [branch: "AF_2 - Seleciona contador de 'Picking'"]
    S_BF_5 -> S_AF3_1 [branch: "AF_3 - Seleciona contador de 'Atrasos'"]
    S_BF_5 -> S_AF4_1 [branch: "AF_4 - Seleciona contador de 'Retornos'"]
    S_BF_5 -> S_AF5_1 [branch: "AF_5 - Seleciona contador de 'Ocorrencias'"]
    S_BF_6 -> S_BF_7 [event: "Administrador: seleciona alguma Nota na lista"]
    S_BF_7 -> S_BF_8 [event: "system: exibe os dados da nota selecionada"]
    S_BF_7 -> S_AF6_1 [branch: "AF_6 - Navega pelas paginas da lista"]
    S_BF_7 -> S_AF7_1 [branch: "AF_7 - Clica no botao voltar"]
    S_BF_7 -> S_AF8_1 [branch: "AF_8 - Ordena Notas"]
    S_BF_8 -> S_BF_9 [event: "Administrador: clica no botao de 'Visualizar DANFE'"]
    S_BF_9 -> S_BF_10 [event: "system: abre uma nova aba com a versao da Danfe em PDF"]
    S_BF_10 -> S_BF_11 [event: "Administrador: clica no botao 'Imprimir'"]
    S_BF_11 -> S_BF_12 [event: "system: envia documento para impressora"]
    S_BF_11 -> S_AF9_1 [branch: "AF_9 - Cancela impressao de Danfe"]
    S_BF_12 -> S_END [event: "Complete"]
    S_AF1_1 -> S_BF_6 [resume_basic_flow: 6]
    S_AF2_1 -> S_BF_6 [resume_basic_flow: 6]
    S_AF3_1 -> S_BF_6 [resume_basic_flow: 6]
    S_AF4_1 -> S_BF_6 [resume_basic_flow: 6]
    S_AF5_1 -> S_BF_6 [resume_basic_flow: 6]
    S_AF6_1 -> S_BF_6 [resume_basic_flow: 6]
    S_AF7_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF8_1 -> S_BF_6 [resume_basic_flow: 6]
    S_AF9_1 -> S_BF_8 [resume_basic_flow: 8]
  }
}
