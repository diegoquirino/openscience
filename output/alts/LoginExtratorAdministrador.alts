ALTS_SPECIFICATION "Login no extrator como Administrador" {
  VERSION: "1.0"
  PRE_CONDITION: "Deve existir um usuario cadastrado com perfil administrador"
  POST_CONDITION: "O usuario deve estar logado"

  ACTORS {
    administrador: "Super Administrador"
  }

  STATES {
    S_INIT [initial, guard: "Deve existir um usuario cadastrado com perfil administrador"]
    S_BF_1 [flow: "basic", actor: "administrador", action: "abre modulo de extracao"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe tela de login"]
    S_BF_3 [flow: "basic", actor: "administrador", action: "digita o user e a password de um usuário administrador e pressiona o botao Login", branches_af: [1, 2, 3]]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe tela de extracao por dispositivo", branches_ef: [1, 2, 3]]
    S_AF1_1 [flow: "alternative_1", description: "User invalido", actor: "administrador", action: "digita o user de um usuário inválido, digita uma password e pressiona o botao Login"]
    S_AF1_2 [flow: "alternative_1", description: "User invalido", actor: "system", action: "exibe mensagem “Invalid user or password” na tela de login", returns_to_bf: 2]
    S_AF2_1 [flow: "alternative_2", description: "Password invalida", actor: "administrador", action: "digita o user de um usuário administrador corretamente, digita uma password invalida e pressiona o botao Login"]
    S_AF2_2 [flow: "alternative_2", description: "Password invalida", actor: "system", action: "abre um pop-up e exibe a mensagem “User or Password incorrect. Attempts remaining until the account lockout: #tentativas restantes#” em um pop-up"]
    S_AF2_3 [flow: "alternative_2", description: "Password invalida", actor: "administrador", action: "pressiona o botao Ok"]
    S_AF2_4 [flow: "alternative_2", description: "Password invalida", actor: "system", action: "fecha a janela pop-up", returns_to_bf: 2]
    S_AF3_1 [flow: "alternative_3", description: "Numero de tentativas invalidas e 5", actor: "administrador", action: "digita o user de um usuario administrador corretamente, digita uma password invalida pela sexta vez e pressiona o botao Login"]
    S_AF3_2 [flow: "alternative_3", description: "Numero de tentativas invalidas e 5", actor: "system", action: "bloqueia o usuário e exibe a mensagem 'This user has been blocked'"]
    S_AF3_3 [flow: "alternative_3", description: "Numero de tentativas invalidas e 5", actor: "administrador", action: "tenta mais uma vez logar na conta do usuário, agora com dados validos"]
    S_AF3_4 [flow: "alternative_3", description: "Numero de tentativas invalidas e 5", actor: "system", action: "exibe mensagem informando usuario está bloqueado"]
    S_EF1_1 [flow: "exception_1", description: "Sem conexao com o servidor e usuario deseja fazer extracao offline", actor: "system", action: "exibe pop-up questionando se o usuqrio deseja fazer extracoes offline"]
    S_EF1_2 [flow: "exception_1", description: "Sem conexao com o servidor e usuario deseja fazer extracao offline", actor: "administrador", action: "pressiona o botao Yes"]
    S_EF1_3 [flow: "exception_1", description: "Sem conexao com o servidor e usuario deseja fazer extracao offline", actor: "system", action: "fecha a janela pop-up e exibe tela de extracao por dispositivo em modo offline"]
    S_EF2_1 [flow: "exception_2", description: "Sem conexao com o servidor e usuário nao deseja fazer extração offline", actor: "system", action: "exibe pop-up questionando se o usuário deveja fazer extracoes offline"]
    S_EF2_2 [flow: "exception_2", description: "Sem conexao com o servidor e usuário nao deseja fazer extração offline", actor: "administrador", action: "pressiona o botao No"]
    S_EF2_3 [flow: "exception_2", description: "Sem conexao com o servidor e usuário nao deseja fazer extração offline", actor: "system", action: "fecha a janela pop-up"]
    S_EF3_1 [flow: "exception_3", description: "Usuario inativo por 90 dias", actor: "system", action: "exibe a mensagem 'This user has been blocked'"]
    S_EF3_2 [flow: "exception_3", description: "Usuario inativo por 90 dias", actor: "administrador", action: "executa programa externo que reinicia senha de super admin"]
    S_END [terminal, guard: "O usuario deve estar logado"]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe tela de login"]
    S_BF_2 -> S_BF_3 [event: "administrador: digita o user e a password de um usuário administrador e pressiona o botao Login"]
    S_BF_3 -> S_BF_4 [event: "system: exibe tela de extracao por dispositivo"]
    S_BF_3 -> S_AF1_1 [branch: "AF_1 - User invalido"]
    S_BF_3 -> S_AF2_1 [branch: "AF_2 - Password invalida"]
    S_BF_3 -> S_AF3_1 [branch: "AF_3 - Numero de tentativas invalidas e 5"]
    S_BF_4 -> S_END [event: "Complete"]
    S_BF_4 -> S_EF1_1 [branch: "EF_1 - Sem conexao com o servidor e usuario deseja fazer extracao offline"]
    S_BF_4 -> S_EF2_1 [branch: "EF_2 - Sem conexao com o servidor e usuário nao deseja fazer extração offline"]
    S_BF_4 -> S_EF3_1 [branch: "EF_3 - Usuario inativo por 90 dias"]
    S_AF1_1 -> S_AF1_2 [event: "system: exibe mensagem “Invalid user or password” na tela de login"]
    S_AF1_2 -> S_BF_2 [resume_basic_flow: 2]
    S_AF2_1 -> S_AF2_2 [event: "system: abre um pop-up e exibe a mensagem “User or Password incorrect. Attempts remaining until the account lockout: #tentativas restantes#” em um pop-up"]
    S_AF2_2 -> S_AF2_3 [event: "administrador: pressiona o botao Ok"]
    S_AF2_3 -> S_AF2_4 [event: "system: fecha a janela pop-up"]
    S_AF2_4 -> S_BF_2 [resume_basic_flow: 2]
    S_AF3_1 -> S_AF3_2 [event: "system: bloqueia o usuário e exibe a mensagem 'This user has been blocked'"]
    S_AF3_2 -> S_AF3_3 [event: "administrador: tenta mais uma vez logar na conta do usuário, agora com dados validos"]
    S_AF3_3 -> S_AF3_4 [event: "system: exibe mensagem informando usuario está bloqueado"]
    S_AF3_4 -> S_END [event: "Complete"]
    S_EF1_1 -> S_EF1_2 [event: "administrador: pressiona o botao Yes"]
    S_EF1_2 -> S_EF1_3 [event: "system: fecha a janela pop-up e exibe tela de extracao por dispositivo em modo offline"]
    S_EF1_3 -> S_END [event: "ErrorExit"]
    S_EF2_1 -> S_EF2_2 [event: "administrador: pressiona o botao No"]
    S_EF2_2 -> S_EF2_3 [event: "system: fecha a janela pop-up"]
    S_EF2_3 -> S_END [event: "ErrorExit"]
    S_EF3_1 -> S_EF3_2 [event: "administrador: executa programa externo que reinicia senha de super admin"]
    S_EF3_2 -> S_END [event: "ErrorExit"]
  }
}
