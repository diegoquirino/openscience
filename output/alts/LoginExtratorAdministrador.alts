ALTS_SPECIFICATION "Login no extrator como Administrador" {
  VERSION: "1.0"
  PRE_CONDITION: "Deve existir um usuário cadastrado com perfil administrador ; Usuário deve estar logado no servidor como administrador"
  POST_CONDITION: ""

  ACTORS {
    administrador: "Administrador do sistema"
  }

  STATES {
    S_INIT [initial, guard: "Deve existir um usuário cadastrado com perfil administrador ; Usuário deve estar logado no servidor como administrador"]
    S_BF_1 [flow: "basic", actor: "administrador", action: "abre módulo de extração"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe página inicial do módulo de extração"]
    S_BF_3 [flow: "basic", actor: "administrador", action: "digita um login de usuário administrador e password e pressiona Login", branches_af: [1, 2, 3]]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe tela “SAFF Extractor”", branches_ef: [1, 2]]
    S_AF1_1 [flow: "alternative_1", description: "Login ou Password inválidos", actor: "administrador", action: "digita um login de usuário administrador e/ou password invalidos e pressiona Login"]
    S_AF1_2 [flow: "alternative_1", description: "Login ou Password inválidos", actor: "system", action: "exibe mensagem “Invalid username or password” na tela de login", returns_to_bf: 3]
    S_AF2_1 [flow: "alternative_2", description: "Número de tentativas inválidas é 3", actor: "administrador", action: "digita um login de usuário administrador e/ou password invalidos pela terceira vez e pressiona Login"]
    S_AF2_2 [flow: "alternative_2", description: "Número de tentativas inválidas é 3", actor: "system", action: "exibe mensagem de alerta", returns_to_bf: 3]
    S_AF3_1 [flow: "alternative_3", description: "Número de tentativas inválidas é 5", actor: "administrador", action: "digita um login de usuário administrador e/ou password invalidos pela quinta vez e pressiona Login"]
    S_AF3_2 [flow: "alternative_3", description: "Número de tentativas inválidas é 5", actor: "system", action: "bloqueia usuário"]
    S_AF3_3 [flow: "alternative_3", description: "Número de tentativas inválidas é 5", actor: "administrador", action: "tenta mais uma vez logar na conta do usuário, agora com dados válidos"]
    S_AF3_4 [flow: "alternative_3", description: "Número de tentativas inválidas é 5", actor: "system", action: "exibe mensagem que usuário está bloqueado"]
    S_EF1_1 [flow: "exception_1", description: "Sem conexão com o servidor e usuário deseja fazer extração offline", actor: "system", action: "exibe pop-up questionanado se o usuário deveja fazer uma extração offline"]
    S_EF1_2 [flow: "exception_1", description: "Sem conexão com o servidor e usuário deseja fazer extração offline", actor: "administrador", action: "pressiona Yes"]
    S_EF1_3 [flow: "exception_1", description: "Sem conexão com o servidor e usuário deseja fazer extração offline", actor: "system", action: "fecha a janela pop-up"]
    S_EF1_4 [flow: "exception_1", description: "Sem conexão com o servidor e usuário deseja fazer extração offline", actor: "system", action: "exibe tela “SAFF Extractor” em modo offline"]
    S_EF2_1 [flow: "exception_2", description: "Sem conexão com o servidor e usuário não deseja fazer extração offline", actor: "system", action: "exibe pop-up questionanado se o usuário deveja fazer uma extração offline"]
    S_EF2_2 [flow: "exception_2", description: "Sem conexão com o servidor e usuário não deseja fazer extração offline", actor: "administrador", action: "pressiona No"]
    S_EF2_3 [flow: "exception_2", description: "Sem conexão com o servidor e usuário não deseja fazer extração offline", actor: "system", action: "fecha a janela pop-up"]
    S_END [terminal, guard: ""]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe página inicial do módulo de extração"]
    S_BF_2 -> S_BF_3 [event: "administrador: digita um login de usuário administrador e password e pressiona Login"]
    S_BF_3 -> S_BF_4 [event: "system: exibe tela “SAFF Extractor”"]
    S_BF_3 -> S_AF1_1 [branch: "AF_1 - Login ou Password inválidos"]
    S_BF_3 -> S_AF2_1 [branch: "AF_2 - Número de tentativas inválidas é 3"]
    S_BF_3 -> S_AF3_1 [branch: "AF_3 - Número de tentativas inválidas é 5"]
    S_BF_4 -> S_END [event: "Complete"]
    S_BF_4 -> S_EF1_1 [branch: "EF_1 - Sem conexão com o servidor e usuário deseja fazer extração offline"]
    S_BF_4 -> S_EF2_1 [branch: "EF_2 - Sem conexão com o servidor e usuário não deseja fazer extração offline"]
    S_AF1_1 -> S_AF1_2 [event: "system: exibe mensagem “Invalid username or password” na tela de login"]
    S_AF1_2 -> S_BF_3 [resume_basic_flow: 3]
    S_AF2_1 -> S_AF2_2 [event: "system: exibe mensagem de alerta"]
    S_AF2_2 -> S_BF_3 [resume_basic_flow: 3]
    S_AF3_1 -> S_AF3_2 [event: "system: bloqueia usuário"]
    S_AF3_2 -> S_AF3_3 [event: "administrador: tenta mais uma vez logar na conta do usuário, agora com dados válidos"]
    S_AF3_3 -> S_AF3_4 [event: "system: exibe mensagem que usuário está bloqueado"]
    S_AF3_4 -> S_END [event: "Complete"]
    S_EF1_1 -> S_EF1_2 [event: "administrador: pressiona Yes"]
    S_EF1_2 -> S_EF1_3 [event: "system: fecha a janela pop-up"]
    S_EF1_3 -> S_EF1_4 [event: "system: exibe tela “SAFF Extractor” em modo offline"]
    S_EF1_4 -> S_END [event: "ErrorExit"]
    S_EF2_1 -> S_EF2_2 [event: "administrador: pressiona No"]
    S_EF2_2 -> S_EF2_3 [event: "system: fecha a janela pop-up"]
    S_EF2_3 -> S_END [event: "ErrorExit"]
  }
}
