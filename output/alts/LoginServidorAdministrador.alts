ALTS_SPECIFICATION "Login no servidor como Administrador" {
  VERSION: "1.0"
  PRE_CONDITION: "Deve existir um usuario cadastrado com perfil administrador"
  POST_CONDITION: ""

  ACTORS {
    administrador: "Administrador do sistema"
  }

  STATES {
    S_INIT [initial, guard: "Deve existir um usuario cadastrado com perfil administrador"]
    S_BF_1 [flow: "basic", actor: "administrador", action: "acessa o sistema"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe pagina de login"]
    S_BF_3 [flow: "basic", actor: "administrador", action: "digita o user e a password de um usuario administrador e pressiona o botao Login", branches_af: [1, 2, 3]]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe pagina 'Search extraction'", branches_ef: [1, 2]]
    S_BF_1 [flow: "basic", actor: "administrador", action: "abre outro navegador na pagina de login e insere user e password do usuario ja logado"]
    S_BF_2 [flow: "basic", actor: "system", action: "desloga o usuario na pagina anterior e continua sua sessao na nova pagina"]
    S_AF1_1 [flow: "alternative_1", description: "User invalido", actor: "administrador", action: "digita o user de um usuário invalido, digita uma password e pressiona o botao Login"]
    S_AF1_2 [flow: "alternative_1", description: "User invalido", actor: "system", action: "exibe na pagina de login uma mensagem de usuario ou senha incorretos", returns_to_bf: 3]
    S_AF2_1 [flow: "alternative_2", description: "Password invalida", actor: "administrador", action: "digita o user de um usuario administrador corretamente, digita uma password inválida e pressiona o botão Login"]
    S_AF2_2 [flow: "alternative_2", description: "Password invalida", actor: "system", action: "exibe mensagem de usuario ou senha incorretos na pagina de login; informa o numero de tentativas restantes ate que o usuario seja bloqueado", returns_to_bf: 3]
    S_AF3_1 [flow: "alternative_3", description: "Numero de tentativas invalidas e 5", actor: "administrador", action: "digita o user correte e o password invalido pela sexta vez e pressiona o botao Login"]
    S_AF3_2 [flow: "alternative_3", description: "Numero de tentativas invalidas e 5", actor: "system", action: "bloqueia o usuario e exibe uma mensagem informando que o usuario foi bloqueado"]
    S_AF3_3 [flow: "alternative_3", description: "Numero de tentativas invalidas e 5", actor: "administrador", action: "tenta mais uma vez logar na conta do usuário, agora com dados validos"]
    S_AF3_4 [flow: "alternative_3", description: "Numero de tentativas invalidas e 5", actor: "system", action: "exibe mensagem informando usuario esta bloqueado"]
    S_EF1_1 [flow: "exception_1", description: "Usuario inativo por 30 minutos", actor: "system", action: "finaliza sessão do usuario e retorna a pagina de login ao receber alguma requisicao do usuario"]
    S_EF2_1 [flow: "exception_2", description: "Usuario inativo por 90 dias", actor: "system", action: "exibe mensagem indicando que usuario foi bloqueado"]
    S_END [terminal, guard: ""]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe pagina de login"]
    S_BF_2 -> S_BF_3 [event: "administrador: digita o user e a password de um usuario administrador e pressiona o botao Login"]
    S_BF_3 -> S_BF_4 [event: "system: exibe pagina 'Search extraction'"]
    S_BF_3 -> S_AF1_1 [branch: "AF_1 - User invalido"]
    S_BF_3 -> S_AF2_1 [branch: "AF_2 - Password invalida"]
    S_BF_3 -> S_AF3_1 [branch: "AF_3 - Numero de tentativas invalidas e 5"]
    S_BF_4 -> S_BF_1 [event: "administrador: abre outro navegador na pagina de login e insere user e password do usuario ja logado"]
    S_BF_4 -> S_EF1_1 [branch: "EF_1 - Usuario inativo por 30 minutos"]
    S_BF_4 -> S_EF2_1 [branch: "EF_2 - Usuario inativo por 90 dias"]
    S_BF_1 -> S_BF_2 [event: "system: desloga o usuario na pagina anterior e continua sua sessao na nova pagina"]
    S_BF_2 -> S_END [event: "Complete"]
    S_AF1_1 -> S_AF1_2 [event: "system: exibe na pagina de login uma mensagem de usuario ou senha incorretos"]
    S_AF1_2 -> S_BF_3 [resume_basic_flow: 3]
    S_AF2_1 -> S_AF2_2 [event: "system: exibe mensagem de usuario ou senha incorretos na pagina de login; informa o numero de tentativas restantes ate que o usuario seja bloqueado"]
    S_AF2_2 -> S_BF_3 [resume_basic_flow: 3]
    S_AF3_1 -> S_AF3_2 [event: "system: bloqueia o usuario e exibe uma mensagem informando que o usuario foi bloqueado"]
    S_AF3_2 -> S_AF3_3 [event: "administrador: tenta mais uma vez logar na conta do usuário, agora com dados validos"]
    S_AF3_3 -> S_AF3_4 [event: "system: exibe mensagem informando usuario esta bloqueado"]
    S_AF3_4 -> S_END [event: "Complete"]
    S_EF1_1 -> S_END [event: "ErrorExit"]
    S_EF2_1 -> S_END [event: "ErrorExit"]
  }
}
