ALTS_SPECIFICATION "UC6 Appointments" {
  VERSION: "1.0"
  PRE_CONDITION: "The iTrust2 user has authenticated themselves in iTrust2 UC2."
  POST_CONDITION: "System processes request successfully and logs transaction."

  ACTORS {
    hcp: "Health Care Provider (HCP)"
    patient: "Patient"
  }

  STATES {
    S_INIT [initial, guard: "The iTrust2 user has authenticated themselves in iTrust2 UC2."]
    S_BF_1 [flow: "basic", actor: "patient", action: "The patient enters information about the appointment request and presses the Submit Request button . HCP Date Time Comments Type", branches_af: [1, 2, 3]]
    S_BF_2 [flow: "basic", actor: "system", action: "A message confirms the request.", branches_ef: [1]]
    S_AF1_1 [flow: "alternative_1", description: "Views their appointment request", actor: "patient", action: "The patient views their appointment request. The patient can select a request and delete the request.", returns_to_bf: 2]
    S_AF2_1 [flow: "alternative_2", description: "Views appointment requests", actor: "hcp", action: "The HCP views appointment requests. The HCP can select to approve or decline the requestion. The appointment will no longer be visible in the patient's appointment request view.", returns_to_bf: 2]
    S_AF3_1 [flow: "alternative_3", description: "View upcoming appointments", actor: "hcp", action: "The HCP view upcoming appointments.", returns_to_bf: 2]
    S_EF1_1 [flow: "exception_1", description: "Invalid data field format", actor: "system", action: "prompts the patient or HCP to correct the format of a required data field because the input of that data field does not match that specified in Section 6.6."]
    S_END [terminal, guard: "System processes request successfully and logs transaction."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: A message confirms the request."]
    S_BF_1 -> S_AF1_1 [branch: "AF_1 - Views their appointment request"]
    S_BF_1 -> S_AF2_1 [branch: "AF_2 - Views appointment requests"]
    S_BF_1 -> S_AF3_1 [branch: "AF_3 - View upcoming appointments"]
    S_BF_2 -> S_END [event: "Complete"]
    S_BF_2 -> S_EF1_1 [branch: "EF_1 - Invalid data field format"]
    S_AF1_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF2_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF3_1 -> S_BF_2 [resume_basic_flow: 2]
    S_EF1_1 -> S_END [event: "ErrorExit"]
  }
}
