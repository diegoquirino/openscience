ALTS_SPECIFICATION "Filtro de Extracoes" {
  VERSION: "1.0"
  PRE_CONDITION: "Operador deve estar logado no servidor ; ja existem diversas extracoes registradas"
  POST_CONDITION: ""

  ACTORS {
    operador: "Operador do sistema"
    superAdminViewer: "Super administrador do sistema ou Super-viewer"
    adminManager: "Administrador do sistema ou Manager"
  }

  STATES {
    S_INIT [initial, guard: "Operador deve estar logado no servidor ; ja existem diversas extracoes registradas"]
    S_BF_1 [flow: "basic", actor: "operador", action: "acessa tela de exibicao de extracoes"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe tela com lista de extracoes realizadas"]
    S_BF_3 [flow: "basic", actor: "operador", action: "seleciona datas personalizadas (inicial e final) para filtro", branches_af: [1, 2, 3, 4, 5, 6, 7, 8]]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe as data selecionadas"]
    S_BF_5 [flow: "basic", actor: "operador", action: "preenche os campos de filtro (somente Product Number e Serial Number) e manda aplicar filtro", branches_af: [10, 11, 12]]
    S_BF_6 [flow: "basic", actor: "system", action: "atualiza os campos de filtro, mostrando em destaque o valor escolhido; atualiza a lista de extracoes mostrando apenas aquelas condizentes com o filtro solicitado"]
    S_BF_7 [flow: "basic", actor: "operador", action: "seleciona uma extracao", branches_af: [9]]
    S_BF_8 [flow: "basic", actor: "system", action: "exibe extracao selecionada"]
    S_BF_9 [flow: "basic", actor: "operador", action: "retorna para tela de exibicao de extracoes"]
    S_BF_10 [flow: "basic", actor: "system", action: "exibe lista de extracoes preservando o filtro aplicado anteriormente"]
    S_AF1_1 [flow: "alternative_1", description: "Datas default", actor: "operador", action: "nao seleciona datas para filtro"]
    S_AF1_2 [flow: "alternative_1", description: "Datas default", actor: "system", action: "exibe a selecao da a data de hoje para as datas inicio e fim", returns_to_bf: 5]
    S_AF2_1 [flow: "alternative_2", description: "Ontem", actor: "operador", action: "seleciona opcao 'Ontem' como data de selecao do filtro"]
    S_AF2_2 [flow: "alternative_2", description: "Ontem", actor: "system", action: "exibe a selecao da opcao ontem como data de selecao de filtro", returns_to_bf: 5]
    S_AF3_1 [flow: "alternative_3", description: "Ultimos 7 dias", actor: "operador", action: "seleciona opcao 'Ultimos 7 dias' como data de selecao do filtro"]
    S_AF3_2 [flow: "alternative_3", description: "Ultimos 7 dias", actor: "system", action: "exibe a selecao da opcao Ultimos 7 dias como data de selecao de filtro", returns_to_bf: 5]
    S_AF4_1 [flow: "alternative_4", description: "Ultimos 30 dias", actor: "operador", action: "seleciona opcao 'Ultimos 30 dias' como data de selecao do filtro"]
    S_AF4_2 [flow: "alternative_4", description: "Ultimos 30 dias", actor: "system", action: "exibe a selecao da opcao Ultimos 30 dias como data de selecao de filtro", returns_to_bf: 5]
    S_AF5_1 [flow: "alternative_5", description: "Esse mes", actor: "operador", action: "seleciona opcao 'Esse mes' como data de selecao do filtro"]
    S_AF5_2 [flow: "alternative_5", description: "Esse mes", actor: "system", action: "exibe a selecao da opcao Esse mes como data de selecao de filtro", returns_to_bf: 5]
    S_AF6_1 [flow: "alternative_6", description: "Mes passado", actor: "operador", action: "seleciona opcao 'Mes passado' como data de selecao do filtro"]
    S_AF6_2 [flow: "alternative_6", description: "Mes passado", actor: "system", action: "exibe a selecao da opcao Mes passado como data de selecao de filtro", returns_to_bf: 5]
    S_AF7_1 [flow: "alternative_7", description: "Somente data inicio", actor: "operador", action: "seleciona somente a data inicio"]
    S_AF7_2 [flow: "alternative_7", description: "Somente data inicio", actor: "system", action: "mantem datas que estavam selecionadas anteriormente. Se nao existia data selecionada, a aparece a data default", returns_to_bf: 5]
    S_AF8_1 [flow: "alternative_8", description: "Somente data final", actor: "operador", action: "seleciona somente a data final"]
    S_AF8_2 [flow: "alternative_8", description: "Somente data final", actor: "system", action: "mantem datas que estavam selecionadas anteriormente. Se nao existia data selecionada, a aparece a data default", returns_to_bf: 5]
    S_AF9_1 [flow: "alternative_9", description: "Filtro apos log off", actor: "operador", action: "faz log off"]
    S_AF9_2 [flow: "alternative_9", description: "Filtro apos log off", actor: "system", action: "exibe tela inicial de login"]
    S_AF9_3 [flow: "alternative_9", description: "Filtro apos log off", actor: "operador", action: "faz log in"]
    S_AF9_4 [flow: "alternative_9", description: "Filtro apos log off", actor: "system", action: "exibe lista de extracoes preservando o filtro aplicado anteriormente"]
    S_AF10_1 [flow: "alternative_10", description: "Opcoes de filtro para Super administrador e Super-viewer", actor: "superAdminViewer", action: "preenche os campos de filtro (todas opcoes de filtro aparecem, incluindo filtro de laboratorio) e manda aplicar filtro", returns_to_bf: 6]
    S_AF11_1 [flow: "alternative_11", description: "Opcoes de filtro para Administrador e Manager", actor: "adminManager", action: "preenche os campos de filtro (filtro de laboratorio nao aparece) e manda aplicar filtro", returns_to_bf: 6]
    S_AF12_1 [flow: "alternative_12", description: "Sem filtros", actor: "operador", action: "nao preenche os campos de filtro e manda aplicar filtro"]
    S_AF12_2 [flow: "alternative_12", description: "Sem filtros", actor: "system", action: "mostra lista completa de de extracoes", returns_to_bf: 7]
    S_END [terminal, guard: ""]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe tela com lista de extracoes realizadas"]
    S_BF_2 -> S_BF_3 [event: "operador: seleciona datas personalizadas (inicial e final) para filtro"]
    S_BF_3 -> S_BF_4 [event: "system: exibe as data selecionadas"]
    S_BF_3 -> S_AF1_1 [branch: "AF_1 - Datas default"]
    S_BF_3 -> S_AF2_1 [branch: "AF_2 - Ontem"]
    S_BF_3 -> S_AF3_1 [branch: "AF_3 - Ultimos 7 dias"]
    S_BF_3 -> S_AF4_1 [branch: "AF_4 - Ultimos 30 dias"]
    S_BF_3 -> S_AF5_1 [branch: "AF_5 - Esse mes"]
    S_BF_3 -> S_AF6_1 [branch: "AF_6 - Mes passado"]
    S_BF_3 -> S_AF7_1 [branch: "AF_7 - Somente data inicio"]
    S_BF_3 -> S_AF8_1 [branch: "AF_8 - Somente data final"]
    S_BF_4 -> S_BF_5 [event: "operador: preenche os campos de filtro (somente Product Number e Serial Number) e manda aplicar filtro"]
    S_BF_5 -> S_BF_6 [event: "system: atualiza os campos de filtro, mostrando em destaque o valor escolhido; atualiza a lista de extracoes mostrando apenas aquelas condizentes com o filtro solicitado"]
    S_BF_5 -> S_AF10_1 [branch: "AF_10 - Opcoes de filtro para Super administrador e Super-viewer"]
    S_BF_5 -> S_AF11_1 [branch: "AF_11 - Opcoes de filtro para Administrador e Manager"]
    S_BF_5 -> S_AF12_1 [branch: "AF_12 - Sem filtros"]
    S_BF_6 -> S_BF_7 [event: "operador: seleciona uma extracao"]
    S_BF_7 -> S_BF_8 [event: "system: exibe extracao selecionada"]
    S_BF_7 -> S_AF9_1 [branch: "AF_9 - Filtro apos log off"]
    S_BF_8 -> S_BF_9 [event: "operador: retorna para tela de exibicao de extracoes"]
    S_BF_9 -> S_BF_10 [event: "system: exibe lista de extracoes preservando o filtro aplicado anteriormente"]
    S_BF_10 -> S_END [event: "Complete"]
    S_AF1_1 -> S_AF1_2 [event: "system: exibe a selecao da a data de hoje para as datas inicio e fim"]
    S_AF1_2 -> S_BF_5 [resume_basic_flow: 5]
    S_AF2_1 -> S_AF2_2 [event: "system: exibe a selecao da opcao ontem como data de selecao de filtro"]
    S_AF2_2 -> S_BF_5 [resume_basic_flow: 5]
    S_AF3_1 -> S_AF3_2 [event: "system: exibe a selecao da opcao Ultimos 7 dias como data de selecao de filtro"]
    S_AF3_2 -> S_BF_5 [resume_basic_flow: 5]
    S_AF4_1 -> S_AF4_2 [event: "system: exibe a selecao da opcao Ultimos 30 dias como data de selecao de filtro"]
    S_AF4_2 -> S_BF_5 [resume_basic_flow: 5]
    S_AF5_1 -> S_AF5_2 [event: "system: exibe a selecao da opcao Esse mes como data de selecao de filtro"]
    S_AF5_2 -> S_BF_5 [resume_basic_flow: 5]
    S_AF6_1 -> S_AF6_2 [event: "system: exibe a selecao da opcao Mes passado como data de selecao de filtro"]
    S_AF6_2 -> S_BF_5 [resume_basic_flow: 5]
    S_AF7_1 -> S_AF7_2 [event: "system: mantem datas que estavam selecionadas anteriormente. Se nao existia data selecionada, a aparece a data default"]
    S_AF7_2 -> S_BF_5 [resume_basic_flow: 5]
    S_AF8_1 -> S_AF8_2 [event: "system: mantem datas que estavam selecionadas anteriormente. Se nao existia data selecionada, a aparece a data default"]
    S_AF8_2 -> S_BF_5 [resume_basic_flow: 5]
    S_AF9_1 -> S_AF9_2 [event: "system: exibe tela inicial de login"]
    S_AF9_2 -> S_AF9_3 [event: "operador: faz log in"]
    S_AF9_3 -> S_AF9_4 [event: "system: exibe lista de extracoes preservando o filtro aplicado anteriormente"]
    S_AF9_4 -> S_END [event: "Complete"]
    S_AF10_1 -> S_BF_6 [resume_basic_flow: 6]
    S_AF11_1 -> S_BF_6 [resume_basic_flow: 6]
    S_AF12_1 -> S_AF12_2 [event: "system: mostra lista completa de de extracoes"]
    S_AF12_2 -> S_BF_7 [resume_basic_flow: 7]
  }
}
