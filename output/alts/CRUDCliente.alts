ALTS_SPECIFICATION "CRUD Cliente" {
  VERSION: "1.0"
  PRE_CONDITION: "Estar logado como super administrador"
  POST_CONDITION: ""

  ACTORS {
    superAdmin: "Super administrador"
  }

  STATES {
    S_INIT [initial, guard: "Estar logado como super administrador"]
    S_BF_1 [flow: "basic", actor: "superAdmin", action: "seleciona opcao 'Customers' no menu Settings"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe lista de clientes"]
    S_BF_3 [flow: "basic", actor: "superAdmin", action: "seleciona o botão 'Create Customer'"]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe pagina com campos de cadastro de novo cliente"]
    S_BF_5 [flow: "basic", actor: "superAdmin", action: "preenche corretamente os campos 'Name', 'Key File' e 'Country' e pressiona o botao 'Create'", branches_af: [1, 2]]
    S_BF_6 [flow: "basic", actor: "system", action: "exibe pagina com dados do novo cliente e mensagem que um novo cliente foi adicionado"]
    S_BF_7 [flow: "basic", actor: "superAdmin", action: "seleciona opcao 'Customers' no menu Settings"]
    S_BF_8 [flow: "basic", actor: "system", action: "exibe lista de clientes"]
    S_BF_9 [flow: "basic", actor: "superAdmin", action: "clica no nome de um cliente"]
    S_BF_10 [flow: "basic", actor: "system", action: "exibe dados do cliente"]
    S_BF_11 [flow: "basic", actor: "superAdmin", action: "clica no botao 'Cancel'", branches_af: [3, 4]]
    S_BF_12 [flow: "basic", actor: "system", action: "retorna a lista de clientes"]
    S_AF1_1 [flow: "alternative_1", description: "Campo fora da formatacao esperada, e.g., 'ddd' para 'Key File'", actor: "superAdmin", action: "preenche incorretamente os campos 'Name', 'Key File' e/ou 'Country' e pressiona o botão 'Create'"]
    S_AF1_2 [flow: "alternative_1", description: "Campo fora da formatacao esperada, e.g., 'ddd' para 'Key File'", actor: "system", action: "exibe mensagem informando que os dados nao correspondem a formatação esperada", returns_to_bf: 5]
    S_AF2_1 [flow: "alternative_2", description: "Cancela criacao", actor: "superAdmin", action: "Cancela criacao", returns_to_bf: 2]
    S_AF3_1 [flow: "alternative_3", description: "Edita dados", actor: "superAdmin", action: "clica no botao 'Edit'"]
    S_AF3_2 [flow: "alternative_3", description: "Edita dados", actor: "system", action: "exibe campos do cliente com valores atuais que podem ser editados"]
    S_AF3_3 [flow: "alternative_3", description: "Edita dados", actor: "superAdmin", action: "preenche os novos valores e pressiona o botao 'Update", returns_to_bf: 2]
    S_AF4_1 [flow: "alternative_4", description: "Deleta cliente", actor: "superAdmin", action: "clica no botao 'Delete'"]
    S_AF4_2 [flow: "alternative_4", description: "Deleta cliente", actor: "system", action: "exibe mensagem solicitando confirmacao"]
    S_AF4_3 [flow: "alternative_4", description: "Deleta cliente", actor: "superAdmin", action: "pressiona o botao OK", returns_to_bf: 2]
    S_END [terminal, guard: ""]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe lista de clientes"]
    S_BF_2 -> S_BF_3 [event: "superAdmin: seleciona o botão 'Create Customer'"]
    S_BF_3 -> S_BF_4 [event: "system: exibe pagina com campos de cadastro de novo cliente"]
    S_BF_4 -> S_BF_5 [event: "superAdmin: preenche corretamente os campos 'Name', 'Key File' e 'Country' e pressiona o botao 'Create'"]
    S_BF_5 -> S_BF_6 [event: "system: exibe pagina com dados do novo cliente e mensagem que um novo cliente foi adicionado"]
    S_BF_5 -> S_AF1_1 [branch: "AF_1 - Campo fora da formatacao esperada, e.g., 'ddd' para 'Key File'"]
    S_BF_5 -> S_AF2_1 [branch: "AF_2 - Cancela criacao"]
    S_BF_6 -> S_BF_7 [event: "superAdmin: seleciona opcao 'Customers' no menu Settings"]
    S_BF_7 -> S_BF_8 [event: "system: exibe lista de clientes"]
    S_BF_8 -> S_BF_9 [event: "superAdmin: clica no nome de um cliente"]
    S_BF_9 -> S_BF_10 [event: "system: exibe dados do cliente"]
    S_BF_10 -> S_BF_11 [event: "superAdmin: clica no botao 'Cancel'"]
    S_BF_11 -> S_BF_12 [event: "system: retorna a lista de clientes"]
    S_BF_11 -> S_AF3_1 [branch: "AF_3 - Edita dados"]
    S_BF_11 -> S_AF4_1 [branch: "AF_4 - Deleta cliente"]
    S_BF_12 -> S_END [event: "Complete"]
    S_AF1_1 -> S_AF1_2 [event: "system: exibe mensagem informando que os dados nao correspondem a formatação esperada"]
    S_AF1_2 -> S_BF_5 [resume_basic_flow: 5]
    S_AF2_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF3_1 -> S_AF3_2 [event: "system: exibe campos do cliente com valores atuais que podem ser editados"]
    S_AF3_2 -> S_AF3_3 [event: "superAdmin: preenche os novos valores e pressiona o botao 'Update"]
    S_AF3_3 -> S_BF_2 [resume_basic_flow: 2]
    S_AF4_1 -> S_AF4_2 [event: "system: exibe mensagem solicitando confirmacao"]
    S_AF4_2 -> S_AF4_3 [event: "superAdmin: pressiona o botao OK"]
    S_AF4_3 -> S_BF_2 [resume_basic_flow: 2]
  }
}
