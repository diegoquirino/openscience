ALTS_SPECIFICATION "Operador De Terminal Edita Terminal" {
  VERSION: "1.0"
  PRE_CONDITION: "O Operador logado; Operador pertence ao Terminal alvo."
  POST_CONDITION: "Terminal com dados atualizados no sistema."

  ACTORS {
    Operador: "Operador do Terminal"
    system: "Bazooca"
  }

  STATES {
    S_INIT [initial, guard: "O Operador logado; Operador pertence ao Terminal alvo."]
    S_BF_1 [flow: "basic", actor: "Operador", action: "abre tela inicial do sistema"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe tela inicial do sistema"]
    S_BF_3 [flow: "basic", actor: "Operador", action: "seleciona a opcao 'Meu Terminal' no menu da tela principal"]
    S_BF_4 [flow: "basic", actor: "system", action: "mostra a tela de Detalhes do Terminal"]
    S_BF_5 [flow: "basic", actor: "Operador", action: "modifica os dados existentes e clica no botao de 'Atualizar'", branches_af: [1]]
    S_BF_6 [flow: "basic", actor: "system", action: "notifica que o Terminal foi atualizado com sucesso", branches_ef: [1, 2]]
    S_AF1_1 [flow: "alternative_1", description: "cancela atualizacao de Terminal", actor: "Operador", action: "clica em botao 'Cancelar'", returns_to_bf: 2]
    S_EF1_1 [flow: "exception_1", description: "Cnpj ja existe no sistema", actor: "system", action: "alerta que ja existe um Terminal de mesmo Cnpj existente no sistema"]
    S_EF2_1 [flow: "exception_2", description: "Nao insere algum dado obrigatorio'", actor: "system", action: "informa que os dados obrigatorios devem ser preenchidos"]
    S_END [terminal, guard: "Terminal com dados atualizados no sistema."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe tela inicial do sistema"]
    S_BF_2 -> S_BF_3 [event: "Operador: seleciona a opcao 'Meu Terminal' no menu da tela principal"]
    S_BF_3 -> S_BF_4 [event: "system: mostra a tela de Detalhes do Terminal"]
    S_BF_4 -> S_BF_5 [event: "Operador: modifica os dados existentes e clica no botao de 'Atualizar'"]
    S_BF_5 -> S_BF_6 [event: "system: notifica que o Terminal foi atualizado com sucesso"]
    S_BF_5 -> S_AF1_1 [branch: "AF_1 - cancela atualizacao de Terminal"]
    S_BF_6 -> S_END [event: "Complete"]
    S_BF_6 -> S_EF1_1 [branch: "EF_1 - Cnpj ja existe no sistema"]
    S_BF_6 -> S_EF2_1 [branch: "EF_2 - Nao insere algum dado obrigatorio'"]
    S_AF1_1 -> S_BF_2 [resume_basic_flow: 2]
    S_EF1_1 -> S_END [event: "ErrorExit"]
    S_EF2_1 -> S_END [event: "ErrorExit"]
  }
}
