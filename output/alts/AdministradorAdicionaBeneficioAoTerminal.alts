ALTS_SPECIFICATION "Administrador Adiciona Beneficio Ao Terminal" {
  VERSION: "1.0"
  PRE_CONDITION: "Usuario Administrador logado no sistema. De existir pelo menos um terminal registrado."
  POST_CONDITION: "Beneficio de Terminal salvo no sistema"

  ACTORS {
    Administrador: "Usuario Administrador"
    system: "Bazooca"
  }

  STATES {
    S_INIT [initial, guard: "Usuario Administrador logado no sistema. De existir pelo menos um terminal registrado."]
    S_BF_1 [flow: "basic", actor: "Administrador", action: "abre tela inicial do sistema"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe tela inicial do sistema"]
    S_BF_3 [flow: "basic", actor: "Administrador", action: "seleciona a opcao 'Terminais' no menu da tela principal"]
    S_BF_4 [flow: "basic", actor: "system", action: "mostra a lista de Terminais do sistema"]
    S_BF_5 [flow: "basic", actor: "Administrador", action: "seleciona o Terminal em que sera adicionado o Beneficio", branches_af: [1]]
    S_BF_6 [flow: "basic", actor: "system", action: "abre a tela de edicao do Terminal"]
    S_BF_7 [flow: "basic", actor: "Administrador", action: "adiciona os dados do novo Beneficio na secao 'Beneficios' e clica no botao 'Adicionar Beneficio'", branches_af: [2]]
    S_BF_8 [flow: "basic", actor: "system", action: "notifica usuario que o novo Beneficio foi salvo e incrementa lista de Beneficios", branches_ef: [1]]
    S_AF1_1 [flow: "alternative_1", description: "Volta para listagem de Terminais", actor: "Administrador", action: "clica no botao Voltar", returns_to_bf: 2]
    S_AF2_1 [flow: "alternative_2", description: "Cancela registro de Beneficio de Terminal", actor: "Administrador", action: "clica no botao Cancelar", returns_to_bf: 4]
    S_EF1_1 [flow: "exception_1", description: "Nao insere algum dado obrigatorio'", actor: "system", action: "informa que os dados obrigatorios devem ser preenchidos"]
    S_EF1_2 [flow: "exception_1", description: "Nao insere algum dado obrigatorio'", actor: "Administrador", action: "adiciona os dados obrigatorios e clica no botao 'Adicionar Beneficio'"]
    S_END [terminal, guard: "Beneficio de Terminal salvo no sistema"]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe tela inicial do sistema"]
    S_BF_2 -> S_BF_3 [event: "Administrador: seleciona a opcao 'Terminais' no menu da tela principal"]
    S_BF_3 -> S_BF_4 [event: "system: mostra a lista de Terminais do sistema"]
    S_BF_4 -> S_BF_5 [event: "Administrador: seleciona o Terminal em que sera adicionado o Beneficio"]
    S_BF_5 -> S_BF_6 [event: "system: abre a tela de edicao do Terminal"]
    S_BF_5 -> S_AF1_1 [branch: "AF_1 - Volta para listagem de Terminais"]
    S_BF_6 -> S_BF_7 [event: "Administrador: adiciona os dados do novo Beneficio na secao 'Beneficios' e clica no botao 'Adicionar Beneficio'"]
    S_BF_7 -> S_BF_8 [event: "system: notifica usuario que o novo Beneficio foi salvo e incrementa lista de Beneficios"]
    S_BF_7 -> S_AF2_1 [branch: "AF_2 - Cancela registro de Beneficio de Terminal"]
    S_BF_8 -> S_END [event: "Complete"]
    S_BF_8 -> S_EF1_1 [branch: "EF_1 - Nao insere algum dado obrigatorio'"]
    S_AF1_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF2_1 -> S_BF_4 [resume_basic_flow: 4]
    S_EF1_1 -> S_EF1_2 [event: "Administrador: adiciona os dados obrigatorios e clica no botao 'Adicionar Beneficio'"]
    S_EF1_2 -> S_END [event: "ErrorExit"]
  }
}
