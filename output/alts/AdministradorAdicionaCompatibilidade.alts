ALTS_SPECIFICATION "Administrador Adiciona Compatibilidade" {
  VERSION: "1.0"
  PRE_CONDITION: "Usuario Administrador esta logado no sistema."
  POST_CONDITION: "A nova Compatibilidade esta adicionada ao banco."

  ACTORS {
    Administrador: "Usuario Administrador"
    system: "Bazooca"
  }

  STATES {
    S_INIT [initial, guard: "Usuario Administrador esta logado no sistema."]
    S_BF_1 [flow: "basic", actor: "Administrador", action: "abre tela inicial do sistema"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe tela inicial do sistema"]
    S_BF_3 [flow: "basic", actor: "Administrador", action: "clica na opcao 'Compatibilidade' no menu da tela principal"]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe a tela de listagem das Compatibilidades"]
    S_BF_5 [flow: "basic", actor: "Administrador", action: "clica em 'Adicionar Compatibilidade'", branches_af: [1]]
    S_BF_6 [flow: "basic", actor: "system", action: "exibe a tela de cadastro de Compatibilidade"]
    S_BF_7 [flow: "basic", actor: "Administrador", action: "preenche os dados da Compatibilidade e clica em botao 'Registrar'", branches_af: [2]]
    S_BF_8 [flow: "basic", actor: "system", action: "notifica usuario que os nova Compatibilidade foi adicionada com sucesso e exibe lista de Compatibilidades", branches_ef: [1, 2, 3]]
    S_AF1_1 [flow: "alternative_1", description: "Volta para listagem de Compatibilidades", actor: "Administrador", action: "clica no botao 'Voltar'", returns_to_bf: 4]
    S_AF2_1 [flow: "alternative_2", description: "Cancela registro de nova Compatibilidade", actor: "Administrador", action: "clica no botao 'Cancelar'", returns_to_bf: 2]
    S_EF1_1 [flow: "exception_1", description: "Nao insere algum dado obrigatorio'", actor: "system", action: "informa que os dados obrigatorios devem ser preenchidos"]
    S_EF1_2 [flow: "exception_1", description: "Nao insere algum dado obrigatorio'", actor: "Administrador", action: "preenche dados obrigatorios e clica em 'Atualizar'"]
    S_EF2_1 [flow: "exception_2", description: "Usuario insere Tipo de Mercadoria invalido", actor: "system", action: "alerta que Tipo de Mercadoria e invalido"]
    S_EF2_2 [flow: "exception_2", description: "Usuario insere Tipo de Mercadoria invalido", actor: "Administrador", action: "preenche um Tipo de Mercadoria valido e clica em 'Atualizar'"]
    S_EF3_1 [flow: "exception_3", description: "Usuario insere NCM invalido", actor: "system", action: "alerta que NCM e invalido"]
    S_EF3_2 [flow: "exception_3", description: "Usuario insere NCM invalido", actor: "Administrador", action: "preenche um NCM valido e clica em 'Atualizar'"]
    S_END [terminal, guard: "A nova Compatibilidade esta adicionada ao banco."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe tela inicial do sistema"]
    S_BF_2 -> S_BF_3 [event: "Administrador: clica na opcao 'Compatibilidade' no menu da tela principal"]
    S_BF_3 -> S_BF_4 [event: "system: exibe a tela de listagem das Compatibilidades"]
    S_BF_4 -> S_BF_5 [event: "Administrador: clica em 'Adicionar Compatibilidade'"]
    S_BF_5 -> S_BF_6 [event: "system: exibe a tela de cadastro de Compatibilidade"]
    S_BF_5 -> S_AF1_1 [branch: "AF_1 - Volta para listagem de Compatibilidades"]
    S_BF_6 -> S_BF_7 [event: "Administrador: preenche os dados da Compatibilidade e clica em botao 'Registrar'"]
    S_BF_7 -> S_BF_8 [event: "system: notifica usuario que os nova Compatibilidade foi adicionada com sucesso e exibe lista de Compatibilidades"]
    S_BF_7 -> S_AF2_1 [branch: "AF_2 - Cancela registro de nova Compatibilidade"]
    S_BF_8 -> S_END [event: "Complete"]
    S_BF_8 -> S_EF1_1 [branch: "EF_1 - Nao insere algum dado obrigatorio'"]
    S_BF_8 -> S_EF2_1 [branch: "EF_2 - Usuario insere Tipo de Mercadoria invalido"]
    S_BF_8 -> S_EF3_1 [branch: "EF_3 - Usuario insere NCM invalido"]
    S_AF1_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF2_1 -> S_BF_2 [resume_basic_flow: 2]
    S_EF1_1 -> S_EF1_2 [event: "Administrador: preenche dados obrigatorios e clica em 'Atualizar'"]
    S_EF1_2 -> S_END [event: "ErrorExit"]
    S_EF2_1 -> S_EF2_2 [event: "Administrador: preenche um Tipo de Mercadoria valido e clica em 'Atualizar'"]
    S_EF2_2 -> S_END [event: "ErrorExit"]
    S_EF3_1 -> S_EF3_2 [event: "Administrador: preenche um NCM valido e clica em 'Atualizar'"]
    S_EF3_2 -> S_END [event: "ErrorExit"]
  }
}
