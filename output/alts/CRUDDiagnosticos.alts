ALTS_SPECIFICATION "CRUD Diagnosticos" {
  VERSION: "1.0"
  PRE_CONDITION: " "
  POST_CONDITION: ""

  ACTORS {
  }

  STATES {
    S_INIT [initial, guard: " "]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe tela principal"]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe lista diagnosticos"]
    S_BF_6 [flow: "basic", actor: "system", action: "exibe página com campos de cadastro de novo documento"]
    S_BF_8 [flow: "basic", actor: "system", action: "exibe lista de diagnósticos"]
    S_BF_10 [flow: "basic", actor: "system", action: "exibe dados do diagnóstico"]
    S_BF_12 [flow: "basic", actor: "system", action: "retorna a lista de diagnosticos"]
    S_AF6_2 [flow: "alternative_6", description: "Scenary ou Situation faltando informacao", actor: "system", action: "exibe mensagem informando que existe informaçao indispensável faltando", returns_to_bf: 7]
    S_AF1_2 [flow: "alternative_1", description: "Campo fora da formatação esperada", actor: "system", action: "exibe mensagem informando que os dados nao correspondem a formatação esperada", returns_to_bf: 7]
    S_AF3_2 [flow: "alternative_3", description: "Edita dados", actor: "system", action: "exibe campos do diagnostico com valores atuais que podem ser editados"]
    S_AF4_2 [flow: "alternative_4", description: "Deleta diagnostico", actor: "system", action: "exibe mensagem solicitando confirmaçao"]
    S_AF5_2 [flow: "alternative_5", description: "Visualizaçao para Operador, Gerente", actor: "system", action: "exibe tela principal"]
    S_AF5_4 [flow: "alternative_5", description: "Visualizaçao para Operador, Gerente", actor: "system", action: "exibe lista de diagnosticos pertencentes ao mesmo laboratorio do usuario"]
    S_END [terminal, guard: ""]
  }

  TRANSITIONS {
    S_INIT -> S_BF_2 [trigger: "Start"]
    S_BF_2 -> S_BF_4 [event: "system: exibe lista diagnosticos"]
    S_BF_4 -> S_BF_6 [event: "system: exibe página com campos de cadastro de novo documento"]
    S_BF_6 -> S_BF_8 [event: "system: exibe lista de diagnósticos"]
    S_BF_8 -> S_BF_10 [event: "system: exibe dados do diagnóstico"]
    S_BF_10 -> S_BF_12 [event: "system: retorna a lista de diagnosticos"]
    S_BF_12 -> S_END [event: "Complete"]
    S_AF6_2 -> S_BF_7 [resume_basic_flow: 7]
    S_AF1_2 -> S_BF_7 [resume_basic_flow: 7]
    S_AF3_2 -> S_END [event: "Complete"]
    S_AF4_2 -> S_END [event: "Complete"]
    S_AF5_2 -> S_AF5_4 [event: "system: exibe lista de diagnosticos pertencentes ao mesmo laboratorio do usuario"]
    S_AF5_4 -> S_END [event: "Complete"]
  }
}
