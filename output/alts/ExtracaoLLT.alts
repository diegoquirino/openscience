ALTS_SPECIFICATION "Extracao em modo LLT" {
  VERSION: "1.0"
  PRE_CONDITION: "Usuário deve estar logado no servidor como administrador ; Não existem extrações cadastradas no banco de dados"
  POST_CONDITION: ""

  ACTORS {
    administrador: "Administrador do sistema"
  }

  STATES {
    S_INIT [initial, guard: "Usuário deve estar logado no servidor como administrador ; Não existem extrações cadastradas no banco de dados"]
    S_BF_1 [flow: "basic", actor: "administrador", action: "conecta um terminal em uma porta USB previamente cadastrada e o coloca em modo LLT"]
    S_BF_2 [flow: "basic", actor: "system", action: "entra em modo LLT", branches_ef: [1, 5]]
    S_BF_3 [flow: "basic", actor: "administrador", action: "inicia o SAFF Extractor e se autentica"]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe página que requisita dados do terminal"]
    S_BF_5 [flow: "basic", actor: "administrador", action: "digita o product number e serial number válidos e pressiona tecla Tab"]
    S_BF_6 [flow: "basic", actor: "system", action: "muda foco para campo referente ao tipo de teste"]
    S_BF_7 [flow: "basic", actor: "administrador", action: "escolhe opção Test1 para tipo de teste e pressiona botão 'Extract'"]
    S_BF_6 [flow: "basic", actor: "system", action: "realiza a extração", branches_ef: [3, 4, 6]]
    S_EF1_1 [flow: "exception_1", description: "Não existe porta USB cadastrada", actor: "system", action: "exibe mensagem solicitando informando não existe porta USB cadastrada"]
    S_EF3_1 [flow: "exception_3", description: "Falha no envio para servidor e Usuário deseja fazer extração offline", actor: "system", action: "exibe mensagem informando houve erro na conexão com o servidor e pergunta se usuário deseja fazer a extração em modo offline"]
    S_EF3_2 [flow: "exception_3", description: "Falha no envio para servidor e Usuário deseja fazer extração offline", actor: "administrador", action: "responde Yes"]
    S_EF3_3 [flow: "exception_3", description: "Falha no envio para servidor e Usuário deseja fazer extração offline", actor: "system", action: "exibe página que requisita dados do terminal"]
    S_EF3_4 [flow: "exception_3", description: "Falha no envio para servidor e Usuário deseja fazer extração offline", actor: "administrador", action: "digita o product number e serial number válidos e pressiona tecla Tab"]
    S_EF3_5 [flow: "exception_3", description: "Falha no envio para servidor e Usuário deseja fazer extração offline", actor: "system", action: "muda foco para campo referente ao tipo de teste"]
    S_EF3_6 [flow: "exception_3", description: "Falha no envio para servidor e Usuário deseja fazer extração offline", actor: "administrador", action: "escolhe opção Test1 para tipo de teste e pressiona botão 'Extract'"]
    S_EF3_7 [flow: "exception_3", description: "Falha no envio para servidor e Usuário deseja fazer extração offline", actor: "system", action: "salva extração em pasta local"]
    S_EF4_1 [flow: "exception_4", description: "Dados de terminal inválidos", actor: "system", action: "exibe mensagem informando que dados do terminal estão incorretos"]
    S_EF5_1 [flow: "exception_5", description: "Não existe terminal conectado", actor: "system", action: "exibe mensagem informando que não conseguiu se conectar ao terminal"]
    S_EF6_1 [flow: "exception_6", description: "Falha no envio para servidor e Usuário não deseja fazer extração offline", actor: "system", action: "exibe mensagem informando houve erro na conexão com o servidor e pergunta se usuário deseja fazer a extração em modo offline"]
    S_EF6_2 [flow: "exception_6", description: "Falha no envio para servidor e Usuário não deseja fazer extração offline", actor: "administrador", action: "responde No"]
    S_EF6_3 [flow: "exception_6", description: "Falha no envio para servidor e Usuário não deseja fazer extração offline", actor: "system", action: "fecha janela e retorna a página de inserção de dados"]
    S_END [terminal, guard: ""]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: entra em modo LLT"]
    S_BF_2 -> S_BF_3 [event: "administrador: inicia o SAFF Extractor e se autentica"]
    S_BF_2 -> S_EF1_1 [branch: "EF_1 - Não existe porta USB cadastrada"]
    S_BF_2 -> S_EF5_1 [branch: "EF_5 - Não existe terminal conectado"]
    S_BF_3 -> S_BF_4 [event: "system: exibe página que requisita dados do terminal"]
    S_BF_4 -> S_BF_5 [event: "administrador: digita o product number e serial number válidos e pressiona tecla Tab"]
    S_BF_5 -> S_BF_6 [event: "system: muda foco para campo referente ao tipo de teste"]
    S_BF_6 -> S_BF_7 [event: "administrador: escolhe opção Test1 para tipo de teste e pressiona botão 'Extract'"]
    S_BF_7 -> S_BF_6 [event: "system: realiza a extração"]
    S_BF_6 -> S_END [event: "Complete"]
    S_BF_6 -> S_EF3_1 [branch: "EF_3 - Falha no envio para servidor e Usuário deseja fazer extração offline"]
    S_BF_6 -> S_EF4_1 [branch: "EF_4 - Dados de terminal inválidos"]
    S_BF_6 -> S_EF6_1 [branch: "EF_6 - Falha no envio para servidor e Usuário não deseja fazer extração offline"]
    S_EF1_1 -> S_END [event: "ErrorExit"]
    S_EF3_1 -> S_EF3_2 [event: "administrador: responde Yes"]
    S_EF3_2 -> S_EF3_3 [event: "system: exibe página que requisita dados do terminal"]
    S_EF3_3 -> S_EF3_4 [event: "administrador: digita o product number e serial number válidos e pressiona tecla Tab"]
    S_EF3_4 -> S_EF3_5 [event: "system: muda foco para campo referente ao tipo de teste"]
    S_EF3_5 -> S_EF3_6 [event: "administrador: escolhe opção Test1 para tipo de teste e pressiona botão 'Extract'"]
    S_EF3_6 -> S_EF3_7 [event: "system: salva extração em pasta local"]
    S_EF3_7 -> S_END [event: "ErrorExit"]
    S_EF4_1 -> S_END [event: "ErrorExit"]
    S_EF5_1 -> S_END [event: "ErrorExit"]
    S_EF6_1 -> S_EF6_2 [event: "administrador: responde No"]
    S_EF6_2 -> S_EF6_3 [event: "system: fecha janela e retorna a página de inserção de dados"]
    S_EF6_3 -> S_END [event: "ErrorExit"]
  }
}
