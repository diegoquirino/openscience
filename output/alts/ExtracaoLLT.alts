ALTS_SPECIFICATION "Extracao em modo LLT" {
  VERSION: "1.0"
  PRE_CONDITION: " "
  POST_CONDITION: "extracao realizada"

  ACTORS {
    operador: "Operador do sistema"
  }

  STATES {
    S_INIT [initial, guard: " "]
    S_BF_1 [flow: "basic", actor: "operador", action: "inicia o SAFF Extractor e se autentica"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe pagina que requisita dados do terminal"]
    S_BF_3 [flow: "basic", actor: "operador", action: "escolhe opcao Pre_Test para tipo de teste", branches_af: [2, 3, 4, 5, 7, 8]]
    S_BF_4 [flow: "basic", actor: "system", action: "apresenta a marcacao da opcao escolhida"]
    S_BF_5 [flow: "basic", actor: "operador", action: "digita um product number e serial number validos e pressiona Extract (terminal em modo LLT)", branches_af: [1, 6, 9, 10]]
    S_BF_6 [flow: "basic", actor: "system", action: "realiza a extração, a envia para o servidor, e a salva nas pastas de backup local ('Backup' e 'Results')", branches_ef: [2, 3, 4, 1, 5]]
    S_BF_7 [flow: "basic", actor: "operador", action: "loga no servidor e vai ate a pagina de extracoes"]
    S_BF_8 [flow: "basic", actor: "system", action: "exibe lista que inclui a extracao realizada"]
    S_AF1_1 [flow: "alternative_1", description: "Terminal nao se encontra em modo LLT", actor: "operador", action: "conecta terminal em porta USB e o coloca em modo LLT"]
    S_AF1_2 [flow: "alternative_1", description: "Terminal nao se encontra em modo LLT", actor: "system", action: "(terminal) entra em modo LLT", returns_to_bf: 5]
    S_AF2_1 [flow: "alternative_2", description: "Test 1", actor: "operador", action: "marca opcao Test 1 para tipo de teste", returns_to_bf: 4]
    S_AF3_1 [flow: "alternative_3", description: "Test 2", actor: "operador", action: "marca opcao Test 2 para tipo de teste", returns_to_bf: 4]
    S_AF4_1 [flow: "alternative_4", description: "QA", actor: "operador", action: "marca opcao QA para tipo de teste", returns_to_bf: 4]
    S_AF5_1 [flow: "alternative_5", description: "Note", actor: "operador", action: "insere uma anotacao para a extracao", returns_to_bf: 4]
    S_AF6_1 [flow: "alternative_6", description: "Uso do leitor de codigo de barras", actor: "operador", action: "le (via leitor de codigo de barras) um product number e serial number validos", returns_to_bf: 6]
    S_AF7_1 [flow: "alternative_7", description: "Redirect", actor: "operador", action: "marca a opcao 'Redirect to the display of data'"]
    S_AF7_2 [flow: "alternative_7", description: "Redirect", actor: "system", action: "apresenta a marcacao da opcao escolhida"]
    S_AF7_3 [flow: "alternative_7", description: "Redirect", actor: "operador", action: "digita um product number e serial number validos e pressiona Extract (terminal em modo LLT)"]
    S_AF7_4 [flow: "alternative_7", description: "Redirect", actor: "system", action: "realiza a extracao, a envia para o servidor, a salva nas pastas de backup local e abre o browser mostrando a extracao realizada"]
    S_AF8_1 [flow: "alternative_8", description: "Disable LLT", actor: "operador", action: "marca a opcao 'Disable LLT'"]
    S_AF8_2 [flow: "alternative_8", description: "Disable LLT", actor: "system", action: "apresenta a marcacao da opcao escolhida"]
    S_AF8_3 [flow: "alternative_8", description: "Disable LLT", actor: "operador", action: "digita um product number e serial number validos e pressiona Extract"]
    S_AF8_4 [flow: "alternative_8", description: "Disable LLT", actor: "system", action: "realiza uma extracao Disabled LLT, a envia para o servidor, e a salva nas pastas de backup local"]
    S_AF9_1 [flow: "alternative_9", description: "Product number e/ou serial number invalidos", actor: "operador", action: "digita um product number e/ou serial number invalidos"]
    S_AF9_2 [flow: "alternative_9", description: "Product number e/ou serial number invalidos", actor: "system", action: "marca campo em vermelho alertando do erro", returns_to_bf: 5]
    S_AF10_1 [flow: "alternative_10", description: "Product number e serial number que nao casam", actor: "operador", action: "digita um product number e serial number validos mas nao referentes a mesma familia e pressiona Extract (terminal em modo LLT)"]
    S_AF10_2 [flow: "alternative_10", description: "Product number e serial number que nao casam", actor: "system", action: "apresenta mensagem de erro", returns_to_bf: 3]
    S_EF1_1 [flow: "exception_1", description: "Nao existe porta USB cadastrada", actor: "system", action: "exibe mensagem solicitando informando não existe porta USB cadastrada"]
    S_EF2_1 [flow: "exception_2", description: "Falha no envio para servidor e Usuário não deseja fazer extração offline", actor: "system", action: "exibe mensagem informando que houve erro na conexão com o servidor e pergunta se usuario deseja fazer a extração em modo offline"]
    S_EF2_2 [flow: "exception_2", description: "Falha no envio para servidor e Usuário não deseja fazer extração offline", actor: "operador", action: "responde No"]
    S_EF2_3 [flow: "exception_2", description: "Falha no envio para servidor e Usuário não deseja fazer extração offline", actor: "system", action: "fecha janela e retorna a pagina que requisita dados do terminal"]
    S_EF3_1 [flow: "exception_3", description: "Falha no envio para servidor e Usuário deseja fazer extração offline", actor: "system", action: "exibe mensagem informando que houve erro na conexão com o servidor e pergunta se usuario deseja fazer a extração em modo offline"]
    S_EF3_2 [flow: "exception_3", description: "Falha no envio para servidor e Usuário deseja fazer extração offline", actor: "operador", action: "responde Yes"]
    S_EF3_3 [flow: "exception_3", description: "Falha no envio para servidor e Usuário deseja fazer extração offline", actor: "system", action: "exibe pagina que requisita dados do terminal"]
    S_EF3_4 [flow: "exception_3", description: "Falha no envio para servidor e Usuário deseja fazer extração offline", actor: "operador", action: "configura o teste, insere product number e serial number válidos inicia a extracao"]
    S_EF3_5 [flow: "exception_3", description: "Falha no envio para servidor e Usuário deseja fazer extração offline", actor: "system", action: "salva extração em pasta local"]
    S_EF4_1 [flow: "exception_4", description: "Dados de terminal inválidos", actor: "system", action: "exibe mensagem informando que dados do terminal estão incorretos"]
    S_EF5_1 [flow: "exception_5", description: "Nao existe terminal conectado", actor: "system", action: "exibe mensagem informando que não conseguiu se conectar ao terminal"]
    S_END [terminal, guard: "extracao realizada"]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe pagina que requisita dados do terminal"]
    S_BF_2 -> S_BF_3 [event: "operador: escolhe opcao Pre_Test para tipo de teste"]
    S_BF_3 -> S_BF_4 [event: "system: apresenta a marcacao da opcao escolhida"]
    S_BF_3 -> S_AF2_1 [branch: "AF_2 - Test 1"]
    S_BF_3 -> S_AF3_1 [branch: "AF_3 - Test 2"]
    S_BF_3 -> S_AF4_1 [branch: "AF_4 - QA"]
    S_BF_3 -> S_AF5_1 [branch: "AF_5 - Note"]
    S_BF_3 -> S_AF7_1 [branch: "AF_7 - Redirect"]
    S_BF_3 -> S_AF8_1 [branch: "AF_8 - Disable LLT"]
    S_BF_4 -> S_BF_5 [event: "operador: digita um product number e serial number validos e pressiona Extract (terminal em modo LLT)"]
    S_BF_5 -> S_BF_6 [event: "system: realiza a extração, a envia para o servidor, e a salva nas pastas de backup local ('Backup' e 'Results')"]
    S_BF_5 -> S_AF1_1 [branch: "AF_1 - Terminal nao se encontra em modo LLT"]
    S_BF_5 -> S_AF6_1 [branch: "AF_6 - Uso do leitor de codigo de barras"]
    S_BF_5 -> S_AF9_1 [branch: "AF_9 - Product number e/ou serial number invalidos"]
    S_BF_5 -> S_AF10_1 [branch: "AF_10 - Product number e serial number que nao casam"]
    S_BF_6 -> S_BF_7 [event: "operador: loga no servidor e vai ate a pagina de extracoes"]
    S_BF_6 -> S_EF2_1 [branch: "EF_2 - Falha no envio para servidor e Usuário não deseja fazer extração offline"]
    S_BF_6 -> S_EF3_1 [branch: "EF_3 - Falha no envio para servidor e Usuário deseja fazer extração offline"]
    S_BF_6 -> S_EF4_1 [branch: "EF_4 - Dados de terminal inválidos"]
    S_BF_6 -> S_EF1_1 [branch: "EF_1 - Nao existe porta USB cadastrada"]
    S_BF_6 -> S_EF5_1 [branch: "EF_5 - Nao existe terminal conectado"]
    S_BF_7 -> S_BF_8 [event: "system: exibe lista que inclui a extracao realizada"]
    S_BF_8 -> S_END [event: "Complete"]
    S_AF1_1 -> S_AF1_2 [event: "system: (terminal) entra em modo LLT"]
    S_AF1_2 -> S_BF_5 [resume_basic_flow: 5]
    S_AF2_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF3_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF4_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF5_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF6_1 -> S_BF_6 [resume_basic_flow: 6]
    S_AF7_1 -> S_AF7_2 [event: "system: apresenta a marcacao da opcao escolhida"]
    S_AF7_2 -> S_AF7_3 [event: "operador: digita um product number e serial number validos e pressiona Extract (terminal em modo LLT)"]
    S_AF7_3 -> S_AF7_4 [event: "system: realiza a extracao, a envia para o servidor, a salva nas pastas de backup local e abre o browser mostrando a extracao realizada"]
    S_AF7_4 -> S_END [event: "Complete"]
    S_AF8_1 -> S_AF8_2 [event: "system: apresenta a marcacao da opcao escolhida"]
    S_AF8_2 -> S_AF8_3 [event: "operador: digita um product number e serial number validos e pressiona Extract"]
    S_AF8_3 -> S_AF8_4 [event: "system: realiza uma extracao Disabled LLT, a envia para o servidor, e a salva nas pastas de backup local"]
    S_AF8_4 -> S_END [event: "Complete"]
    S_AF9_1 -> S_AF9_2 [event: "system: marca campo em vermelho alertando do erro"]
    S_AF9_2 -> S_BF_5 [resume_basic_flow: 5]
    S_AF10_1 -> S_AF10_2 [event: "system: apresenta mensagem de erro"]
    S_AF10_2 -> S_BF_3 [resume_basic_flow: 3]
    S_EF1_1 -> S_END [event: "ErrorExit"]
    S_EF2_1 -> S_EF2_2 [event: "operador: responde No"]
    S_EF2_2 -> S_EF2_3 [event: "system: fecha janela e retorna a pagina que requisita dados do terminal"]
    S_EF2_3 -> S_END [event: "ErrorExit"]
    S_EF3_1 -> S_EF3_2 [event: "operador: responde Yes"]
    S_EF3_2 -> S_EF3_3 [event: "system: exibe pagina que requisita dados do terminal"]
    S_EF3_3 -> S_EF3_4 [event: "operador: configura o teste, insere product number e serial number válidos inicia a extracao"]
    S_EF3_4 -> S_EF3_5 [event: "system: salva extração em pasta local"]
    S_EF3_5 -> S_END [event: "ErrorExit"]
    S_EF4_1 -> S_END [event: "ErrorExit"]
    S_EF5_1 -> S_END [event: "ErrorExit"]
  }
}
