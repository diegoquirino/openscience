ALTS_SPECIFICATION "CRUD Secoes" {
  VERSION: "1.0"
  PRE_CONDITION: "Estar logado como super administrador"
  POST_CONDITION: ""

  ACTORS {
    superAdmin: "Super administrador"
  }

  STATES {
    S_INIT [initial, guard: "Estar logado como super administrador"]
    S_BF_1 [flow: "basic", actor: "superAdmin", action: "seleciona opção 'Sections' no menu Settings"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe lista de Seções"]
    S_BF_9 [flow: "basic", actor: "superAdmin", action: "clica no nome de uma seção"]
    S_BF_10 [flow: "basic", actor: "system", action: "exibe dados da seção"]
    S_BF_11 [flow: "basic", actor: "superAdmin", action: "clica no botão 'Cancel'", branches_af: [1]]
    S_BF_12 [flow: "basic", actor: "system", action: "retorna a lista de seções"]
    S_AF1_1 [flow: "alternative_1", description: "Edita dados", actor: "superAdmin", action: "clica no botão 'Edit'"]
    S_AF1_2 [flow: "alternative_1", description: "Edita dados", actor: "system", action: "lista as opções possíveis de serem incluídas na seção"]
    S_AF1_3 [flow: "alternative_1", description: "Edita dados", actor: "superAdmin", action: "escolhe as opções e pressiona o botão 'Update"]
    S_AF1_4 [flow: "alternative_1", description: "Edita dados", actor: "system", action: "exibe mensagem informando que a seção foi atualizada", returns_to_bf: 1]
    S_END [terminal, guard: ""]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe lista de Seções"]
    S_BF_2 -> S_BF_9 [event: "superAdmin: clica no nome de uma seção"]
    S_BF_9 -> S_BF_10 [event: "system: exibe dados da seção"]
    S_BF_10 -> S_BF_11 [event: "superAdmin: clica no botão 'Cancel'"]
    S_BF_11 -> S_BF_12 [event: "system: retorna a lista de seções"]
    S_BF_11 -> S_AF1_1 [branch: "AF_1 - Edita dados"]
    S_BF_12 -> S_END [event: "Complete"]
    S_AF1_1 -> S_AF1_2 [event: "system: lista as opções possíveis de serem incluídas na seção"]
    S_AF1_2 -> S_AF1_3 [event: "superAdmin: escolhe as opções e pressiona o botão 'Update"]
    S_AF1_3 -> S_AF1_4 [event: "system: exibe mensagem informando que a seção foi atualizada"]
    S_AF1_4 -> S_BF_1 [resume_basic_flow: 1]
  }
}
