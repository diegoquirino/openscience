ALTS_SPECIFICATION "Administrador De Ecommerce Adiciona Administrador De Ecommerce" {
  VERSION: "1.0"
  PRE_CONDITION: "Usuario Administrador de Ecommerce esta logado no sistema; Usuario pertence ao Ecommerce alvo."
  POST_CONDITION: "O novo Administrador de Ecommerce esta salvo no sistema."

  ACTORS {
    AdminEcommerce: "Usuario Administrador de Ecommerce"
    system: "Bazooca"
  }

  STATES {
    S_INIT [initial, guard: "Usuario Administrador de Ecommerce esta logado no sistema; Usuario pertence ao Ecommerce alvo."]
    S_BF_1 [flow: "basic", actor: "AdminEcommerce", action: "abre tela inicial do sistema"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe tela inicial do sistema"]
    S_BF_3 [flow: "basic", actor: "AdminEcommerce", action: "clica no opcao 'Meu Ecommerce' no menu principal"]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe tela com informacoes de Ecommerce"]
    S_BF_5 [flow: "basic", actor: "AdminEcommerce", action: "adiciona os dados do novo Administrador na secao 'Administradores' e clica no botao 'Adicionar Administrador'", branches_af: [1, 2]]
    S_BF_6 [flow: "basic", actor: "system", action: "mostra Administrador adicionado em tabela na tela de cadastro", branches_ef: [1, 2, 3, 4, 5, 6]]
    S_AF1_1 [flow: "alternative_1", description: "Cancela registro de novo Administrador de Ecommerce", actor: "AdminEcommerce", action: "clica no botao 'Cancelar' de registro de Administrador", returns_to_bf: 4]
    S_AF2_1 [flow: "alternative_2", description: "Volta para tela inicial do sistema", actor: "AdminEcommerce", action: "clica no botao 'Voltar' do form de Ecommerce", returns_to_bf: 2]
    S_EF1_1 [flow: "exception_1", description: "Campos obrigatorios", actor: "system", action: "alerta ao usuario que o campo deve ser preenchido"]
    S_EF1_2 [flow: "exception_1", description: "Campos obrigatorios", actor: "AdminEcommerce", action: "informa os campos obrigatorios e clica no botao de 'Adicionar Administrador'"]
    S_EF2_1 [flow: "exception_2", description: "Nome de Usuario ja cadastrado", actor: "system", action: "alerta que ja existe um Administrador cadastrado com o nome de usuario informado"]
    S_EF2_2 [flow: "exception_2", description: "Nome de Usuario ja cadastrado", actor: "AdminEcommerce", action: "informa um novo Nome de Usuario e clica no botao de 'Adicionar Administrador'"]
    S_EF3_1 [flow: "exception_3", description: "Email ja cadastrado", actor: "system", action: "alerta que ja existe um Administrador cadastrado com o email informado"]
    S_EF3_2 [flow: "exception_3", description: "Email ja cadastrado", actor: "AdminEcommerce", action: "informa um novo Email e clica no botao de 'Adicionar Administrador'"]
    S_EF4_1 [flow: "exception_4", description: "Email invalido", actor: "system", action: "alerta que ja existe um Administrador cadastrado com o email informado"]
    S_EF4_2 [flow: "exception_4", description: "Email invalido", actor: "AdminEcommerce", action: "informa um novo Email valido e clica no botao de 'Adicionar Administrador'"]
    S_EF5_1 [flow: "exception_5", description: "Cpf ja cadastrado", actor: "system", action: "alerta que ja existe um Administrador cadastrado com o cpf informado"]
    S_EF5_2 [flow: "exception_5", description: "Cpf ja cadastrado", actor: "AdminEcommerce", action: "informa um novo Cpf e clica no botao de 'Adicionar Administrador'"]
    S_EF6_1 [flow: "exception_6", description: "Senhas nao coincidem", actor: "system", action: "alerta que as senhas informadas nao coincidem"]
    S_EF6_2 [flow: "exception_6", description: "Senhas nao coincidem", actor: "AdminEcommerce", action: "informa senhas iguais e clica no botao de 'Adicionar Administrador'"]
    S_END [terminal, guard: "O novo Administrador de Ecommerce esta salvo no sistema."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe tela inicial do sistema"]
    S_BF_2 -> S_BF_3 [event: "AdminEcommerce: clica no opcao 'Meu Ecommerce' no menu principal"]
    S_BF_3 -> S_BF_4 [event: "system: exibe tela com informacoes de Ecommerce"]
    S_BF_4 -> S_BF_5 [event: "AdminEcommerce: adiciona os dados do novo Administrador na secao 'Administradores' e clica no botao 'Adicionar Administrador'"]
    S_BF_5 -> S_BF_6 [event: "system: mostra Administrador adicionado em tabela na tela de cadastro"]
    S_BF_5 -> S_AF1_1 [branch: "AF_1 - Cancela registro de novo Administrador de Ecommerce"]
    S_BF_5 -> S_AF2_1 [branch: "AF_2 - Volta para tela inicial do sistema"]
    S_BF_6 -> S_END [event: "Complete"]
    S_BF_6 -> S_EF1_1 [branch: "EF_1 - Campos obrigatorios"]
    S_BF_6 -> S_EF2_1 [branch: "EF_2 - Nome de Usuario ja cadastrado"]
    S_BF_6 -> S_EF3_1 [branch: "EF_3 - Email ja cadastrado"]
    S_BF_6 -> S_EF4_1 [branch: "EF_4 - Email invalido"]
    S_BF_6 -> S_EF5_1 [branch: "EF_5 - Cpf ja cadastrado"]
    S_BF_6 -> S_EF6_1 [branch: "EF_6 - Senhas nao coincidem"]
    S_AF1_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF2_1 -> S_BF_2 [resume_basic_flow: 2]
    S_EF1_1 -> S_EF1_2 [event: "AdminEcommerce: informa os campos obrigatorios e clica no botao de 'Adicionar Administrador'"]
    S_EF1_2 -> S_END [event: "ErrorExit"]
    S_EF2_1 -> S_EF2_2 [event: "AdminEcommerce: informa um novo Nome de Usuario e clica no botao de 'Adicionar Administrador'"]
    S_EF2_2 -> S_END [event: "ErrorExit"]
    S_EF3_1 -> S_EF3_2 [event: "AdminEcommerce: informa um novo Email e clica no botao de 'Adicionar Administrador'"]
    S_EF3_2 -> S_END [event: "ErrorExit"]
    S_EF4_1 -> S_EF4_2 [event: "AdminEcommerce: informa um novo Email valido e clica no botao de 'Adicionar Administrador'"]
    S_EF4_2 -> S_END [event: "ErrorExit"]
    S_EF5_1 -> S_EF5_2 [event: "AdminEcommerce: informa um novo Cpf e clica no botao de 'Adicionar Administrador'"]
    S_EF5_2 -> S_END [event: "ErrorExit"]
    S_EF6_1 -> S_EF6_2 [event: "AdminEcommerce: informa senhas iguais e clica no botao de 'Adicionar Administrador'"]
    S_EF6_2 -> S_END [event: "ErrorExit"]
  }
}
