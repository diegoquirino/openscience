ALTS_SPECIFICATION "Administrador Imprime Lista De Produtos De Picking" {
  VERSION: "1.0"
  PRE_CONDITION: "Usuario Administrador esta logado no sistema. Existe um Ecommerce com picking para o dia"
  POST_CONDITION: ""

  ACTORS {
    Administrador: "Usuario Administrador"
    system: "Bazooca"
  }

  STATES {
    S_INIT [initial, guard: "Usuario Administrador esta logado no sistema. Existe um Ecommerce com picking para o dia"]
    S_BF_1 [flow: "basic", actor: "Administrador", action: "clica na opcao 'Picking' no menu da tela principal"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe lista de Ecommerces registrados no sistema"]
    S_BF_3 [flow: "basic", actor: "Administrador", action: "clica em algum dos Ecommerces listados", branches_af: [1, 2, 3, 4]]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe tela com o Picking diario para aquele Ecommerce selecionado"]
    S_BF_5 [flow: "basic", actor: "Administrador", action: "clica no botao 'Imprimir Lista'", branches_af: [5]]
    S_BF_6 [flow: "basic", actor: "system", action: "exibe pdf com lista de Produtos do Picking"]
    S_BF_7 [flow: "basic", actor: "Administrador", action: "clica no botao de 'Imprimir'", branches_af: [6]]
    S_BF_8 [flow: "basic", actor: "system", action: "envia documento para impressora e exibe tela de Picking"]
    S_AF1_1 [flow: "alternative_1", description: "Navega pelas paginas da lista", actor: "Administrador", action: "seleciona outra pagina", returns_to_bf: 2]
    S_AF2_1 [flow: "alternative_2", description: "Clica no botao 'Voltar'", actor: "Administrador", action: "clica no botao 'Voltar'", returns_to_bf: 2]
    S_AF3_1 [flow: "alternative_3", description: "Ordena os Ecommerces", actor: "Administrador", action: "ordena os Ecommerces por alguma coluna", returns_to_bf: 2]
    S_AF4_1 [flow: "alternative_4", description: "Filtra coletas da lista", actor: "Administrador", action: "filtra as coletas por algum campo", returns_to_bf: 2]
    S_AF5_1 [flow: "alternative_5", description: "Volta para lista de Ecommerces", actor: "Administrador", action: "clica no botao 'Voltar'", returns_to_bf: 2]
    S_AF6_1 [flow: "alternative_6", description: "Cancela impressao de documento", actor: "Administrador", action: "clica em botao cancelar", returns_to_bf: 4]
    S_END [terminal, guard: ""]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe lista de Ecommerces registrados no sistema"]
    S_BF_2 -> S_BF_3 [event: "Administrador: clica em algum dos Ecommerces listados"]
    S_BF_3 -> S_BF_4 [event: "system: exibe tela com o Picking diario para aquele Ecommerce selecionado"]
    S_BF_3 -> S_AF1_1 [branch: "AF_1 - Navega pelas paginas da lista"]
    S_BF_3 -> S_AF2_1 [branch: "AF_2 - Clica no botao 'Voltar'"]
    S_BF_3 -> S_AF3_1 [branch: "AF_3 - Ordena os Ecommerces"]
    S_BF_3 -> S_AF4_1 [branch: "AF_4 - Filtra coletas da lista"]
    S_BF_4 -> S_BF_5 [event: "Administrador: clica no botao 'Imprimir Lista'"]
    S_BF_5 -> S_BF_6 [event: "system: exibe pdf com lista de Produtos do Picking"]
    S_BF_5 -> S_AF5_1 [branch: "AF_5 - Volta para lista de Ecommerces"]
    S_BF_6 -> S_BF_7 [event: "Administrador: clica no botao de 'Imprimir'"]
    S_BF_7 -> S_BF_8 [event: "system: envia documento para impressora e exibe tela de Picking"]
    S_BF_7 -> S_AF6_1 [branch: "AF_6 - Cancela impressao de documento"]
    S_BF_8 -> S_END [event: "Complete"]
    S_AF1_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF2_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF3_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF4_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF5_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF6_1 -> S_BF_4 [resume_basic_flow: 4]
  }
}
