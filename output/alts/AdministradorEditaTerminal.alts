ALTS_SPECIFICATION "Administrador Edita Terminal" {
  VERSION: "1.0"
  PRE_CONDITION: "Usuario Administrador esta logado no sistema"
  POST_CONDITION: "O Terminal foi atualizado com sucesso."

  ACTORS {
    Administrador: "Usuario Administrador"
    system: "Bazooca"
  }

  STATES {
    S_INIT [initial, guard: "Usuario Administrador esta logado no sistema"]
    S_BF_1 [flow: "basic", actor: "Administrador", action: "Entra na tela de Listagem de Terminais"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe uma lista com os Terminais cadastrados"]
    S_BF_3 [flow: "basic", actor: "Administrador", action: "clica em um dos terminais listados", branches_af: [1, 4, 5]]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe tela de edicao de Terminal"]
    S_BF_5 [flow: "basic", actor: "Administrador", action: "altera dados do terminal e clica no botao de 'Atualizar'", branches_af: [2, 3]]
    S_BF_6 [flow: "basic", actor: "system", action: "notifica usuario de que Terminal foi atualizado com sucesso", branches_ef: [1]]
    S_AF1_1 [flow: "alternative_1", description: "Ordena lista de Terminais", actor: "Administrador", action: "ordena lista dos Terminais por alguma coluna", returns_to_bf: 2]
    S_AF2_1 [flow: "alternative_2", description: "Adiciona Beneficio associado a Terminal", actor: "Administrador", action: "preenche os dados do novo beneficio e clica no botao 'Adicionar Benficio'"]
    S_AF2_2 [flow: "alternative_2", description: "Adiciona Beneficio associado a Terminal", actor: "system", action: "incrementa o a lista de beneficio do Terminal"]
    S_AF2_3 [flow: "alternative_2", description: "Adiciona Beneficio associado a Terminal", actor: "Administrador", action: "clica em Atualizar", returns_to_bf: 6]
    S_AF3_1 [flow: "alternative_3", description: "Cancela edicao", actor: "Administrador", action: "clica no botao de 'Cancelar'", returns_to_bf: 2]
    S_AF4_1 [flow: "alternative_4", description: "Navega por paginas de tabela", actor: "Administrador", action: "clica em botao de navegacao de paginas de tabela", returns_to_bf: 2]
    S_AF5_1 [flow: "alternative_5", description: "Filtra lista de Terminais", actor: "Administrador", action: "preenche campos de filtragem", returns_to_bf: 2]
    S_EF1_1 [flow: "exception_1", description: "Usuario nao preenche algum campo obrigatorio", actor: "system", action: "informa que o campo e obrigatorio"]
    S_EF1_2 [flow: "exception_1", description: "Usuario nao preenche algum campo obrigatorio", actor: "Administrador", action: "preenche o campo obrigatorio e clica no botao de 'Atualizar'"]
    S_END [terminal, guard: "O Terminal foi atualizado com sucesso."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe uma lista com os Terminais cadastrados"]
    S_BF_2 -> S_BF_3 [event: "Administrador: clica em um dos terminais listados"]
    S_BF_3 -> S_BF_4 [event: "system: exibe tela de edicao de Terminal"]
    S_BF_3 -> S_AF1_1 [branch: "AF_1 - Ordena lista de Terminais"]
    S_BF_3 -> S_AF4_1 [branch: "AF_4 - Navega por paginas de tabela"]
    S_BF_3 -> S_AF5_1 [branch: "AF_5 - Filtra lista de Terminais"]
    S_BF_4 -> S_BF_5 [event: "Administrador: altera dados do terminal e clica no botao de 'Atualizar'"]
    S_BF_5 -> S_BF_6 [event: "system: notifica usuario de que Terminal foi atualizado com sucesso"]
    S_BF_5 -> S_AF2_1 [branch: "AF_2 - Adiciona Beneficio associado a Terminal"]
    S_BF_5 -> S_AF3_1 [branch: "AF_3 - Cancela edicao"]
    S_BF_6 -> S_END [event: "Complete"]
    S_BF_6 -> S_EF1_1 [branch: "EF_1 - Usuario nao preenche algum campo obrigatorio"]
    S_AF1_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF2_1 -> S_AF2_2 [event: "system: incrementa o a lista de beneficio do Terminal"]
    S_AF2_2 -> S_AF2_3 [event: "Administrador: clica em Atualizar"]
    S_AF2_3 -> S_BF_6 [resume_basic_flow: 6]
    S_AF3_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF4_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF5_1 -> S_BF_2 [resume_basic_flow: 2]
    S_EF1_1 -> S_EF1_2 [event: "Administrador: preenche o campo obrigatorio e clica no botao de 'Atualizar'"]
    S_EF1_2 -> S_END [event: "ErrorExit"]
  }
}
