ALTS_SPECIFICATION "UC5 Hospitals" {
  VERSION: "4.0"
  PRE_CONDITION: "The administrator has authenticated themselves in the iTrust2 Medical Records system (UC2)."
  POST_CONDITION: "System processes request successfully and logs transaction."

  ACTORS {
    admin: "Admin"
  }

  STATES {
    S_INIT [initial, guard: "The administrator has authenticated themselves in the iTrust2 Medical Records system (UC2)."]
    S_BF_1 [flow: "basic", actor: "admin", action: "The administrator enters the following information about the hospital that conforms to the data formats in Section 5.6 and presses the Add Hospital button: Name Address State Zip", branches_af: [1]]
    S_BF_2 [flow: "basic", actor: "system", action: "displays a success message and logs transaction", branches_ef: [1]]
    S_AF1_1 [flow: "alternative_1", description: "Delete hospital", actor: "admin", action: "An Admin selects a hospital from the list of possible hospitals, confirms the delete, and presses the button to delete the hospital.", returns_to_bf: 2]
    S_EF1_1 [flow: "exception_1", description: "Invalid data field format", actor: "system", action: "prompts the Admin to correct the format of a required data field because the input of that data field does not match that specified in Section 5.6."]
    S_END [terminal, guard: "System processes request successfully and logs transaction."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: displays a success message and logs transaction"]
    S_BF_1 -> S_AF1_1 [branch: "AF_1 - Delete hospital"]
    S_BF_2 -> S_END [event: "Complete"]
    S_BF_2 -> S_EF1_1 [branch: "EF_1 - Invalid data field format"]
    S_AF1_1 -> S_BF_2 [resume_basic_flow: 2]
    S_EF1_1 -> S_END [event: "ErrorExit"]
  }
}
