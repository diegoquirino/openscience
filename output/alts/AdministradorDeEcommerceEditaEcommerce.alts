ALTS_SPECIFICATION "Administrador De Ecommerce Edita Ecommerce" {
  VERSION: "1.0"
  PRE_CONDITION: "Usuario Administrador esta logado no sistema. Existe pelo menos um Ecommerce registrado."
  POST_CONDITION: "O Ecommerce foi atualizado com sucesso."

  ACTORS {
    AdminEcommerce: "Usuario Administrador de Ecommerce"
    system: "Bazooca"
  }

  STATES {
    S_INIT [initial, guard: "Usuario Administrador esta logado no sistema. Existe pelo menos um Ecommerce registrado."]
    S_BF_1 [flow: "basic", actor: "AdminEcommerce", action: "abre tela inicial do sistema"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe tela inicial do sistema"]
    S_BF_3 [flow: "basic", actor: "AdminEcommerce", action: "seleciona a opcao 'Meu Ecommerce' no menu da tela principal"]
    S_BF_4 [flow: "basic", actor: "system", action: "abre a tela de edicao do Ecommerce"]
    S_BF_5 [flow: "basic", actor: "AdminEcommerce", action: "preenche os novos dados do Ecommerce e clica no botao 'Atualizar'", branches_af: [1]]
    S_BF_6 [flow: "basic", actor: "system", action: "notifica que o Administrador foi adicionado com sucesso", branches_ef: [1, 2, 3, 4]]
    S_AF1_1 [flow: "alternative_1", description: "Cancela registro de Administrador", actor: "AdminEcommerce", action: "clica no botao Cancelar", returns_to_bf: 2]
    S_EF1_1 [flow: "exception_1", description: "Dados obrigatorios'", actor: "system", action: "informa que os dados obrigatorios devem ser preenchidos"]
    S_EF1_2 [flow: "exception_1", description: "Dados obrigatorios'", actor: "AdminEcommerce", action: "preenche os dados orbigatorios e clica no botao 'Atualizar'"]
    S_EF2_1 [flow: "exception_2", description: "Email invalido", actor: "system", action: "alerta usuario de que Email e invalido"]
    S_EF2_2 [flow: "exception_2", description: "Email invalido", actor: "AdminEcommerce", action: "insere um Email valido e clica no botao 'Atualizar'"]
    S_EF3_1 [flow: "exception_3", description: "Senha e Confirmacao diferentes", actor: "system", action: "alerta usuario de que senhas estao diferentes"]
    S_EF3_2 [flow: "exception_3", description: "Senha e Confirmacao diferentes", actor: "AdminEcommerce", action: "insere Senhas iguais e clica no botao 'Atualizar'"]
    S_EF4_1 [flow: "exception_4", description: "Sem Permissao", actor: "system", action: "alerta usuario que Administrador nao esta com nenhuma Permissao"]
    S_EF4_2 [flow: "exception_4", description: "Sem Permissao", actor: "AdminEcommerce", action: "insere uma permissao e clica no botao 'Atualizar'"]
    S_END [terminal, guard: "O Ecommerce foi atualizado com sucesso."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe tela inicial do sistema"]
    S_BF_2 -> S_BF_3 [event: "AdminEcommerce: seleciona a opcao 'Meu Ecommerce' no menu da tela principal"]
    S_BF_3 -> S_BF_4 [event: "system: abre a tela de edicao do Ecommerce"]
    S_BF_4 -> S_BF_5 [event: "AdminEcommerce: preenche os novos dados do Ecommerce e clica no botao 'Atualizar'"]
    S_BF_5 -> S_BF_6 [event: "system: notifica que o Administrador foi adicionado com sucesso"]
    S_BF_5 -> S_AF1_1 [branch: "AF_1 - Cancela registro de Administrador"]
    S_BF_6 -> S_END [event: "Complete"]
    S_BF_6 -> S_EF1_1 [branch: "EF_1 - Dados obrigatorios'"]
    S_BF_6 -> S_EF2_1 [branch: "EF_2 - Email invalido"]
    S_BF_6 -> S_EF3_1 [branch: "EF_3 - Senha e Confirmacao diferentes"]
    S_BF_6 -> S_EF4_1 [branch: "EF_4 - Sem Permissao"]
    S_AF1_1 -> S_BF_2 [resume_basic_flow: 2]
    S_EF1_1 -> S_EF1_2 [event: "AdminEcommerce: preenche os dados orbigatorios e clica no botao 'Atualizar'"]
    S_EF1_2 -> S_END [event: "ErrorExit"]
    S_EF2_1 -> S_EF2_2 [event: "AdminEcommerce: insere um Email valido e clica no botao 'Atualizar'"]
    S_EF2_2 -> S_END [event: "ErrorExit"]
    S_EF3_1 -> S_EF3_2 [event: "AdminEcommerce: insere Senhas iguais e clica no botao 'Atualizar'"]
    S_EF3_2 -> S_END [event: "ErrorExit"]
    S_EF4_1 -> S_EF4_2 [event: "AdminEcommerce: insere uma permissao e clica no botao 'Atualizar'"]
    S_EF4_2 -> S_END [event: "ErrorExit"]
  }
}
