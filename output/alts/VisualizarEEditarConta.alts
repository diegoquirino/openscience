ALTS_SPECIFICATION "Visualizar e editando propria conta" {
  VERSION: "1.0"
  PRE_CONDITION: "Usuário deve estar logado no sistema ; administrador ou super administrador"
  POST_CONDITION: ""

  ACTORS {
  }

  STATES {
    S_INIT [initial, guard: "Usuário deve estar logado no sistema ; administrador ou super administrador"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe tela onde os campos 'Name', 'Login', 'Type' e 'Language'. Eles estão devidamente preenchidos"]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe página com campos em branco para atualização"]
    S_BF_6 [flow: "basic", actor: "system", action: "exibe página com informações do usuário e apresenta mensagem informando que as informações foram atualizadas"]
    S_AF1_2 [flow: "alternative_1", description: "Troca Idioma", actor: "system", action: "exibe página com informações do usuário. Apresenta mensagem informando que as informações foram atualizadas e atualiza conta no novo idioma"]
    S_AF3_2 [flow: "alternative_3", description: "Password inválido", actor: "system", action: "exibe mensagem infrmando que o Password fornecido não está correto", returns_to_bf: 5]
    S_AF4_2 [flow: "alternative_4", description: "Novo Password fora dos padrões (uppercase, lowercase, numbers, special characters and size between 8 and 20)", actor: "system", action: "exibe mensagem infrmando que o Password fornecido não está conforme o exigido", returns_to_bf: 5]
    S_END [terminal, guard: ""]
  }

  TRANSITIONS {
    S_INIT -> S_BF_2 [trigger: "Start"]
    S_BF_2 -> S_BF_4 [event: "system: exibe página com campos em branco para atualização"]
    S_BF_4 -> S_BF_6 [event: "system: exibe página com informações do usuário e apresenta mensagem informando que as informações foram atualizadas"]
    S_BF_6 -> S_END [event: "Complete"]
    S_AF1_2 -> S_END [event: "Complete"]
    S_AF3_2 -> S_BF_5 [resume_basic_flow: 5]
    S_AF4_2 -> S_BF_5 [resume_basic_flow: 5]
  }
}
