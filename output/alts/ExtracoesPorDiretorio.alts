ALTS_SPECIFICATION "Realizacao Extracoes em modo diretorio e aplicando filtros" {
  VERSION: "1.0"
  PRE_CONDITION: "Usuário deve estar logado no servidor e extrator com administrador ; Não existem extrações cadastradas no banco de dados"
  POST_CONDITION: ""

  ACTORS {
    administrador: "Administrador do sistema"
    clock: "Clock do sistema"
  }

  STATES {
    S_INIT [initial, guard: "Usuário deve estar logado no servidor e extrator com administrador ; Não existem extrações cadastradas no banco de dados"]
    S_BF_1 [flow: "basic", actor: "administrador", action: "pressiona opção “Extract from dicrtory”"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe tela de extração por diretório"]
    S_BF_3 [flow: "basic", actor: "administrador", action: "seleciona pasta “EXTRACT_FILE_IPP320_AKIRA”, que contém 705 extrações para diversas família, e pressiona o botão “Extract”"]
    S_BF_4 [flow: "basic", actor: "system", action: "realiza extrações"]
    S_BF_5 [flow: "basic", actor: "clock", action: "tempo de execução não passou de 5 segundos", branches_af: [8]]
    S_BF_6 [flow: "basic", actor: "system", action: "exibe na parte inferior da tela uma mensagem indicando que 705 extrações foram realizadas"]
    S_BF_7 [flow: "basic", actor: "administrador", action: "acessa página “Extractions”", branches_af: [7]]
    S_BF_8 [flow: "basic", actor: "system", action: "exibe a lista de extrações com as 50 últimas entradas. Entrada 1: 14170PP30289943. Entrada 50: 12328PP30166463"]
    S_BF_9 [flow: "basic", actor: "administrador", action: "seleciona opção para mostrar 100 entradas por página"]
    S_BF_10 [flow: "basic", actor: "system", action: "exibe a lista de extrações com as 100 últimas entradas."]
    S_BF_11 [flow: "basic", actor: "administrador", action: "seleciona o combo box referente ao filtro por “Customer”", branches_af: [3]]
    S_BF_12 [flow: "basic", actor: "system", action: "exibe as opções “Ingenico Brazil” e “Ingenico”"]
    S_BF_13 [flow: "basic", actor: "administrador", action: "seleciona opção “Ingenico” no campo de filtro “Customer”", branches_af: [1, 2]]
    S_BF_14 [flow: "basic", actor: "system", action: "atualiza a página mostrando somente 32 extrações"]
    S_AF8_1 [flow: "alternative_8", description: "Estouro de limite de tempo", actor: "clock", action: "tempo de execução passou de 5 segundos"]
    S_AF8_2 [flow: "alternative_8", description: "Estouro de limite de tempo", actor: "system", action: "exibe mensagem solicitando que o usuário aguarde", returns_to_bf: 7]
    S_AF1_1 [flow: "alternative_1", description: "Filtro default", actor: "administrador", action: "seleciona opção default no campo de filtro “Customer”"]
    S_AF1_2 [flow: "alternative_1", description: "Filtro default", actor: "system", action: "atualiza a página mostrando todas 705 extrações"]
    S_AF2_1 [flow: "alternative_2", description: "Filtro “Ingenico Brazil”", actor: "administrador", action: "seleciona opção Ingenico Brazil no campo de filtro “Customer”"]
    S_AF2_2 [flow: "alternative_2", description: "Filtro “Ingenico Brazil”", actor: "system", action: "atualiza a página mostrando todas 673 extrações"]
    S_AF3_1 [flow: "alternative_3", description: "Filtro state", actor: "administrador", action: "seleciona combo box referente ao filtro por “State”"]
    S_AF3_2 [flow: "alternative_3", description: "Filtro state", actor: "system", action: "exibe opções “Activated”, “Alert Interruption”, “Deactivated”, “Mockup” e “Error”"]
    S_AF3_3 [flow: "alternative_3", description: "Filtro state", actor: "administrador", action: "seleciona opção “Activated” no campo de filtro “State”"]
    S_AF3_4 [flow: "alternative_3", description: "Filtro state", actor: "system", action: "atualiza página mostrando 608 extrações"]
    S_AF4_1 [flow: "alternative_4", description: "Filtro “Alert Interruption”", actor: "administrador", action: "seleciona opção “Alert Interruption” no campo de filtro “State”"]
    S_AF4_2 [flow: "alternative_4", description: "Filtro “Alert Interruption”", actor: "system", action: "atualiza página mostrando 97 extrações"]
    S_AF5_1 [flow: "alternative_5", description: "Filtro “Mockup”", actor: "administrador", action: "seleciona opção “Mockup” no campo de filtro “State”"]
    S_AF5_2 [flow: "alternative_5", description: "Filtro “Mockup”", actor: "system", action: "atualiza página mostrando lista vazia"]
    S_AF6_1 [flow: "alternative_6", description: "Filtro “Error”", actor: "administrador", action: "seleciona opção “Error” no campo de filtro “State”"]
    S_AF6_2 [flow: "alternative_6", description: "Filtro “Error”", actor: "system", action: "atualiza página mostrando lista vazia"]
    S_AF7_1 [flow: "alternative_7", description: "Extrações Sequenciais", actor: "administrador", action: "pressiona opção “Extract from dicrtory”"]
    S_AF7_2 [flow: "alternative_7", description: "Extrações Sequenciais", actor: "system", action: "exibe tela de extração por diretório"]
    S_AF7_3 [flow: "alternative_7", description: "Extrações Sequenciais", actor: "administrador", action: "seleciona pasta “EXTRACT_FILE_IPP320_AKIRA”, que contém 705 extrações para diversas família, e pressiona o botão “Extract”"]
    S_AF7_4 [flow: "alternative_7", description: "Extrações Sequenciais", actor: "system", action: "realiza extrações"]
    S_AF7_5 [flow: "alternative_7", description: "Extrações Sequenciais", actor: "clock", action: "verifica se o tempo de execução não passou de 5 segundos"]
    S_AF7_6 [flow: "alternative_7", description: "Extrações Sequenciais", actor: "system", action: "exibe na parte inferior da tela uma mensagem indicando que 705 extrações foram realizadas"]
    S_AF7_7 [flow: "alternative_7", description: "Extrações Sequenciais", actor: "administrador", action: "acessa página “Extractions”"]
    S_AF7_8 [flow: "alternative_7", description: "Extrações Sequenciais", actor: "system", action: "exibe uma lista com 1510"]
    S_END [terminal, guard: ""]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe tela de extração por diretório"]
    S_BF_2 -> S_BF_3 [event: "administrador: seleciona pasta “EXTRACT_FILE_IPP320_AKIRA”, que contém 705 extrações para diversas família, e pressiona o botão “Extract”"]
    S_BF_3 -> S_BF_4 [event: "system: realiza extrações"]
    S_BF_4 -> S_BF_5 [event: "clock: tempo de execução não passou de 5 segundos"]
    S_BF_5 -> S_BF_6 [event: "system: exibe na parte inferior da tela uma mensagem indicando que 705 extrações foram realizadas"]
    S_BF_5 -> S_AF8_1 [branch: "AF_8 - Estouro de limite de tempo"]
    S_BF_6 -> S_BF_7 [event: "administrador: acessa página “Extractions”"]
    S_BF_7 -> S_BF_8 [event: "system: exibe a lista de extrações com as 50 últimas entradas. Entrada 1: 14170PP30289943. Entrada 50: 12328PP30166463"]
    S_BF_7 -> S_AF7_1 [branch: "AF_7 - Extrações Sequenciais"]
    S_BF_8 -> S_BF_9 [event: "administrador: seleciona opção para mostrar 100 entradas por página"]
    S_BF_9 -> S_BF_10 [event: "system: exibe a lista de extrações com as 100 últimas entradas."]
    S_BF_10 -> S_BF_11 [event: "administrador: seleciona o combo box referente ao filtro por “Customer”"]
    S_BF_11 -> S_BF_12 [event: "system: exibe as opções “Ingenico Brazil” e “Ingenico”"]
    S_BF_11 -> S_AF3_1 [branch: "AF_3 - Filtro state"]
    S_BF_12 -> S_BF_13 [event: "administrador: seleciona opção “Ingenico” no campo de filtro “Customer”"]
    S_BF_13 -> S_BF_14 [event: "system: atualiza a página mostrando somente 32 extrações"]
    S_BF_13 -> S_AF1_1 [branch: "AF_1 - Filtro default"]
    S_BF_13 -> S_AF2_1 [branch: "AF_2 - Filtro “Ingenico Brazil”"]
    S_BF_14 -> S_END [event: "Complete"]
    S_AF8_1 -> S_AF8_2 [event: "system: exibe mensagem solicitando que o usuário aguarde"]
    S_AF8_2 -> S_BF_7 [resume_basic_flow: 7]
    S_AF1_1 -> S_AF1_2 [event: "system: atualiza a página mostrando todas 705 extrações"]
    S_AF1_2 -> S_END [event: "Complete"]
    S_AF2_1 -> S_AF2_2 [event: "system: atualiza a página mostrando todas 673 extrações"]
    S_AF2_2 -> S_END [event: "Complete"]
    S_AF3_1 -> S_AF3_2 [event: "system: exibe opções “Activated”, “Alert Interruption”, “Deactivated”, “Mockup” e “Error”"]
    S_AF3_2 -> S_AF3_3 [event: "administrador: seleciona opção “Activated” no campo de filtro “State”"]
    S_AF3_3 -> S_AF3_4 [event: "system: atualiza página mostrando 608 extrações"]
    S_AF3_4 -> S_END [event: "Complete"]
    S_AF4_1 -> S_AF4_2 [event: "system: atualiza página mostrando 97 extrações"]
    S_AF4_2 -> S_END [event: "Complete"]
    S_AF5_1 -> S_AF5_2 [event: "system: atualiza página mostrando lista vazia"]
    S_AF5_2 -> S_END [event: "Complete"]
    S_AF6_1 -> S_AF6_2 [event: "system: atualiza página mostrando lista vazia"]
    S_AF6_2 -> S_END [event: "Complete"]
    S_AF7_1 -> S_AF7_2 [event: "system: exibe tela de extração por diretório"]
    S_AF7_2 -> S_AF7_3 [event: "administrador: seleciona pasta “EXTRACT_FILE_IPP320_AKIRA”, que contém 705 extrações para diversas família, e pressiona o botão “Extract”"]
    S_AF7_3 -> S_AF7_4 [event: "system: realiza extrações"]
    S_AF7_4 -> S_AF7_5 [event: "clock: verifica se o tempo de execução não passou de 5 segundos"]
    S_AF7_5 -> S_AF7_6 [event: "system: exibe na parte inferior da tela uma mensagem indicando que 705 extrações foram realizadas"]
    S_AF7_6 -> S_AF7_7 [event: "administrador: acessa página “Extractions”"]
    S_AF7_7 -> S_AF7_8 [event: "system: exibe uma lista com 1510"]
    S_AF7_8 -> S_END [event: "Complete"]
  }
}
