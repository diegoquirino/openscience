ALTS_SPECIFICATION "Administrador Registra Ocorrencia Em Nota De Coleta" {
  VERSION: "1.0"
  PRE_CONDITION: "Usuario Administrador esta logado no sistema."
  POST_CONDITION: "A ocorrencia esta registrada e nota esta com status de ocorrencia registrada"

  ACTORS {
    Administrador: "Usuario Administrador"
    system: "Bazooca"
  }

  STATES {
    S_INIT [initial, guard: "Usuario Administrador esta logado no sistema."]
    S_BF_1 [flow: "basic", actor: "Administrador", action: "clica na opcao 'Central de Operacoes' no menu da tela principal", branches_af: [11]]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe Dashboard do sistema"]
    S_BF_3 [flow: "basic", actor: "Administrador", action: "clica em contador 'Geradas' na secao de 'Coletas'", branches_af: [1, 2, 3, 4]]
    S_BF_4 [flow: "basic", actor: "system", action: "abre uma tela com as listas das 'Coletas'"]
    S_BF_5 [flow: "basic", actor: "Administrador", action: "seleciona alguma Coleta da lista", branches_af: [5, 6, 7, 10]]
    S_BF_6 [flow: "basic", actor: "system", action: "exibe os dados da Coleta"]
    S_BF_7 [flow: "basic", actor: "Administrador", action: "clica no botao de 'Registrar Ocorrencia' associado a qualquer item da nota", branches_af: [9]]
    S_BF_8 [flow: "basic", actor: "system", action: "abre modal para digitacao da ocorrencia"]
    S_BF_9 [flow: "basic", actor: "Administrador", action: "digita ocorrencia e clica em 'Confirmar'", branches_af: [8]]
    S_BF_10 [flow: "basic", actor: "system", action: "notifica que Ocorrencia foi registrada com sucesso"]
    S_AF1_1 [flow: "alternative_1", description: "Seleciona contador de 'Aguardando Picking'", actor: "Administrador", action: "clica em algum contador de 'Aguardando Picking' na secao de 'Coletas'", returns_to_bf: 4]
    S_AF2_1 [flow: "alternative_2", description: "Seleciona contador de 'Aceitas'", actor: "Administrador", action: "clica em algum contador de 'Aceitas' na secao de 'Coletas'", returns_to_bf: 4]
    S_AF3_1 [flow: "alternative_3", description: "Seleciona contador de 'Recusadas'", actor: "Administrador", action: "clica em algum contador de 'Recusadas' na secao de 'Coletas'", returns_to_bf: 4]
    S_AF4_1 [flow: "alternative_4", description: "Seleciona contador de 'A Caminho'", actor: "Administrador", action: "clica em algum contador de 'A Caminho' na secao de 'Coletas'", returns_to_bf: 4]
    S_AF5_1 [flow: "alternative_5", description: "Navega pelas paginas da lista", actor: "Administrador", action: "seleciona outra pagina", returns_to_bf: 4]
    S_AF6_1 [flow: "alternative_6", description: "Clica no botao 'Voltar'", actor: "Administrador", action: "clica no botao 'Voltar'", returns_to_bf: 2]
    S_AF7_1 [flow: "alternative_7", description: "Ordena Coletas", actor: "Administrador", action: "ordena as Coletas por alguma coluna", returns_to_bf: 4]
    S_AF8_1 [flow: "alternative_8", description: "Cancela registro de ocorrencia", actor: "Administrador", action: "clica em botao 'Cancelar'", returns_to_bf: 6]
    S_AF9_1 [flow: "alternative_9", description: "Volta para lista de Coletas", actor: "Administrador", action: "clica no botao 'Voltar'", returns_to_bf: 4]
    S_AF10_1 [flow: "alternative_10", description: "Filtra coletas da lista", actor: "Administrador", action: "filtra as coletas por algum campo", returns_to_bf: 4]
    S_END [terminal, guard: "A ocorrencia esta registrada e nota esta com status de ocorrencia registrada"]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe Dashboard do sistema"]
    S_BF_2 -> S_BF_3 [event: "Administrador: clica em contador 'Geradas' na secao de 'Coletas'"]
    S_BF_3 -> S_BF_4 [event: "system: abre uma tela com as listas das 'Coletas'"]
    S_BF_3 -> S_AF1_1 [branch: "AF_1 - Seleciona contador de 'Aguardando Picking'"]
    S_BF_3 -> S_AF2_1 [branch: "AF_2 - Seleciona contador de 'Aceitas'"]
    S_BF_3 -> S_AF3_1 [branch: "AF_3 - Seleciona contador de 'Recusadas'"]
    S_BF_3 -> S_AF4_1 [branch: "AF_4 - Seleciona contador de 'A Caminho'"]
    S_BF_4 -> S_BF_5 [event: "Administrador: seleciona alguma Coleta da lista"]
    S_BF_5 -> S_BF_6 [event: "system: exibe os dados da Coleta"]
    S_BF_5 -> S_AF5_1 [branch: "AF_5 - Navega pelas paginas da lista"]
    S_BF_5 -> S_AF6_1 [branch: "AF_6 - Clica no botao 'Voltar'"]
    S_BF_5 -> S_AF7_1 [branch: "AF_7 - Ordena Coletas"]
    S_BF_5 -> S_AF10_1 [branch: "AF_10 - Filtra coletas da lista"]
    S_BF_6 -> S_BF_7 [event: "Administrador: clica no botao de 'Registrar Ocorrencia' associado a qualquer item da nota"]
    S_BF_7 -> S_BF_8 [event: "system: abre modal para digitacao da ocorrencia"]
    S_BF_7 -> S_AF9_1 [branch: "AF_9 - Volta para lista de Coletas"]
    S_BF_8 -> S_BF_9 [event: "Administrador: digita ocorrencia e clica em 'Confirmar'"]
    S_BF_9 -> S_BF_10 [event: "system: notifica que Ocorrencia foi registrada com sucesso"]
    S_BF_9 -> S_AF8_1 [branch: "AF_8 - Cancela registro de ocorrencia"]
    S_BF_10 -> S_END [event: "Complete"]
    S_AF1_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF2_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF3_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF4_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF5_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF6_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF7_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF8_1 -> S_BF_6 [resume_basic_flow: 6]
    S_AF9_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF10_1 -> S_BF_4 [resume_basic_flow: 4]
  }
}
