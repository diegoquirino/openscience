ALTS_SPECIFICATION "Operador De Terminal Adiciona Operador De Terminal" {
  VERSION: "1.0"
  PRE_CONDITION: "O Operador logado; Operador pertence ao Terminal alvo."
  POST_CONDITION: "Operador de Terminal com dados atualizados no sistema."

  ACTORS {
    Operador: "Operador do Terminal"
    system: "Bazooca"
  }

  STATES {
    S_INIT [initial, guard: "O Operador logado; Operador pertence ao Terminal alvo."]
    S_BF_1 [flow: "basic", actor: "Operador", action: "abre tela inicial do sistema"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe tela inicial do sistema"]
    S_BF_3 [flow: "basic", actor: "Operador", action: "seleciona a opção 'Meu Terminal' no menu da tela principal"]
    S_BF_4 [flow: "basic", actor: "system", action: "mostra a tela de Detalhes do Terminal"]
    S_BF_5 [flow: "basic", actor: "Operador", action: "clica eno botao 'Adicionar Operador'", branches_af: [2]]
    S_BF_6 [flow: "basic", actor: "system", action: "exibe form de adicao de dados de Operador"]
    S_BF_7 [flow: "basic", actor: "Operador", action: "clica no botao de 'Adicionar' do form de adicao de operador", branches_af: [1]]
    S_BF_8 [flow: "basic", actor: "system", action: "notifica que o operador de Terminal foi inserido com sucesso", branches_ef: [1, 2]]
    S_AF1_1 [flow: "alternative_1", description: "cancela insercao de Operador de Terminal", actor: "Operador", action: "clica em botao 'Cancelar' de form de dados de Operador", returns_to_bf: 4]
    S_AF2_1 [flow: "alternative_2", description: "volta para tela inicial do sistema", actor: "Operador", action: "clica no botao 'Voltar'", returns_to_bf: 2]
    S_EF1_1 [flow: "exception_1", description: "insere algum dado invalido", actor: "system", action: "alerta que determinado dado esta invalido"]
    S_EF2_1 [flow: "exception_2", description: "Nao insere algum dado obrigatorio'", actor: "system", action: "informa que os dados obrigatorios devem ser preenchidos"]
    S_END [terminal, guard: "Operador de Terminal com dados atualizados no sistema."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe tela inicial do sistema"]
    S_BF_2 -> S_BF_3 [event: "Operador: seleciona a opção 'Meu Terminal' no menu da tela principal"]
    S_BF_3 -> S_BF_4 [event: "system: mostra a tela de Detalhes do Terminal"]
    S_BF_4 -> S_BF_5 [event: "Operador: clica eno botao 'Adicionar Operador'"]
    S_BF_5 -> S_BF_6 [event: "system: exibe form de adicao de dados de Operador"]
    S_BF_5 -> S_AF2_1 [branch: "AF_2 - volta para tela inicial do sistema"]
    S_BF_6 -> S_BF_7 [event: "Operador: clica no botao de 'Adicionar' do form de adicao de operador"]
    S_BF_7 -> S_BF_8 [event: "system: notifica que o operador de Terminal foi inserido com sucesso"]
    S_BF_7 -> S_AF1_1 [branch: "AF_1 - cancela insercao de Operador de Terminal"]
    S_BF_8 -> S_END [event: "Complete"]
    S_BF_8 -> S_EF1_1 [branch: "EF_1 - insere algum dado invalido"]
    S_BF_8 -> S_EF2_1 [branch: "EF_2 - Nao insere algum dado obrigatorio'"]
    S_AF1_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF2_1 -> S_BF_2 [resume_basic_flow: 2]
    S_EF1_1 -> S_END [event: "ErrorExit"]
    S_EF2_1 -> S_END [event: "ErrorExit"]
  }
}
