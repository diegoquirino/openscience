ALTS_SPECIFICATION "CRUD Documents" {
  VERSION: "1.0"
  PRE_CONDITION: "Deve existir pelo menos um Documento cadastrado"
  POST_CONDITION: ""

  ACTORS {
  }

  STATES {
    S_INIT [initial, guard: "Deve existir pelo menos um Documento cadastrado"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe tela principal"]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe lista completa de documentos"]
    S_BF_6 [flow: "basic", actor: "system", action: "exibe página com campos de cadastro de novo documento"]
    S_BF_8 [flow: "basic", actor: "system", action: "exibe lista de documentos"]
    S_BF_10 [flow: "basic", actor: "system", action: "abre janela de visualização do pdf"]
    S_BF_12 [flow: "basic", actor: "system", action: "retorna a lista de documentos"]
    S_BF_14 [flow: "basic", actor: "system", action: "exibe dados do documento"]
    S_BF_16 [flow: "basic", actor: "system", action: "retorna a lista de documentos"]
    S_BF_18 [flow: "basic", actor: "system", action: "se existir extração da familia cadastrada, esta deve exibir no campo Document um link para o novo documento"]
    S_AF1_2 [flow: "alternative_1", description: "Faltando arquivo", actor: "system", action: "exibe mensagem informando que os dados não correspondem a formatação esperada ou está faltando informações", returns_to_bf: 7]
    S_AF6_2 [flow: "alternative_6", description: "Documento com nome repetido", actor: "system", action: "exibe mensagem informando que os já existe um documento cadastrado com o nome especificado", returns_to_bf: 7]
    S_AF7_2 [flow: "alternative_7", description: "Upload de arquivo não pdf", actor: "system", action: "exibe mensagem informando que o documento especificado não é um arquivo PDF", returns_to_bf: 7]
    S_AF3_2 [flow: "alternative_3", description: "Edita dados", actor: "system", action: "exibe campos do documento com valores atuais que podem ser editados"]
    S_AF4_2 [flow: "alternative_4", description: "Deleta documento", actor: "system", action: "exibe mensagem solicitando confirmação"]
    S_AF5_2 [flow: "alternative_5", description: "Visualização para Operador, Gerente", actor: "system", action: "exibe tela principal"]
    S_AF5_4 [flow: "alternative_5", description: "Visualização para Operador, Gerente", actor: "system", action: "exibe lista de documentos pertencentes ao mesmo laboratório do usuário"]
    S_AF5_6 [flow: "alternative_5", description: "Visualização para Operador, Gerente", actor: "system", action: "abre janela de visualização do pdf"]
    S_AF5_8 [flow: "alternative_5", description: "Visualização para Operador, Gerente", actor: "system", action: "retorna a lista de documentos"]
    S_AF5_10 [flow: "alternative_5", description: "Visualização para Operador, Gerente", actor: "system", action: "exibe dados do documento"]
    S_AF5_12 [flow: "alternative_5", description: "Visualização para Operador, Gerente", actor: "system", action: "retorna a lista de documentos"]
    S_END [terminal, guard: ""]
  }

  TRANSITIONS {
    S_INIT -> S_BF_2 [trigger: "Start"]
    S_BF_2 -> S_BF_4 [event: "system: exibe lista completa de documentos"]
    S_BF_4 -> S_BF_6 [event: "system: exibe página com campos de cadastro de novo documento"]
    S_BF_6 -> S_BF_8 [event: "system: exibe lista de documentos"]
    S_BF_8 -> S_BF_10 [event: "system: abre janela de visualização do pdf"]
    S_BF_10 -> S_BF_12 [event: "system: retorna a lista de documentos"]
    S_BF_12 -> S_BF_14 [event: "system: exibe dados do documento"]
    S_BF_14 -> S_BF_16 [event: "system: retorna a lista de documentos"]
    S_BF_16 -> S_BF_18 [event: "system: se existir extração da familia cadastrada, esta deve exibir no campo Document um link para o novo documento"]
    S_BF_18 -> S_END [event: "Complete"]
    S_AF1_2 -> S_BF_7 [resume_basic_flow: 7]
    S_AF6_2 -> S_BF_7 [resume_basic_flow: 7]
    S_AF7_2 -> S_BF_7 [resume_basic_flow: 7]
    S_AF3_2 -> S_END [event: "Complete"]
    S_AF4_2 -> S_END [event: "Complete"]
    S_AF5_2 -> S_AF5_4 [event: "system: exibe lista de documentos pertencentes ao mesmo laboratório do usuário"]
    S_AF5_4 -> S_AF5_6 [event: "system: abre janela de visualização do pdf"]
    S_AF5_6 -> S_AF5_8 [event: "system: retorna a lista de documentos"]
    S_AF5_8 -> S_AF5_10 [event: "system: exibe dados do documento"]
    S_AF5_10 -> S_AF5_12 [event: "system: retorna a lista de documentos"]
    S_AF5_12 -> S_END [event: "Complete"]
  }
}
