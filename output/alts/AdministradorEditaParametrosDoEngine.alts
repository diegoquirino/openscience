ALTS_SPECIFICATION "Administrador Edita Parametros do Engine" {
  VERSION: "1.0"
  PRE_CONDITION: "Administrador logado."
  POST_CONDITION: "Os Parametros do Engine devem estar atualizados."

  ACTORS {
    Administrador: "Usuario Administrador"
    system: "Bazooca"
  }

  STATES {
    S_INIT [initial, guard: "Administrador logado."]
    S_BF_1 [flow: "basic", actor: "Administrador", action: "Entra na tela de Edição de Parametros do Engine"]
    S_BF_2 [flow: "basic", actor: "system", action: "apresenta uma tela com os Parâmetros do Engine com os valores atuais"]
    S_BF_3 [flow: "basic", actor: "Administrador", action: "escolhe dia de Parametros do Engine"]
    S_BF_4 [flow: "basic", actor: "system", action: "insere automaticamente Horario de Inicio, Horario de Termino, Periodicidade e Raio atuais"]
    S_BF_5 [flow: "basic", actor: "Administrador", action: "modifica valores de paremetros e clica em Atualizar"]
    S_BF_6 [flow: "basic", actor: "system", action: "notifica usuario que os Parâmetros foram atualizados com sucesso", branches_ef: [1, 2]]
    S_EF1_1 [flow: "exception_1", description: "Não insere algum dado obrigatorio'", actor: "system", action: "informa que os dados obrigatorios devem ser preenchidos"]
    S_EF1_2 [flow: "exception_1", description: "Não insere algum dado obrigatorio'", actor: "Administrador", action: "preenche dados obrigatorios e clica em Atualizar"]
    S_EF2_1 [flow: "exception_2", description: "Usuario insere algum dado invalido", actor: "system", action: "alerta que dado e invalido"]
    S_EF2_2 [flow: "exception_2", description: "Usuario insere algum dado invalido", actor: "Administrador", action: "preenche dados obrigatorios e clica em Atualizar"]
    S_END [terminal, guard: "Os Parametros do Engine devem estar atualizados."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: apresenta uma tela com os Parâmetros do Engine com os valores atuais"]
    S_BF_2 -> S_BF_3 [event: "Administrador: escolhe dia de Parametros do Engine"]
    S_BF_3 -> S_BF_4 [event: "system: insere automaticamente Horario de Inicio, Horario de Termino, Periodicidade e Raio atuais"]
    S_BF_4 -> S_BF_5 [event: "Administrador: modifica valores de paremetros e clica em Atualizar"]
    S_BF_5 -> S_BF_6 [event: "system: notifica usuario que os Parâmetros foram atualizados com sucesso"]
    S_BF_6 -> S_END [event: "Complete"]
    S_BF_6 -> S_EF1_1 [branch: "EF_1 - Não insere algum dado obrigatorio'"]
    S_BF_6 -> S_EF2_1 [branch: "EF_2 - Usuario insere algum dado invalido"]
    S_EF1_1 -> S_EF1_2 [event: "Administrador: preenche dados obrigatorios e clica em Atualizar"]
    S_EF1_2 -> S_END [event: "ErrorExit"]
    S_EF2_1 -> S_EF2_2 [event: "Administrador: preenche dados obrigatorios e clica em Atualizar"]
    S_EF2_2 -> S_END [event: "ErrorExit"]
  }
}
