ALTS_SPECIFICATION "UC25 Blood Sugar Tracking" {
  VERSION: "7.0"
  PRE_CONDITION: "The iTrust2 user has authenticated themselves in iTrust2 (UC2) as a patient or HCP."
  POST_CONDITION: "System processes request successfully and logs transaction."

  ACTORS {
    patient: "Patient"
  }

  STATES {
    S_INIT [initial, guard: "The iTrust2 user has authenticated themselves in iTrust2 (UC2) as a patient or HCP."]
    S_BF_1 [flow: "basic", actor: "patient", action: "A patient can add daily blood sugar entries , upload a CSV containing blood sugar data , or view their blood sugar data . An HCP can search for and view the blood sugar data for any patient , as well as update that patient's upper blood sugar limits ."]
    S_BF_2 [flow: "basic", actor: "system", action: "displays a success message and logs transaction", branches_ef: [1, 2, 3, 4, 5]]
    S_EF1_1 [flow: "exception_1", description: "If any invalid information is provided", actor: "system", action: "prompts that If any invalid information is provided, the entry is not saved, and the user is shown what is incorrect."]
    S_EF2_1 [flow: "exception_2", description: "If the csv is not formatted", actor: "system", action: "prompts that If the CSV is not formatted correctly, the data is not saved, and the user is notified."]
    S_EF3_1 [flow: "exception_3", description: "If there are no entries for", actor: "system", action: "prompts that If there are no entries for a date, nothing is displayed for that date."]
    S_EF4_1 [flow: "exception_4", description: "If there are no matching patients", actor: "system", action: "prompts that If there are no matching patients, a message is displayed."]
    S_EF5_1 [flow: "exception_5", description: "If a limit is entered invalidly", actor: "system", action: "prompts that If a limit is entered invalidly, a message is displayed and the user cannot update the limits."]
    S_END [terminal, guard: "System processes request successfully and logs transaction."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: displays a success message and logs transaction"]
    S_BF_2 -> S_END [event: "Complete"]
    S_BF_2 -> S_EF1_1 [branch: "EF_1 - If any invalid information is provided"]
    S_BF_2 -> S_EF2_1 [branch: "EF_2 - If the csv is not formatted"]
    S_BF_2 -> S_EF3_1 [branch: "EF_3 - If there are no entries for"]
    S_BF_2 -> S_EF4_1 [branch: "EF_4 - If there are no matching patients"]
    S_BF_2 -> S_EF5_1 [branch: "EF_5 - If a limit is entered invalidly"]
    S_EF1_1 -> S_END [event: "ErrorExit"]
    S_EF2_1 -> S_END [event: "ErrorExit"]
    S_EF3_1 -> S_END [event: "ErrorExit"]
    S_EF4_1 -> S_END [event: "ErrorExit"]
    S_EF5_1 -> S_END [event: "ErrorExit"]
  }
}
