ALTS_SPECIFICATION "Combinando extracoes com diferente perfis" {
  VERSION: "1.0"
  PRE_CONDITION: "Usuário deve estar logado no servidor e extrator como administrador ; Deve existir um usuário cadastrado com perfil de operador"
  POST_CONDITION: ""

  ACTORS {
    administrador: "Administrador do sistema"
  }

  STATES {
    S_INIT [initial, guard: "Usuário deve estar logado no servidor e extrator como administrador ; Deve existir um usuário cadastrado com perfil de operador"]
    S_BF_1 [flow: "basic", actor: "administrador", action: "pressiona opção “Extract from dicrtory”"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe tela de extração por diretório"]
    S_BF_3 [flow: "basic", actor: "administrador", action: "seleciona pasta “Ext1”, que contém um único conjunto de arquivos para a família “IPP320-01T1220A”, e pressiona o botão “Extract”"]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe na parte inferior da tela uma mensagem indicando que uma extração foi realizada"]
    S_BF_5 [flow: "basic", actor: "administrador", action: "acessa página “Extractions”"]
    S_BF_6 [flow: "basic", actor: "system", action: "exibe a lista de extrações com somente um elemento"]
    S_BF_7 [flow: "basic", actor: "administrador", action: "faz logout"]
    S_BF_8 [flow: "basic", actor: "system", action: "exibe página de login"]
    S_BF_9 [flow: "basic", actor: "administrador", action: "faz login como operador e vai para a página “Extractions”"]
    S_BF_10 [flow: "basic", actor: "system", action: "exibe uma lista vazia"]
    S_BF_11 [flow: "basic", actor: "administrador", action: "pressiona opção “Extract from dicrtory”"]
    S_BF_12 [flow: "basic", actor: "system", action: "exibe tela de extração por diretório"]
    S_BF_13 [flow: "basic", actor: "administrador", action: "seleciona pasta “Ext1”, que contém um único conjunto de arquivos para a família “IPP320-01T1220A”, e pressiona o botão “Extract”"]
    S_BF_14 [flow: "basic", actor: "system", action: "exibe na parte inferior da tela uma mensagem indicando que uma extração foi realizada"]
    S_BF_15 [flow: "basic", actor: "administrador", action: "acessa página “Extractions”"]
    S_BF_16 [flow: "basic", actor: "system", action: "exibe a lista de extrações com somente um elemento"]
    S_BF_17 [flow: "basic", actor: "administrador", action: "faz logout"]
    S_BF_18 [flow: "basic", actor: "system", action: "exibe página de login"]
    S_BF_19 [flow: "basic", actor: "administrador", action: "faz login como administrador e vai para a página “Extractions”"]
    S_BF_10 [flow: "basic", actor: "system", action: "exibe uma lista com duas entradas"]
    S_END [terminal, guard: ""]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe tela de extração por diretório"]
    S_BF_2 -> S_BF_3 [event: "administrador: seleciona pasta “Ext1”, que contém um único conjunto de arquivos para a família “IPP320-01T1220A”, e pressiona o botão “Extract”"]
    S_BF_3 -> S_BF_4 [event: "system: exibe na parte inferior da tela uma mensagem indicando que uma extração foi realizada"]
    S_BF_4 -> S_BF_5 [event: "administrador: acessa página “Extractions”"]
    S_BF_5 -> S_BF_6 [event: "system: exibe a lista de extrações com somente um elemento"]
    S_BF_6 -> S_BF_7 [event: "administrador: faz logout"]
    S_BF_7 -> S_BF_8 [event: "system: exibe página de login"]
    S_BF_8 -> S_BF_9 [event: "administrador: faz login como operador e vai para a página “Extractions”"]
    S_BF_9 -> S_BF_10 [event: "system: exibe uma lista vazia"]
    S_BF_10 -> S_BF_11 [event: "administrador: pressiona opção “Extract from dicrtory”"]
    S_BF_11 -> S_BF_12 [event: "system: exibe tela de extração por diretório"]
    S_BF_12 -> S_BF_13 [event: "administrador: seleciona pasta “Ext1”, que contém um único conjunto de arquivos para a família “IPP320-01T1220A”, e pressiona o botão “Extract”"]
    S_BF_13 -> S_BF_14 [event: "system: exibe na parte inferior da tela uma mensagem indicando que uma extração foi realizada"]
    S_BF_14 -> S_BF_15 [event: "administrador: acessa página “Extractions”"]
    S_BF_15 -> S_BF_16 [event: "system: exibe a lista de extrações com somente um elemento"]
    S_BF_16 -> S_BF_17 [event: "administrador: faz logout"]
    S_BF_17 -> S_BF_18 [event: "system: exibe página de login"]
    S_BF_18 -> S_BF_19 [event: "administrador: faz login como administrador e vai para a página “Extractions”"]
    S_BF_19 -> S_BF_10 [event: "system: exibe uma lista com duas entradas"]
    S_BF_10 -> S_END [event: "Complete"]
  }
}
