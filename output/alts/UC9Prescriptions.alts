ALTS_SPECIFICATION "UC9 Prescriptions" {
  VERSION: "6.0"
  PRE_CONDITION: "An HCP, a patient, and an administrator are all registered in the iTrust2 system. An iTrust2 user is logged into the system. The HCP must have begun documenting an office visit."
  POST_CONDITION: "System processes request successfully and logs transaction."

  ACTORS {
    admin: "Admin"
    hcp: "Health Care Provider (HCP)"
    patient: "Patient"
  }

  STATES {
    S_INIT [initial, guard: "An HCP, a patient, and an administrator are all registered in the iTrust2 system. An iTrust2 user is logged into the system. The HCP must have begun documenting an office visit."]
    S_BF_1 [flow: "basic", actor: "hcp", action: "The HCP selects the name of the prescription from a list. There is no option to enter names not tracked by the system.", branches_af: [1, 2, 3, 4, 5, 6, 7]]
    S_BF_2 [flow: "basic", actor: "system", action: "displays a success message and logs transaction", branches_ef: [1, 2]]
    S_AF1_1 [flow: "alternative_1", description: "Enter prescription dosage", actor: "hcp", action: "The HCP enters the prescription dosage in milligrams.", returns_to_bf: 2]
    S_AF2_1 [flow: "alternative_2", description: "Enter start date", actor: "hcp", action: "The HCP enters the start date for the prescription.", returns_to_bf: 2]
    S_AF3_1 [flow: "alternative_3", description: "Enter end date", actor: "hcp", action: "The HCP enters the end date for the prescription.", returns_to_bf: 2]
    S_AF4_1 [flow: "alternative_4", description: "Enter number", actor: "hcp", action: "The HCP enters the number of renewals that can be made during the prescription period.", returns_to_bf: 2]
    S_AF5_1 [flow: "alternative_5", description: "Views a table containing current", actor: "patient", action: "The patient views a table containing current and past prescriptions.", returns_to_bf: 2]
    S_AF6_1 [flow: "alternative_6", description: "Add new drug", actor: "admin", action: "The administrator selects an option to add a new drug. The administrator enters a NDC, a name, and a description.", returns_to_bf: 2]
    S_AF7_1 [flow: "alternative_7", description: "Edit existing drug", actor: "admin", action: "The administrator selects an existing drug to edit. The administrator modifies the existing information and presses submit.", returns_to_bf: 2]
    S_EF1_1 [flow: "exception_1", description: "Invalid data entered", actor: "system", action: "prompts that An error message is displayed if the HCP or administrator enters invalid data."]
    S_EF2_1 [flow: "exception_2", description: "No records or data available", actor: "system", action: "prompts that If the patient has no current or past prescriptions, the system displays a error message."]
    S_END [terminal, guard: "System processes request successfully and logs transaction."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: displays a success message and logs transaction"]
    S_BF_1 -> S_AF1_1 [branch: "AF_1 - Enter prescription dosage"]
    S_BF_1 -> S_AF2_1 [branch: "AF_2 - Enter start date"]
    S_BF_1 -> S_AF3_1 [branch: "AF_3 - Enter end date"]
    S_BF_1 -> S_AF4_1 [branch: "AF_4 - Enter number"]
    S_BF_1 -> S_AF5_1 [branch: "AF_5 - Views a table containing current"]
    S_BF_1 -> S_AF6_1 [branch: "AF_6 - Add new drug"]
    S_BF_1 -> S_AF7_1 [branch: "AF_7 - Edit existing drug"]
    S_BF_2 -> S_END [event: "Complete"]
    S_BF_2 -> S_EF1_1 [branch: "EF_1 - Invalid data entered"]
    S_BF_2 -> S_EF2_1 [branch: "EF_2 - No records or data available"]
    S_AF1_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF2_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF3_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF4_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF5_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF6_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF7_1 -> S_BF_2 [resume_basic_flow: 2]
    S_EF1_1 -> S_END [event: "ErrorExit"]
    S_EF2_1 -> S_END [event: "ErrorExit"]
  }
}
