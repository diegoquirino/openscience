ALTS_SPECIFICATION "Administrador Edita Administrador" {
  VERSION: "1.0"
  PRE_CONDITION: "Usuario Administrador esta logado no sistema."
  POST_CONDITION: "O Administrador foi adicionado com sucesso."

  ACTORS {
    Administrador: "Usuario Administrador"
    system: "Bazooca"
  }

  STATES {
    S_INIT [initial, guard: "Usuario Administrador esta logado no sistema."]
    S_BF_1 [flow: "basic", actor: "Administrador", action: "abre tela inicial do sistema"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe tela inicial do sistema"]
    S_BF_3 [flow: "basic", actor: "Administrador", action: "clica na opcao 'Administrador' no menu da tela principal"]
    S_BF_4 [flow: "basic", actor: "system", action: "apresenta uma listagem dos Administradores cadastrados no sistema"]
    S_BF_5 [flow: "basic", actor: "Administrador", action: "clica no botao 'Adicionar Administrador'", branches_af: [1, 3, 4, 5]]
    S_BF_6 [flow: "basic", actor: "system", action: "abre a tela de cadastro de Administradores"]
    S_BF_7 [flow: "basic", actor: "Administrador", action: "preenche os dados do Administrador, seleciona suas permissoes e clica no botao 'Registrar'", branches_af: [2]]
    S_BF_8 [flow: "basic", actor: "system", action: "notifica que o Administrador foi adicionado com sucesso", branches_ef: [1, 2, 3, 4]]
    S_AF1_1 [flow: "alternative_1", description: "Volta para tela inicial de sistema", actor: "Administrador", action: "clica no botao Voltar", returns_to_bf: 2]
    S_AF2_1 [flow: "alternative_2", description: "Cancela registro de Administrador", actor: "Administrador", action: "clica no botao Cancelar", returns_to_bf: 4]
    S_AF3_1 [flow: "alternative_3", description: "Navega em lista de Administradores", actor: "Administrador", action: "clica no botao de paginacao", returns_to_bf: 4]
    S_AF4_1 [flow: "alternative_4", description: "Filtra lista de Administradores", actor: "Administrador", action: "filtra lista de Administradores por algum campo", returns_to_bf: 4]
    S_AF5_1 [flow: "alternative_5", description: "Ordena lista de Administradores", actor: "Administrador", action: "ordena lista de Administradores por algum campo", returns_to_bf: 4]
    S_EF1_1 [flow: "exception_1", description: "Dados obrigatorios'", actor: "system", action: "informa que os dados obrigatorios devem ser preenchidos"]
    S_EF1_2 [flow: "exception_1", description: "Dados obrigatorios'", actor: "Administrador", action: "preenche os dados orbigatorios e clica no botao 'Registrar'"]
    S_EF2_1 [flow: "exception_2", description: "Email invalido", actor: "system", action: "alerta usuario de que Email e invalido"]
    S_EF2_2 [flow: "exception_2", description: "Email invalido", actor: "Administrador", action: "insere um Email valido e clica no botao 'Registrar'"]
    S_EF3_1 [flow: "exception_3", description: "Senha e Confirmacao diferentes", actor: "system", action: "alerta usuario de que senhas estao diferentes"]
    S_EF3_2 [flow: "exception_3", description: "Senha e Confirmacao diferentes", actor: "Administrador", action: "insere Senhas iguais e clica no botao 'Registrar'"]
    S_EF4_1 [flow: "exception_4", description: "Sem Permissao", actor: "system", action: "alerta usuario que Administrador nao esta com nenhuma Permissao"]
    S_EF4_2 [flow: "exception_4", description: "Sem Permissao", actor: "Administrador", action: "insere uma permissao e clica no botao 'Registrar'"]
    S_END [terminal, guard: "O Administrador foi adicionado com sucesso."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe tela inicial do sistema"]
    S_BF_2 -> S_BF_3 [event: "Administrador: clica na opcao 'Administrador' no menu da tela principal"]
    S_BF_3 -> S_BF_4 [event: "system: apresenta uma listagem dos Administradores cadastrados no sistema"]
    S_BF_4 -> S_BF_5 [event: "Administrador: clica no botao 'Adicionar Administrador'"]
    S_BF_5 -> S_BF_6 [event: "system: abre a tela de cadastro de Administradores"]
    S_BF_5 -> S_AF1_1 [branch: "AF_1 - Volta para tela inicial de sistema"]
    S_BF_5 -> S_AF3_1 [branch: "AF_3 - Navega em lista de Administradores"]
    S_BF_5 -> S_AF4_1 [branch: "AF_4 - Filtra lista de Administradores"]
    S_BF_5 -> S_AF5_1 [branch: "AF_5 - Ordena lista de Administradores"]
    S_BF_6 -> S_BF_7 [event: "Administrador: preenche os dados do Administrador, seleciona suas permissoes e clica no botao 'Registrar'"]
    S_BF_7 -> S_BF_8 [event: "system: notifica que o Administrador foi adicionado com sucesso"]
    S_BF_7 -> S_AF2_1 [branch: "AF_2 - Cancela registro de Administrador"]
    S_BF_8 -> S_END [event: "Complete"]
    S_BF_8 -> S_EF1_1 [branch: "EF_1 - Dados obrigatorios'"]
    S_BF_8 -> S_EF2_1 [branch: "EF_2 - Email invalido"]
    S_BF_8 -> S_EF3_1 [branch: "EF_3 - Senha e Confirmacao diferentes"]
    S_BF_8 -> S_EF4_1 [branch: "EF_4 - Sem Permissao"]
    S_AF1_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF2_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF3_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF4_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF5_1 -> S_BF_4 [resume_basic_flow: 4]
    S_EF1_1 -> S_EF1_2 [event: "Administrador: preenche os dados orbigatorios e clica no botao 'Registrar'"]
    S_EF1_2 -> S_END [event: "ErrorExit"]
    S_EF2_1 -> S_EF2_2 [event: "Administrador: insere um Email valido e clica no botao 'Registrar'"]
    S_EF2_2 -> S_END [event: "ErrorExit"]
    S_EF3_1 -> S_EF3_2 [event: "Administrador: insere Senhas iguais e clica no botao 'Registrar'"]
    S_EF3_2 -> S_END [event: "ErrorExit"]
    S_EF4_1 -> S_EF4_2 [event: "Administrador: insere uma permissao e clica no botao 'Registrar'"]
    S_EF4_2 -> S_END [event: "ErrorExit"]
  }
}
