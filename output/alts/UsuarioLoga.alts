ALTS_SPECIFICATION "Login De Usuario" {
  VERSION: "1.0"
  PRE_CONDITION: "Acesso ao Browser; Acesso a internet."
  POST_CONDITION: "Usuario logado no sistema."

  ACTORS {
    bazoocaUser: "Bazooca User"
    system: "Bazooca"
  }

  STATES {
    S_INIT [initial, guard: "Acesso ao Browser; Acesso a internet."]
    S_BF_1 [flow: "basic", actor: "bazoocaUser", action: "Entra na tela de login"]
    S_BF_2 [flow: "basic", actor: "system", action: "apresenta um form com os campos username e password e um botão de submissão"]
    S_BF_3 [flow: "basic", actor: "bazoocaUser", action: "preenche os campos de username e password e clica no botão de submissão", branches_af: [1]]
    S_BF_4 [flow: "basic", actor: "system", action: "mostra uma mensagem de usuário logado com sucesso", branches_ef: [1, 2]]
    S_AF1_1 [flow: "alternative_1", description: "Um ou mais username são apresentados", actor: "bazoocaUser", action: "seleciona um dos usernames sugeridos, digita um password e clica no botão de submeter", returns_to_bf: 4]
    S_EF1_1 [flow: "exception_1", description: "Usuário não existe no banco de dados", actor: "system", action: "alerta que usuário não existe"]
    S_EF2_1 [flow: "exception_2", description: "Combinação de username/password incorreta", actor: "system", action: "alerta que username e/ou password estão incorretos"]
    S_END [terminal, guard: "Usuario logado no sistema."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: apresenta um form com os campos username e password e um botão de submissão"]
    S_BF_2 -> S_BF_3 [event: "bazoocaUser: preenche os campos de username e password e clica no botão de submissão"]
    S_BF_3 -> S_BF_4 [event: "system: mostra uma mensagem de usuário logado com sucesso"]
    S_BF_3 -> S_AF1_1 [branch: "AF_1 - Um ou mais username são apresentados"]
    S_BF_4 -> S_END [event: "Complete"]
    S_BF_4 -> S_EF1_1 [branch: "EF_1 - Usuário não existe no banco de dados"]
    S_BF_4 -> S_EF2_1 [branch: "EF_2 - Combinação de username/password incorreta"]
    S_AF1_1 -> S_BF_4 [resume_basic_flow: 4]
    S_EF1_1 -> S_END [event: "ErrorExit"]
    S_EF2_1 -> S_END [event: "ErrorExit"]
  }
}
