ALTS_SPECIFICATION "Operador De Terminal Edita Beneficio De Terminal" {
  VERSION: "1.0"
  PRE_CONDITION: "O Operador logado; Operador pertence ao Terminal alvo. Terminal alvo tem pelo menos um Beneficio registrado."
  POST_CONDITION: "Beneficio de Terminal com dados atualizados no sistema."

  ACTORS {
    OpTerminal: "Operador do Terminal"
    system: "Bazooca"
  }

  STATES {
    S_INIT [initial, guard: "O Operador logado; Operador pertence ao Terminal alvo. Terminal alvo tem pelo menos um Beneficio registrado."]
    S_BF_1 [flow: "basic", actor: "OpTerminal", action: "abre tela inicial do sistema"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe tela inicial do sistema"]
    S_BF_3 [flow: "basic", actor: "OpTerminal", action: "seleciona a opção 'Meu Terminal' no menu da tela principal"]
    S_BF_4 [flow: "basic", actor: "system", action: "mostra a tela de Detalhes do Terminal"]
    S_BF_5 [flow: "basic", actor: "OpTerminal", action: "seleciona Beneficio a ser editado"]
    S_BF_6 [flow: "basic", actor: "system", action: "exibe form de edicao de dados de Beneficio"]
    S_BF_7 [flow: "basic", actor: "OpTerminal", action: "modifica os dados existentes e clica no botao de 'Salvar' do form de Beneficio", branches_af: [1]]
    S_BF_8 [flow: "basic", actor: "system", action: "notifica que o Beneficio de Terminal foi atualizado com sucesso", branches_ef: [1, 2]]
    S_AF1_1 [flow: "alternative_1", description: "cancela atualizacao de dados de Beneficio de Terminal", actor: "OpTerminal", action: "clica em botao 'Cancelar' de form de dados de Beneficio", returns_to_bf: 4]
    S_EF1_1 [flow: "exception_1", description: "insere algum dado invalido", actor: "system", action: "alerta que determinado dado esta invalido"]
    S_EF2_1 [flow: "exception_2", description: "Nao insere algum dado obrigatorio'", actor: "system", action: "informa que os dados obrigatorios devem ser preenchidos"]
    S_END [terminal, guard: "Beneficio de Terminal com dados atualizados no sistema."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe tela inicial do sistema"]
    S_BF_2 -> S_BF_3 [event: "OpTerminal: seleciona a opção 'Meu Terminal' no menu da tela principal"]
    S_BF_3 -> S_BF_4 [event: "system: mostra a tela de Detalhes do Terminal"]
    S_BF_4 -> S_BF_5 [event: "OpTerminal: seleciona Beneficio a ser editado"]
    S_BF_5 -> S_BF_6 [event: "system: exibe form de edicao de dados de Beneficio"]
    S_BF_6 -> S_BF_7 [event: "OpTerminal: modifica os dados existentes e clica no botao de 'Salvar' do form de Beneficio"]
    S_BF_7 -> S_BF_8 [event: "system: notifica que o Beneficio de Terminal foi atualizado com sucesso"]
    S_BF_7 -> S_AF1_1 [branch: "AF_1 - cancela atualizacao de dados de Beneficio de Terminal"]
    S_BF_8 -> S_END [event: "Complete"]
    S_BF_8 -> S_EF1_1 [branch: "EF_1 - insere algum dado invalido"]
    S_BF_8 -> S_EF2_1 [branch: "EF_2 - Nao insere algum dado obrigatorio'"]
    S_AF1_1 -> S_BF_4 [resume_basic_flow: 4]
    S_EF1_1 -> S_END [event: "ErrorExit"]
    S_EF2_1 -> S_END [event: "ErrorExit"]
  }
}
