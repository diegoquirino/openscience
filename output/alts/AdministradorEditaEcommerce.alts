ALTS_SPECIFICATION "Administrador Edita Ecommerce" {
  VERSION: "1.0"
  PRE_CONDITION: "Administrador logado; Algum E-commerce salvo no sistema."
  POST_CONDITION: "Ecommerce esta com dados atualizados no sistema."

  ACTORS {
    Administrador: "Usuario Administrador"
    system: "Bazooca"
  }

  STATES {
    S_INIT [initial, guard: "Administrador logado; Algum E-commerce salvo no sistema."]
    S_BF_1 [flow: "basic", actor: "Administrador", action: "seleciona a opcao 'E-commerce' no menu da tela principal"]
    S_BF_2 [flow: "basic", actor: "system", action: "mostra a tela de detalhes do ecommerce"]
    S_BF_3 [flow: "basic", actor: "Administrador", action: "seleciona um E-commerce na lista", branches_af: [1, 2, 3, 4]]
    S_BF_4 [flow: "basic", actor: "system", action: "abre a tela de edicao do Ecommerce"]
    S_BF_3 [flow: "basic", actor: "Administrador", action: "modifica os dados existentes"]
    S_BF_4 [flow: "basic", actor: "system", action: "valida os dados cadastrais do ecommerce"]
    S_BF_5 [flow: "basic", actor: "Administrador", action: "clica no botao de atualizar", branches_af: [5]]
    S_BF_6 [flow: "basic", actor: "system", action: "notifica usuario de que o Ecommerce foi atualizado com sucesso", branches_ef: [1, 2]]
    S_AF1_1 [flow: "alternative_1", description: "Ordena lista de Ecommerce", actor: "Administrador", action: "clica em um dos botões de ordenacao associada a uma coluna da tabela", returns_to_bf: 2]
    S_AF2_1 [flow: "alternative_2", description: "Navega por paginas de tabela", actor: "Administrador", action: "clica em botao de navegacao de paginas de tabela", returns_to_bf: 2]
    S_AF3_1 [flow: "alternative_3", description: "Filtra lista de Ecommerce", actor: "Administrador", action: "preenche campos de filtragem", returns_to_bf: 2]
    S_AF4_1 [flow: "alternative_4", description: "Cancela atualizacao de Ecommerce", actor: "Administrador", action: "clica no botao Cancelar", returns_to_bf: 2]
    S_AF5_1 [flow: "alternative_5", description: "Volta para tela inicial de sistema", actor: "Administrador", action: "clica no botao Voltar", returns_to_bf: 2]
    S_EF1_1 [flow: "exception_1", description: "Nao insere algum dado obrigatório'", actor: "system", action: "informa que os dados obrigatórios devem ser preenchidos"]
    S_EF1_2 [flow: "exception_1", description: "Nao insere algum dado obrigatório'", actor: "Administrador", action: "adiciona dados corretos e clica em 'Atualizar"]
    S_EF2_1 [flow: "exception_2", description: "Usuario insere algum dado invalido", actor: "system", action: "alerta que o dado esta invalido e pede nova entrada"]
    S_EF2_2 [flow: "exception_2", description: "Usuario insere algum dado invalido", actor: "Administrador", action: "corrige os dados invalidos e clica em 'Atualizar"]
    S_END [terminal, guard: "Ecommerce esta com dados atualizados no sistema."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: mostra a tela de detalhes do ecommerce"]
    S_BF_2 -> S_BF_3 [event: "Administrador: seleciona um E-commerce na lista"]
    S_BF_3 -> S_BF_4 [event: "system: abre a tela de edicao do Ecommerce"]
    S_BF_3 -> S_AF1_1 [branch: "AF_1 - Ordena lista de Ecommerce"]
    S_BF_3 -> S_AF2_1 [branch: "AF_2 - Navega por paginas de tabela"]
    S_BF_3 -> S_AF3_1 [branch: "AF_3 - Filtra lista de Ecommerce"]
    S_BF_3 -> S_AF4_1 [branch: "AF_4 - Cancela atualizacao de Ecommerce"]
    S_BF_4 -> S_BF_3 [event: "Administrador: modifica os dados existentes"]
    S_BF_3 -> S_BF_4 [event: "system: valida os dados cadastrais do ecommerce"]
    S_BF_4 -> S_BF_5 [event: "Administrador: clica no botao de atualizar"]
    S_BF_5 -> S_BF_6 [event: "system: notifica usuario de que o Ecommerce foi atualizado com sucesso"]
    S_BF_5 -> S_AF5_1 [branch: "AF_5 - Volta para tela inicial de sistema"]
    S_BF_6 -> S_END [event: "Complete"]
    S_BF_6 -> S_EF1_1 [branch: "EF_1 - Nao insere algum dado obrigatório'"]
    S_BF_6 -> S_EF2_1 [branch: "EF_2 - Usuario insere algum dado invalido"]
    S_AF1_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF2_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF3_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF4_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF5_1 -> S_BF_2 [resume_basic_flow: 2]
    S_EF1_1 -> S_EF1_2 [event: "Administrador: adiciona dados corretos e clica em 'Atualizar"]
    S_EF1_2 -> S_END [event: "ErrorExit"]
    S_EF2_1 -> S_EF2_2 [event: "Administrador: corrige os dados invalidos e clica em 'Atualizar"]
    S_EF2_2 -> S_END [event: "ErrorExit"]
  }
}
