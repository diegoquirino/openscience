ALTS_SPECIFICATION "Administrador Deleta Compatibilidade" {
  VERSION: "1.0"
  PRE_CONDITION: "Usuario Administrador deve estar logado no sistema."
  POST_CONDITION: "Compatibilidade foi deletada."

  ACTORS {
    Administrador: "Usuario Administrador"
    system: "Bazooca"
  }

  STATES {
    S_INIT [initial, guard: "Usuario Administrador deve estar logado no sistema."]
    S_BF_1 [flow: "basic", actor: "Administrador", action: "Clicar na opcao 'Compatibildiade' no menu da tela principal"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe a tela de listagem das Compatibilidades"]
    S_BF_3 [flow: "basic", actor: "Administrador", action: "clica em Compatibilidade listada", branches_af: [1, 2]]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe a tela de edicao de Compatibilidade"]
    S_BF_5 [flow: "basic", actor: "Administrador", action: "clica em botao 'Deletar'"]
    S_BF_6 [flow: "basic", actor: "system", action: "abre popup de confirmacao de delecao"]
    S_BF_7 [flow: "basic", actor: "Administrador", action: "confirma que deseja deletar clicando em 'Sim'", branches_af: [3]]
    S_BF_8 [flow: "basic", actor: "system", action: "notifica usuario que os nova Compatibilidade foi deletada com sucesso"]
    S_AF1_1 [flow: "alternative_1", description: "Navega pelas paginas da lista", actor: "Administrador", action: "navega nas paginas da lista", returns_to_bf: 2]
    S_AF2_1 [flow: "alternative_2", description: "Usuario ordena lista de Compatibilidades", actor: "Administrador", action: "ordenas as Compatibilidades por seus atributos", returns_to_bf: 2]
    S_AF3_1 [flow: "alternative_3", description: "Cancela delecao", actor: "Administrador", action: "clica no botao 'Cancelar' de popup", returns_to_bf: 4]
    S_END [terminal, guard: "Compatibilidade foi deletada."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe a tela de listagem das Compatibilidades"]
    S_BF_2 -> S_BF_3 [event: "Administrador: clica em Compatibilidade listada"]
    S_BF_3 -> S_BF_4 [event: "system: exibe a tela de edicao de Compatibilidade"]
    S_BF_3 -> S_AF1_1 [branch: "AF_1 - Navega pelas paginas da lista"]
    S_BF_3 -> S_AF2_1 [branch: "AF_2 - Usuario ordena lista de Compatibilidades"]
    S_BF_4 -> S_BF_5 [event: "Administrador: clica em botao 'Deletar'"]
    S_BF_5 -> S_BF_6 [event: "system: abre popup de confirmacao de delecao"]
    S_BF_6 -> S_BF_7 [event: "Administrador: confirma que deseja deletar clicando em 'Sim'"]
    S_BF_7 -> S_BF_8 [event: "system: notifica usuario que os nova Compatibilidade foi deletada com sucesso"]
    S_BF_7 -> S_AF3_1 [branch: "AF_3 - Cancela delecao"]
    S_BF_8 -> S_END [event: "Complete"]
    S_AF1_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF2_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF3_1 -> S_BF_4 [resume_basic_flow: 4]
  }
}
