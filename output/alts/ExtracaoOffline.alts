ALTS_SPECIFICATION "Extracao Offline" {
  VERSION: "1.0"
  PRE_CONDITION: " "
  POST_CONDITION: "extracoes foram realizadas (tempo de cada extracao deve ser o momento que esta foi feita em modo offline)"

  ACTORS {
    operador: "operador do sistema"
  }

  STATES {
    S_INIT [initial, guard: " "]
    S_BF_1 [flow: "basic", actor: "operador", action: "inicia o SAFF Extractor e se autentica"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe pagina que requisita dados do terminal"]
    S_BF_1 [flow: "basic", actor: "operador", action: "abre extrator"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe tela de login"]
    S_BF_3 [flow: "basic", actor: "operador", action: "loga no extrator", branches_af: [1]]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe tela inicial 'SAFF extraction'", branches_ef: [1, 2]]
    S_AF1_1 [flow: "alternative_1", description: "Offline sempre", actor: "operador", action: "define que o sistema sempre fara extracoes offline"]
    S_AF1_2 [flow: "alternative_1", description: "Offline sempre", actor: "system", action: "exibe pagina que requisita dados do terminal"]
    S_AF1_3 [flow: "alternative_1", description: "Offline sempre", actor: "operador", action: "realiza uma serie de extracoes"]
    S_AF1_4 [flow: "alternative_1", description: "Offline sempre", actor: "system", action: "salva as extracoes na pasta local 'OfflineExtraction'"]
    S_EF1_1 [flow: "exception_1", description: "Sem conexao e usuario deseja entrar em modo offline", actor: "system", action: "exibe mensagem solicitando confirmacao se usuario quer entrar em modo offline"]
    S_EF1_2 [flow: "exception_1", description: "Sem conexao e usuario deseja entrar em modo offline", actor: "operador", action: "confirma que quer entrar em modo offline"]
    S_EF1_3 [flow: "exception_1", description: "Sem conexao e usuario deseja entrar em modo offline", actor: "system", action: "exibe pagina que requisita dados do terminal"]
    S_EF1_4 [flow: "exception_1", description: "Sem conexao e usuario deseja entrar em modo offline", actor: "operador", action: "realiza uma serie de extracoes sequenciais"]
    S_EF1_5 [flow: "exception_1", description: "Sem conexao e usuario deseja entrar em modo offline", actor: "system", action: "salva as extracoes na pasta local 'OfflineExtraction'"]
    S_EF1_6 [flow: "exception_1", description: "Sem conexao e usuario deseja entrar em modo offline", actor: "operador", action: "reastabelece conexao"]
    S_EF1_7 [flow: "exception_1", description: "Sem conexao e usuario deseja entrar em modo offline", actor: "system", action: "envia extracoes locais para o servidor e as apaga da pasta local 'OfflineExtraction'"]
    S_EF1_8 [flow: "exception_1", description: "Sem conexao e usuario deseja entrar em modo offline", actor: "operador", action: "loga no servidor e vai ate a pagina de extracoes"]
    S_EF1_9 [flow: "exception_1", description: "Sem conexao e usuario deseja entrar em modo offline", actor: "system", action: "exibe lista com extracoes realizadas no modo offline"]
    S_EF2_1 [flow: "exception_2", description: "Sem conexao e usuario nao deseja entrar em modo offline", actor: "system", action: "exibe mensagem solicitando confirmação se usuario quer entrar em modo offline"]
    S_EF2_2 [flow: "exception_2", description: "Sem conexao e usuario nao deseja entrar em modo offline", actor: "operador", action: "nao deseja entrar em modo offline"]
    S_EF3_1 [flow: "exception_3", description: "Cai conexao novamente", actor: "system", action: "mantem informacao das extracoes nao enviadas a tempo na pasta local"]
    S_EF3_2 [flow: "exception_3", description: "Cai conexao novamente", actor: "operador", action: "reastabelece conexao"]
    S_EF3_3 [flow: "exception_3", description: "Cai conexao novamente", actor: "system", action: "envia extracoes restantes da pasta local para o servidor e as apaga da pasta 'OfflineExtraction'"]
    S_EF3_4 [flow: "exception_3", description: "Cai conexao novamente", actor: "operador", action: "loga no servidor e vai ate a pagina de extracoes"]
    S_EF3_5 [flow: "exception_3", description: "Cai conexao novamente", actor: "system", action: "exibe lista que contem as extracoes realizadas no modo offline"]
    S_END [terminal, guard: "extracoes foram realizadas (tempo de cada extracao deve ser o momento que esta foi feita em modo offline)"]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe pagina que requisita dados do terminal"]
    S_BF_2 -> S_BF_1 [event: "operador: abre extrator"]
    S_BF_1 -> S_BF_2 [event: "system: exibe tela de login"]
    S_BF_2 -> S_BF_3 [event: "operador: loga no extrator"]
    S_BF_3 -> S_BF_4 [event: "system: exibe tela inicial 'SAFF extraction'"]
    S_BF_3 -> S_AF1_1 [branch: "AF_1 - Offline sempre"]
    S_BF_4 -> S_END [event: "Complete"]
    S_BF_4 -> S_EF1_1 [branch: "EF_1 - Sem conexao e usuario deseja entrar em modo offline"]
    S_BF_4 -> S_EF2_1 [branch: "EF_2 - Sem conexao e usuario nao deseja entrar em modo offline"]
    S_AF1_1 -> S_AF1_2 [event: "system: exibe pagina que requisita dados do terminal"]
    S_AF1_2 -> S_AF1_3 [event: "operador: realiza uma serie de extracoes"]
    S_AF1_3 -> S_AF1_4 [event: "system: salva as extracoes na pasta local 'OfflineExtraction'"]
    S_AF1_4 -> S_END [event: "Complete"]
    S_EF1_1 -> S_EF1_2 [event: "operador: confirma que quer entrar em modo offline"]
    S_EF1_2 -> S_EF1_3 [event: "system: exibe pagina que requisita dados do terminal"]
    S_EF1_3 -> S_EF1_4 [event: "operador: realiza uma serie de extracoes sequenciais"]
    S_EF1_4 -> S_EF1_5 [event: "system: salva as extracoes na pasta local 'OfflineExtraction'"]
    S_EF1_5 -> S_EF1_6 [event: "operador: reastabelece conexao"]
    S_EF1_6 -> S_EF1_7 [event: "system: envia extracoes locais para o servidor e as apaga da pasta local 'OfflineExtraction'"]
    S_EF1_7 -> S_EF1_8 [event: "operador: loga no servidor e vai ate a pagina de extracoes"]
    S_EF1_8 -> S_EF1_9 [event: "system: exibe lista com extracoes realizadas no modo offline"]
    S_EF1_9 -> S_END [event: "ErrorExit"]
    S_EF2_1 -> S_EF2_2 [event: "operador: nao deseja entrar em modo offline"]
    S_EF2_2 -> S_END [event: "ErrorExit"]
    S_EF3_1 -> S_EF3_2 [event: "operador: reastabelece conexao"]
    S_EF3_2 -> S_EF3_3 [event: "system: envia extracoes restantes da pasta local para o servidor e as apaga da pasta 'OfflineExtraction'"]
    S_EF3_3 -> S_EF3_4 [event: "operador: loga no servidor e vai ate a pagina de extracoes"]
    S_EF3_4 -> S_EF3_5 [event: "system: exibe lista que contem as extracoes realizadas no modo offline"]
    S_EF3_5 -> S_END [event: "ErrorExit"]
  }
}
