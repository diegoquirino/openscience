ALTS_SPECIFICATION "Extracao Offline" {
  VERSION: "1.0"
  PRE_CONDITION: "Usuário não está logado no servidor"
  POST_CONDITION: ""

  ACTORS {
    administrador: "Administrador do sistema"
  }

  STATES {
    S_INIT [initial, guard: "Usuário não está logado no servidor"]
    S_BF_1 [flow: "basic", actor: "administrador", action: "loga no extrator"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe exibe mensagem perguntando se o usuário deseja entrar em modo offline"]
    S_BF_3 [flow: "basic", actor: "administrador", action: "pressiona botão Yes", branches_af: [1]]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe tela inicial 'SAFF extraction'"]
    S_BF_5 [flow: "basic", actor: "administrador", action: "insere um 'Product number', 'Serial number', tipo de teste 'Pre_test' e pressiona 'Extract'", branches_af: [2, 3, 4, 5]]
    S_BF_6 [flow: "basic", actor: "system", action: "adiciona nova extração a pasta local'"]
    S_BF_7 [flow: "basic", actor: "administrador", action: "loga no servidor"]
    S_BF_8 [flow: "basic", actor: "system", action: "envia extrações da pasta local para o servidor e as deleta da máquina local", branches_ef: [2]]
    S_BF_9 [flow: "basic", actor: "administrador", action: "vai até a página de extrações"]
    S_BF_10 [flow: "basic", actor: "system", action: "exibe lista com a extração realizada no modo offline no topo"]
    S_AF1_1 [flow: "alternative_1", description: "Pressiona NO", actor: "administrador", action: "pressiona botão No"]
    S_AF1_2 [flow: "alternative_1", description: "Pressiona NO", actor: "system", action: "Fecha janela de mensagem", returns_to_bf: 1]
    S_AF2_1 [flow: "alternative_2", description: "Test 1", actor: "administrador", action: "insere um 'Product number', 'Serial number', tipo de teste 'Test 1' e pressiona 'Extract'", returns_to_bf: 6]
    S_AF3_1 [flow: "alternative_3", description: "Test 2", actor: "administrador", action: "insere um 'Product number', 'Serial number', tipo de teste 'Test 2' e pressiona 'Extract'", returns_to_bf: 6]
    S_AF4_1 [flow: "alternative_4", description: "QA", actor: "administrador", action: "insere um 'Product number', 'Serial number', tipo de teste 'QA' e pressiona 'Extract'", returns_to_bf: 6]
    S_AF5_1 [flow: "alternative_5", description: "Product number ou serial number inválidos", actor: "administrador", action: "insere um 'Product number' ou 'Serial number' inválidos e pressiona 'Extract'"]
    S_AF5_2 [flow: "alternative_5", description: "Product number ou serial number inválidos", actor: "system", action: "exibe mensagem solicitando informando que o product number ou serial number são inválidos", returns_to_bf: 5]
    S_EF2_1 [flow: "exception_2", description: "Cai conexão com servidor", actor: "system", action: "exibe mensagem informando quantas extrações foram transferidas para o servidor com sucesso e deleta da pasta local as extrações enviadas com sucesso"]
    S_END [terminal, guard: ""]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe exibe mensagem perguntando se o usuário deseja entrar em modo offline"]
    S_BF_2 -> S_BF_3 [event: "administrador: pressiona botão Yes"]
    S_BF_3 -> S_BF_4 [event: "system: exibe tela inicial 'SAFF extraction'"]
    S_BF_3 -> S_AF1_1 [branch: "AF_1 - Pressiona NO"]
    S_BF_4 -> S_BF_5 [event: "administrador: insere um 'Product number', 'Serial number', tipo de teste 'Pre_test' e pressiona 'Extract'"]
    S_BF_5 -> S_BF_6 [event: "system: adiciona nova extração a pasta local'"]
    S_BF_5 -> S_AF2_1 [branch: "AF_2 - Test 1"]
    S_BF_5 -> S_AF3_1 [branch: "AF_3 - Test 2"]
    S_BF_5 -> S_AF4_1 [branch: "AF_4 - QA"]
    S_BF_5 -> S_AF5_1 [branch: "AF_5 - Product number ou serial number inválidos"]
    S_BF_6 -> S_BF_7 [event: "administrador: loga no servidor"]
    S_BF_7 -> S_BF_8 [event: "system: envia extrações da pasta local para o servidor e as deleta da máquina local"]
    S_BF_8 -> S_BF_9 [event: "administrador: vai até a página de extrações"]
    S_BF_8 -> S_EF2_1 [branch: "EF_2 - Cai conexão com servidor"]
    S_BF_9 -> S_BF_10 [event: "system: exibe lista com a extração realizada no modo offline no topo"]
    S_BF_10 -> S_END [event: "Complete"]
    S_AF1_1 -> S_AF1_2 [event: "system: Fecha janela de mensagem"]
    S_AF1_2 -> S_BF_1 [resume_basic_flow: 1]
    S_AF2_1 -> S_BF_6 [resume_basic_flow: 6]
    S_AF3_1 -> S_BF_6 [resume_basic_flow: 6]
    S_AF4_1 -> S_BF_6 [resume_basic_flow: 6]
    S_AF5_1 -> S_AF5_2 [event: "system: exibe mensagem solicitando informando que o product number ou serial number são inválidos"]
    S_AF5_2 -> S_BF_5 [resume_basic_flow: 5]
    S_EF2_1 -> S_END [event: "ErrorExit"]
  }
}
