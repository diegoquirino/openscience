ALTS_SPECIFICATION "Extracao Offline" {
  VERSION: "1.0"
  PRE_CONDITION: "Usuário está logado no servidor"
  POST_CONDITION: ""

  ACTORS {
    administrador: "Administrador do sistema"
  }

  STATES {
    S_INIT [initial, guard: "Usuário está logado no servidor"]
    S_BF_1 [flow: "basic", actor: "administrador", action: "loga no extrator", branches_af: [2]]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe tela inicial 'SAFF extraction'", branches_ef: [1]]
    S_AF1_1 [flow: "alternative_1", description: "Pressiona NO", actor: "administrador", action: "Não deseja entrar em modo offline", returns_to_bf: 2]
    S_AF2_1 [flow: "alternative_2", description: "Offline sempre", actor: "administrador", action: "define que o sistema sempre fará extrações offline"]
    S_AF2_2 [flow: "alternative_2", description: "Offline sempre", actor: "system", action: "exibe tela inicial 'SAFF extraction'"]
    S_AF2_3 [flow: "alternative_2", description: "Offline sempre", actor: "administrador", action: "realiza cinco extrações"]
    S_AF2_4 [flow: "alternative_2", description: "Offline sempre", actor: "system", action: "adiciona novas extrações a pasta local'"]
    S_EF1_2 [flow: "exception_1", description: "Cai conexão", actor: "administrador", action: "confirma que quer entrar em modo offline"]
    S_EF1_3 [flow: "exception_1", description: "Cai conexão", actor: "system", action: "exibe tela inicial 'SAFF extraction'"]
    S_EF1_4 [flow: "exception_1", description: "Cai conexão", actor: "administrador", action: "realiza cinco extrações"]
    S_EF1_5 [flow: "exception_1", description: "Cai conexão", actor: "system", action: "adiciona novas extrações a pasta local'"]
    S_EF1_6 [flow: "exception_1", description: "Cai conexão", actor: "administrador", action: "reastabelece conexão"]
    S_EF1_7 [flow: "exception_1", description: "Cai conexão", actor: "system", action: "envia extrações locais para o servidor e as apaga da pasta local"]
    S_EF1_8 [flow: "exception_1", description: "Cai conexão", actor: "administrador", action: "loga no servidor e vai até a página de extrações"]
    S_EF1_9 [flow: "exception_1", description: "Cai conexão", actor: "system", action: "exibe lista com extrações realizada no modo offline no topo"]
    S_END [terminal, guard: ""]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe tela inicial 'SAFF extraction'"]
    S_BF_1 -> S_AF2_1 [branch: "AF_2 - Offline sempre"]
    S_BF_2 -> S_END [event: "Complete"]
    S_BF_2 -> S_EF1_2 [branch: "EF_1 - Cai conexão"]
    S_AF1_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF2_1 -> S_AF2_2 [event: "system: exibe tela inicial 'SAFF extraction'"]
    S_AF2_2 -> S_AF2_3 [event: "administrador: realiza cinco extrações"]
    S_AF2_3 -> S_AF2_4 [event: "system: adiciona novas extrações a pasta local'"]
    S_AF2_4 -> S_END [event: "Complete"]
    S_EF1_2 -> S_EF1_3 [event: "system: exibe tela inicial 'SAFF extraction'"]
    S_EF1_3 -> S_EF1_4 [event: "administrador: realiza cinco extrações"]
    S_EF1_4 -> S_EF1_5 [event: "system: adiciona novas extrações a pasta local'"]
    S_EF1_5 -> S_EF1_6 [event: "administrador: reastabelece conexão"]
    S_EF1_6 -> S_EF1_7 [event: "system: envia extrações locais para o servidor e as apaga da pasta local"]
    S_EF1_7 -> S_EF1_8 [event: "administrador: loga no servidor e vai até a página de extrações"]
    S_EF1_8 -> S_EF1_9 [event: "system: exibe lista com extrações realizada no modo offline no topo"]
    S_EF1_9 -> S_END [event: "ErrorExit"]
  }
}
