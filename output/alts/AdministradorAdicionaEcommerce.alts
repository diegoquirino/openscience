ALTS_SPECIFICATION "Administrador Adiciona Ecommerce" {
  VERSION: "1.0"
  PRE_CONDITION: "Usuario Administrador esta logado no sistema."
  POST_CONDITION: "O novo E-commerce esta salvo no sistema."

  ACTORS {
    Administrador: "Usuario Administrador"
    system: "Bazooca"
  }

  STATES {
    S_INIT [initial, guard: "Usuario Administrador esta logado no sistema."]
    S_BF_1 [flow: "basic", actor: "Administrador", action: "abre tela inicial do sistema"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe tela inicial do sistema"]
    S_BF_3 [flow: "basic", actor: "Administrador", action: "clica no opcao 'Ecommerces' no menu principal"]
    S_BF_4 [flow: "basic", actor: "system", action: "exibe a tela com a lista de E-commerces cadastrados no sistema"]
    S_BF_5 [flow: "basic", actor: "Administrador", action: "clica no botao 'Adicionar E-commerce'", branches_af: [1]]
    S_BF_6 [flow: "basic", actor: "system", action: "exibe tela de cadastro de E-commerce"]
    S_BF_7 [flow: "basic", actor: "Administrador", action: "insere os dados de cadastro do E-commerce e clica no botao 'Cadastrar'", branches_af: [2]]
    S_BF_8 [flow: "basic", actor: "system", action: "mostra uma mensagem de cadastro de E-commerce com sucesso", branches_ef: [1, 2]]
    S_AF1_1 [flow: "alternative_1", description: "Volta para tela inicial do sistema", actor: "Administrador", action: "clica no botao 'Voltar'", returns_to_bf: 2]
    S_AF2_1 [flow: "alternative_2", description: "Cancela registro de Ecommerce", actor: "Administrador", action: "clica no botao 'Cancelar'", returns_to_bf: 4]
    S_EF1_1 [flow: "exception_1", description: "Nao preenche algum campo obrigatorio", actor: "system", action: "alerta ao usuario que os campos obrigatorios devem ser preenchidos"]
    S_EF1_2 [flow: "exception_1", description: "Nao preenche algum campo obrigatorio", actor: "Administrador", action: "informa os campos obrigatorios e clica no botao de 'Cadastrar'"]
    S_EF2_1 [flow: "exception_2", description: "Conflito de CNPJ", actor: "system", action: "alerta que ja existe um E-commerce cadastrado com o CNPJ"]
    S_EF2_2 [flow: "exception_2", description: "Conflito de CNPJ", actor: "Administrador", action: "preenche o CNPJ correto e clica no botão 'Cadastrar'"]
    S_END [terminal, guard: "O novo E-commerce esta salvo no sistema."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe tela inicial do sistema"]
    S_BF_2 -> S_BF_3 [event: "Administrador: clica no opcao 'Ecommerces' no menu principal"]
    S_BF_3 -> S_BF_4 [event: "system: exibe a tela com a lista de E-commerces cadastrados no sistema"]
    S_BF_4 -> S_BF_5 [event: "Administrador: clica no botao 'Adicionar E-commerce'"]
    S_BF_5 -> S_BF_6 [event: "system: exibe tela de cadastro de E-commerce"]
    S_BF_5 -> S_AF1_1 [branch: "AF_1 - Volta para tela inicial do sistema"]
    S_BF_6 -> S_BF_7 [event: "Administrador: insere os dados de cadastro do E-commerce e clica no botao 'Cadastrar'"]
    S_BF_7 -> S_BF_8 [event: "system: mostra uma mensagem de cadastro de E-commerce com sucesso"]
    S_BF_7 -> S_AF2_1 [branch: "AF_2 - Cancela registro de Ecommerce"]
    S_BF_8 -> S_END [event: "Complete"]
    S_BF_8 -> S_EF1_1 [branch: "EF_1 - Nao preenche algum campo obrigatorio"]
    S_BF_8 -> S_EF2_1 [branch: "EF_2 - Conflito de CNPJ"]
    S_AF1_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF2_1 -> S_BF_4 [resume_basic_flow: 4]
    S_EF1_1 -> S_EF1_2 [event: "Administrador: informa os campos obrigatorios e clica no botao de 'Cadastrar'"]
    S_EF1_2 -> S_END [event: "ErrorExit"]
    S_EF2_1 -> S_EF2_2 [event: "Administrador: preenche o CNPJ correto e clica no botão 'Cadastrar'"]
    S_EF2_2 -> S_END [event: "ErrorExit"]
  }
}
