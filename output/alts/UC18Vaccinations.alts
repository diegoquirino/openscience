ALTS_SPECIFICATION "UC18 Vaccinations" {
  VERSION: "7.0"
  PRE_CONDITION: "An HCP, a patient, and an administrator are all registered in the iTrust2 system. An iTrust2 user is logged into the system."
  POST_CONDITION: "A success message is displayed and the action is logged."

  ACTORS {
    admin: "Admin"
    hcp: "Health Care Provider (HCP)"
    patient: "Patient"
  }

  STATES {
    S_INIT [initial, guard: "An HCP, a patient, and an administrator are all registered in the iTrust2 system. An iTrust2 user is logged into the system."]
    S_BF_1 [flow: "basic", actor: "admin", action: "The admin is taken to a page where a list of all vaccines are displayed. The admin clicks the Add Vaccine button.", branches_af: [1, 2, 3, 4, 5, 6]]
    S_BF_2 [flow: "basic", actor: "system", action: "The admin is taken to a page where they can enter the information for the vaccine, including: Name of vaccination Abbreviation CPT Code Comments The admin presses the Submit Vaccine button , and a message is displayed.", branches_ef: [1, 2]]
    S_AF1_1 [flow: "alternative_1", description: "Is taken to a page", actor: "admin", action: "The admin is taken to a page where a list of all vaccine are displayed. The admin selects a vaccine to edit and clicks the Edit Vaccine button. The fields of the vaccine are displayed, and the admin can update a field.", returns_to_bf: 2]
    S_AF2_1 [flow: "alternative_2", description: "Is taken to a page", actor: "admin", action: "The admin is taken to a page where a list of all vaccine are displayed.", returns_to_bf: 2]
    S_AF3_1 [flow: "alternative_3", description: "When documenting an office visit", actor: "hcp", action: "When documenting an office visit, an HCP can select zero or more vaccines from a list of all vaccines to add to the office visit. The vaccination will be added to the office visit in the patient's records.", returns_to_bf: 2]
    S_AF4_1 [flow: "alternative_4", description: "Or hcp selects an office", actor: "patient", action: "The patient or HCP selects an office visit to view. They can see all of the vaccinations that pertain to that office visit. The patient cannot edit the information.", returns_to_bf: 2]
    S_AF5_1 [flow: "alternative_5", description: "Is taken to a page", actor: "patient", action: "The patient is taken to a page where a list of all of their vaccinations are displayed. They can view all of the information pertaining to each vaccination record. The patient cannot edit the information.", returns_to_bf: 2]
    S_AF6_1 [flow: "alternative_6", description: "Can look up a patient", actor: "patient", action: "An HCP can look up a patient by name and view their vaccination record. A list of all of the vaccinations administered to that patient are displayed, and all information pertaining to each vaccination record is displayed.", returns_to_bf: 2]
    S_EF1_1 [flow: "exception_1", description: "Invalid data field format", actor: "system", action: "prompts that An error message is displayed if the entered information does not fit the data formats specified in 18.6. Otherwise, a success message is displayed."]
    S_EF2_1 [flow: "exception_2", description: "Invalid data field format", actor: "system", action: "prompts that An error message is displayed if the entered information does not fit the data formats specified in 18.6. Otherwise, a success message is displayed."]
    S_END [terminal, guard: "A success message is displayed and the action is logged."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: The admin is taken to a page where they can enter the information for the vaccine, including: Name of vaccination Abbreviation CPT Code Comments The admin presses the Submit Vaccine button , and a message is displayed."]
    S_BF_1 -> S_AF1_1 [branch: "AF_1 - Is taken to a page"]
    S_BF_1 -> S_AF2_1 [branch: "AF_2 - Is taken to a page"]
    S_BF_1 -> S_AF3_1 [branch: "AF_3 - When documenting an office visit"]
    S_BF_1 -> S_AF4_1 [branch: "AF_4 - Or hcp selects an office"]
    S_BF_1 -> S_AF5_1 [branch: "AF_5 - Is taken to a page"]
    S_BF_1 -> S_AF6_1 [branch: "AF_6 - Can look up a patient"]
    S_BF_2 -> S_END [event: "Complete"]
    S_BF_2 -> S_EF1_1 [branch: "EF_1 - Invalid data field format"]
    S_BF_2 -> S_EF2_1 [branch: "EF_2 - Invalid data field format"]
    S_AF1_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF2_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF3_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF4_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF5_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF6_1 -> S_BF_2 [resume_basic_flow: 2]
    S_EF1_1 -> S_END [event: "ErrorExit"]
    S_EF2_1 -> S_END [event: "ErrorExit"]
  }
}
