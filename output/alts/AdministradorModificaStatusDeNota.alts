ALTS_SPECIFICATION "Administrador Modifica Status De Nota" {
  VERSION: "1.0"
  PRE_CONDITION: "Usuario Administrador esta logado no sistema."
  POST_CONDITION: "A ocorrencia esta registrada"

  ACTORS {
    Administrador: "Usuario Administrador"
    system: "Bazooca"
  }

  STATES {
    S_INIT [initial, guard: "Usuario Administrador esta logado no sistema."]
    S_BF_1 [flow: "basic", actor: "Administrador", action: "clica na opcao 'Central de Operacoes' no menu da tela principal"]
    S_BF_2 [flow: "basic", actor: "system", action: "exibe Dashboard do sistema"]
    S_BF_3 [flow: "basic", actor: "Administrador", action: "clica em contador 'Outros'", branches_af: [1, 2, 3, 4, 5, 12]]
    S_BF_4 [flow: "basic", actor: "system", action: "abre uma tela com a lista de 'Pedidos' ou 'Notas'"]
    S_BF_5 [flow: "basic", actor: "Administrador", action: "seleciona algum 'Pedido' ou 'Nota' da lista", branches_af: [6, 7, 8, 10]]
    S_BF_6 [flow: "basic", actor: "system", action: "exibe os dados da 'Nota'"]
    S_BF_7 [flow: "basic", actor: "Administrador", action: "clica no botao de 'Alterar Status'", branches_af: [11]]
    S_BF_8 [flow: "basic", actor: "system", action: "abre drop list para selecao de novo Status"]
    S_BF_9 [flow: "basic", actor: "Administrador", action: "seleciona novo Status e clica em 'Alterar'", branches_af: [9]]
    S_BF_10 [flow: "basic", actor: "system", action: "notifica que Status da Nota foi alterado com sucesso"]
    S_AF1_1 [flow: "alternative_1", description: "Seleciona contador de 'Engine'", actor: "Administrador", action: "clica em algum contador de 'Engine' na secao de 'Notas'", returns_to_bf: 4]
    S_AF2_1 [flow: "alternative_2", description: "Seleciona contador de 'Conferencia'", actor: "Administrador", action: "clica em algum contador de 'Aceitas' na secao de 'Notas'", returns_to_bf: 4]
    S_AF3_1 [flow: "alternative_3", description: "Seleciona contador de 'Picking'", actor: "Administrador", action: "clica em algum contador de 'Picking' na secao de 'Notas'", returns_to_bf: 4]
    S_AF4_1 [flow: "alternative_4", description: "Seleciona contador de 'Atrasos'", actor: "Administrador", action: "clica em algum contador de 'Atrasos' na secao de 'Notas'", returns_to_bf: 4]
    S_AF5_1 [flow: "alternative_5", description: "Seleciona contador de 'Retornos'", actor: "Administrador", action: "clica em algum contador de 'Retornos' na secao de 'Notas'", returns_to_bf: 4]
    S_AF6_1 [flow: "alternative_6", description: "Navega pelas paginas da lista", actor: "Administrador", action: "seleciona outra pagina", returns_to_bf: 4]
    S_AF7_1 [flow: "alternative_7", description: "Clica no botao 'Voltar'", actor: "Administrador", action: "clica no botao 'Voltar'", returns_to_bf: 2]
    S_AF8_1 [flow: "alternative_8", description: "Ordena Notas", actor: "Administrador", action: "ordenas as coletas por alguma coluna", returns_to_bf: 4]
    S_AF9_1 [flow: "alternative_9", description: "Cancela alteracao de Status", actor: "Administrador", action: "clica em botao 'Cancelar' de drop list", returns_to_bf: 6]
    S_AF10_1 [flow: "alternative_10", description: "Filtra notas da lista", actor: "Administrador", action: "filtra os notas por algum campo", returns_to_bf: 4]
    S_AF11_1 [flow: "alternative_11", description: "Volta para lista de notas", actor: "Administrador", action: "clica em botão 'Voltar'", returns_to_bf: 4]
    S_AF12_1 [flow: "alternative_12", description: "Seleciona contador de 'Ocorrencias'", actor: "Administrador", action: "clica em algum contador de 'Ocorrencias' na secao de 'Notas'", returns_to_bf: 4]
    S_END [terminal, guard: "A ocorrencia esta registrada"]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: exibe Dashboard do sistema"]
    S_BF_2 -> S_BF_3 [event: "Administrador: clica em contador 'Outros'"]
    S_BF_3 -> S_BF_4 [event: "system: abre uma tela com a lista de 'Pedidos' ou 'Notas'"]
    S_BF_3 -> S_AF1_1 [branch: "AF_1 - Seleciona contador de 'Engine'"]
    S_BF_3 -> S_AF2_1 [branch: "AF_2 - Seleciona contador de 'Conferencia'"]
    S_BF_3 -> S_AF3_1 [branch: "AF_3 - Seleciona contador de 'Picking'"]
    S_BF_3 -> S_AF4_1 [branch: "AF_4 - Seleciona contador de 'Atrasos'"]
    S_BF_3 -> S_AF5_1 [branch: "AF_5 - Seleciona contador de 'Retornos'"]
    S_BF_3 -> S_AF12_1 [branch: "AF_12 - Seleciona contador de 'Ocorrencias'"]
    S_BF_4 -> S_BF_5 [event: "Administrador: seleciona algum 'Pedido' ou 'Nota' da lista"]
    S_BF_5 -> S_BF_6 [event: "system: exibe os dados da 'Nota'"]
    S_BF_5 -> S_AF6_1 [branch: "AF_6 - Navega pelas paginas da lista"]
    S_BF_5 -> S_AF7_1 [branch: "AF_7 - Clica no botao 'Voltar'"]
    S_BF_5 -> S_AF8_1 [branch: "AF_8 - Ordena Notas"]
    S_BF_5 -> S_AF10_1 [branch: "AF_10 - Filtra notas da lista"]
    S_BF_6 -> S_BF_7 [event: "Administrador: clica no botao de 'Alterar Status'"]
    S_BF_7 -> S_BF_8 [event: "system: abre drop list para selecao de novo Status"]
    S_BF_7 -> S_AF11_1 [branch: "AF_11 - Volta para lista de notas"]
    S_BF_8 -> S_BF_9 [event: "Administrador: seleciona novo Status e clica em 'Alterar'"]
    S_BF_9 -> S_BF_10 [event: "system: notifica que Status da Nota foi alterado com sucesso"]
    S_BF_9 -> S_AF9_1 [branch: "AF_9 - Cancela alteracao de Status"]
    S_BF_10 -> S_END [event: "Complete"]
    S_AF1_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF2_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF3_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF4_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF5_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF6_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF7_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF8_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF9_1 -> S_BF_6 [resume_basic_flow: 6]
    S_AF10_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF11_1 -> S_BF_4 [resume_basic_flow: 4]
    S_AF12_1 -> S_BF_4 [resume_basic_flow: 4]
  }
}
