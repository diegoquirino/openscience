ALTS_SPECIFICATION "UC16 Personal Representatives" {
  VERSION: "3.0"
  PRE_CONDITION: "The iTrust2 user has authenticated themselves in iTrust2 (UC2). as a patient Another patient is a registered user of the iTrust2 Medical Records system . The patient has authenticated themselves in the iTrust2 Medical Records system (UC1).. An HCP is a registered user of the iTrust2 Medical Records system (UC1). The HCP has authenticated themselves in the iTrust2 Medical Records system (UC2)."
  POST_CONDITION: "System processes request successfully and logs transaction."

  ACTORS {
    user: "User"
  }

  STATES {
    S_INIT [initial, guard: "The iTrust2 user has authenticated themselves in iTrust2 (UC2). as a patient Another patient is a registered user of the iTrust2 Medical Records system . The patient has authenticated themselves in the iTrust2 Medical Records system (UC1).. An HCP is a registered user of the iTrust2 Medical Records system (UC1). The HCP has authenticated themselves in the iTrust2 Medical Records system (UC2)."]
    S_BF_1 [flow: "basic", actor: "user", action: "Patients have the ability to view the list of people they are a PR for and who they have assigned as a PR . The patient can declare and un-declare other users as personal representatives of themselves , as well as un-declare themselves as a personal representative as someone . HCPs can assign one patient as a PR for another and view their assigned PRs and assignees ."]
    S_BF_2 [flow: "basic", actor: "system", action: "displays a success message and logs transaction", branches_ef: [1]]
    S_EF1_1 [flow: "exception_1", description: "An error message is shown that", actor: "system", action: "prompts that An error message is shown that the user is not found or the action was not completed successfully. User is returned to form to try again"]
    S_END [terminal, guard: "System processes request successfully and logs transaction."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: displays a success message and logs transaction"]
    S_BF_2 -> S_END [event: "Complete"]
    S_BF_2 -> S_EF1_1 [branch: "EF_1 - An error message is shown that"]
    S_EF1_1 -> S_END [event: "ErrorExit"]
  }
}
