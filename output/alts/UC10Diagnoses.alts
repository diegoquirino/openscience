ALTS_SPECIFICATION "UC10 Diagnoses" {
  VERSION: "6.0"
  PRE_CONDITION: "The iTrust2 user has authenticated themselves in iTrust2 . An HCP is a registered user of the iTrust2 Medical Records system . The HCP has authenticated themselves in the iTrust2 Medical Records system . The HCP has started documenting an office visit, including basic health metrics, for the patient [UC7 & UC8]."
  POST_CONDITION: "A success message is displayed and the HCP sees the saved information."

  ACTORS {
    admin: "Admin"
    hcp: "Health Care Provider (HCP)"
    patient: "Patient"
  }

  STATES {
    S_INIT [initial, guard: "The iTrust2 user has authenticated themselves in iTrust2 . An HCP is a registered user of the iTrust2 Medical Records system . The HCP has authenticated themselves in the iTrust2 Medical Records system . The HCP has started documenting an office visit, including basic health metrics, for the patient [UC7 & UC8]."]
    S_BF_1 [flow: "basic", actor: "hcp", action: "The HCP selects the correct diagnosis from the menu of diagnoses options labeled by their ICD-10 codes and descriptions. They enter the following additional information about the diagnosis: the date of the office visit, HCP who diagnosed patient, and any notes. They press the Save Diagnosis button .", branches_af: [1, 2, 3]]
    S_BF_2 [flow: "basic", actor: "system", action: "A message shows if the diagnosis was documented correctly.", branches_ef: [1]]
    S_AF1_1 [flow: "alternative_1", description: "View diagnoses and", actor: "patient", action: "The patient selects to view their diagnoses and data corresponding to the diagnoses. They cannot edit the diagnoses or the data associated with the diagnoses.", returns_to_bf: 2]
    S_AF2_1 [flow: "alternative_2", description: "Add diagnosis", actor: "admin", action: "The administrator enters the ICD-10 code and description of the diagnosis. They press Add Diagnosis .", returns_to_bf: 2]
    S_AF3_1 [flow: "alternative_3", description: "Delete diagnosis", actor: "admin", action: "The administrator selects a diagnosis from the list of possible diagnosis, confirms the delete, and presses Delete Diagnosis to delete the diagnosis.", returns_to_bf: 2]
    S_EF1_1 [flow: "exception_1", description: "Invalid data field format", actor: "system", action: "prompts that An error message is displayed describing what entries do not conform to appropriate data formats as specified in 10.6."]
    S_END [terminal, guard: "A success message is displayed and the HCP sees the saved information."]
  }

  TRANSITIONS {
    S_INIT -> S_BF_1 [trigger: "Start"]
    S_BF_1 -> S_BF_2 [event: "system: A message shows if the diagnosis was documented correctly."]
    S_BF_1 -> S_AF1_1 [branch: "AF_1 - View diagnoses and"]
    S_BF_1 -> S_AF2_1 [branch: "AF_2 - Add diagnosis"]
    S_BF_1 -> S_AF3_1 [branch: "AF_3 - Delete diagnosis"]
    S_BF_2 -> S_END [event: "Complete"]
    S_BF_2 -> S_EF1_1 [branch: "EF_1 - Invalid data field format"]
    S_AF1_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF2_1 -> S_BF_2 [resume_basic_flow: 2]
    S_AF3_1 -> S_BF_2 [resume_basic_flow: 2]
    S_EF1_1 -> S_END [event: "ErrorExit"]
  }
}
