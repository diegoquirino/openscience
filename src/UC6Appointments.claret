systemName "iTrust2"
usecase "UC6 Appointments" {
  version "1.0" type "Creation" user "Admin" date "30/10/2026"
  actor hcp "Health Care Provider (HCP)"
  actor patient "Patient"
  preCondition "The iTrust2 user has authenticated themselves in iTrust2 UC2."
  basic {
    step 1 patient "The patient enters information about the appointment request and presses the Submit Request button . HCP Date Time Comments Type" af[1, 2, 3]
    step 2 system "A message confirms the request." ef[1]
  }
  alternative 1 "Views their appointment request" {
    step 1 patient "The patient views their appointment request. The patient can select a request and delete the request." bs 2
  }
  alternative 2 "Views appointment requests" {
    step 1 hcp "The HCP views appointment requests. The HCP can select to approve or decline the requestion. The appointment will no longer be visible in the patient's appointment request view." bs 2
  }
  alternative 3 "View upcoming appointments" {
    step 1 hcp "The HCP view upcoming appointments." bs 2
  }
  exception 1 "Invalid data field format" {
    step 1 system "prompts the patient or HCP to correct the format of a required data field because the input of that data field does not match that specified in Section 6.6."
  }
  postCondition "System processes request successfully and logs transaction."
}
