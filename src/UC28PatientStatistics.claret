systemName "iTrust2"
usecase "UC28 Patient Statistics" {
  version "7.0" type "Creation" user "Admin" date "30/10/2026"
  actor hcp "Health Care Provider (HCP)"
  preCondition "- A Virologist has authenticated themselves within iTrust2. UC2"
  basic {
    step 1 hcp "A Virologist, a type HCP, uploads a list of passenger data . The Virologist can select between various plot or graph options representing the dataset . An error message will be displayed if a list of passenger data has not yet been uploaded ."
    step 2 system "displays a success message and logs transaction" ef[1]
  }
  exception 1 "No records or data available" {
    step 1 system "prompts that If the Virologist attempts to view a plot or graph when data has not been uploaded into the iTrust2 system, an error message appears and the Virologist is advised to upload data before attempting to view statistics."
  }
  postCondition "System processes request successfully and logs transaction."
}
