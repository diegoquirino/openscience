systemName "iTrust2"
usecase "UC19 Food Diary" {
  version "3.0" type "Creation" user "Admin" date "30/10/2026"
  actor patient "Patient"
  preCondition "The iTrust2 user has authenticated themselves in iTrust2 (UC2) as a patient or HCP."
  basic {
    step 1 patient "Any patient may select to either view their food diary or add a new diary entry. If the patient selects to view their food diary, every diary entry is displayed with the information contained in with the most recent entries (by date of the entry in the food diary) being displayed first and calculates totals with . If patient selects to add a new diary entry, they enter the required information into the form . The patient submits the form and is sent to the page to view their food diary. Any HCP may view food diary entries (but may not create them) for a patient in the iTrust2 system. The HCP may search for patients, and upon selecting one, will see a food diary displayed exactly as the patient would ."
    step 2 system "displays a success message and logs transaction" ef[1, 2]
  }
  exception 1 "If there are no food diary" {
    step 1 system "prompts that If there are no Food Diary Entries for the patient, a message is displayed that there are none."
  }
  exception 2 "Invalid inputs are flagged and an" {
    step 1 system "prompts that Invalid inputs are flagged and an error message appropriate to the input is printed."
  }
  postCondition "System processes request successfully and logs transaction."
}
