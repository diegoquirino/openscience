systemName "iTrust2"
usecase "UC4 Demographics" {
  version "1.0" type "Creation" user "Admin" date "30/10/2026"
  actor hcp "Health Care Provider (HCP)"
  actor patient "Patient"
  preCondition "The iTrust2 user has authenticated themselves in the iTrust2 Medical Records system UC2."
  basic {
    step 1 patient "A patient may enter or edit their own demographic information. Details about the data format for demographic information is in Section 4.6 ." af[1, 2]
    step 2 system "displays a success message and logs transaction" ef[1]
  }
  alternative 1 "Must enter the mid of" {
    step 1 patient "HCP must enter the MID of a patient and then enter or edit demographic information ." bs 2
  }
  alternative 2 "May enter or edit their" {
    step 1 hcp "An HCP may enter or edit their own demographic information according to the data format in Section 4.6 ." bs 2
  }
  exception 1 "Invalid data field format" {
    step 1 system "prompts the patient or HCP to correct the format of a required data field because the input of that data field does not match that specified in Section 4.6."
  }
  postCondition "System processes request successfully and logs transaction."
}
