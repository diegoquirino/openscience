systemName "iTrust2"
usecase "UC10 Diagnoses" {
  version "4.0" type "Creation" user "Admin" date "30/10/2026"
  actor admin "Admin"
  actor hcp "Health Care Provider (HCP)"
  actor patient "Patient"
  preCondition "The iTrust2 user has authenticated themselves in iTrust2 . An HCP is a registered user of the iTrust2 Medical Records system . The HCP has authenticated themselves in the iTrust2 Medical Records system . The HCP has started documenting an office visit, including basic health metrics, for the patient [UC7 & UC8]."
  basic {
    step 1 hcp "The HCP selects the correct diagnosis from the menu of diagnoses options labeled by their ICD-10 codes and descriptions. They enter the following additional information about the diagnosis: the date of the office visit, HCP who diagnosed patient, and any notes. They press the Save Diagnosis button ." af[1, 2, 3]
    step 2 system "A message shows if the diagnosis was documented correctly." ef[1]
  }
  alternative 1 "View diagnoses and" {
    step 1 patient "The patient selects to view their diagnoses and data corresponding to the diagnoses. They cannot edit the diagnoses or the data associated with the diagnoses." bs 2
  }
  alternative 2 "Add diagnosis" {
    step 1 admin "The administrator enters the ICD-10 code and description of the diagnosis. They press Add Diagnosis ." bs 2
  }
  alternative 3 "Delete diagnosis" {
    step 1 admin "The administrator selects a diagnosis from the list of possible diagnosis, confirms the delete, and presses Delete Diagnosis to delete the diagnosis." bs 2
  }
  exception 1 "Invalid data field format" {
    step 1 system "prompts that An error message is displayed describing what entries do not conform to appropriate data formats as specified in 10.6."
  }
  postCondition "A success message is displayed and the HCP sees the saved information."
}
