systemName "iTrust2"
usecase "UC14 Alert Users by Email" {
  version "8.0" type "Creation" user "Admin" date "30/10/2026"
  actor hcp "Health Care Provider (HCP)"
  actor user "User"
  preCondition "There is an active authenticated session."
  basic {
    step 1 user "The user has successfully changed his/her password (UC11, S1/S2). An email informing the user of the password change is sent to the user including the MID but not the password." af[1, 2]
    step 2 system "displays a success message and logs transaction"
  }
  alternative 1 "The status of an appointment" {
    step 1 hcp "The status of an appointment request has been changed by the HCP involved in the request (UC6, S3). An email informing the patient of their appointment status is sent." bs 2
  }
  alternative 2 "Account has been locked out" {
    step 1 user "A user account has been locked out, either temporarily or permanently, due to too many failed logins. An email informing the user of their lockout is sent." bs 2
  }
  postCondition "System processes request successfully and logs transaction."
}
