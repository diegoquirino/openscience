systemName "iTrust2"
usecase "UC1 User Functionality" {
  version "3.0" type "Creation" user "Admin" date "30/10/2026"
  actor admin "Admin"
  preCondition "The iTrust2 Admin has authenticated themselves in the iTrust2 Medical Records system UC3."
  basic {
    step 1 admin "An Admin enters a user name, a password, confirm password, the role, and if the user is enabled (or active) in the system. The Admin presses the button to add the user . The user name serves as the User's Medical ID (MID). The possible roles are: Patient Health Care Provider (HCP) Admin Emergency Responder (ER) Lab Tech" af[1]
    step 2 system "displays a success message and logs transaction" ef[1, 2]
  }
  alternative 1 "Delete user" {
    step 1 admin "An Admin selects a user from the list of possible users, confirms the delete, and presses the button to delete the user." bs 2
  }
  exception 1 "Invalid data field format" {
    step 1 system "prompts the Admin to correct the format of a required data field because the input of that data field does not match that specified in Section 1.6."
  }
  exception 2 "Password confirmation mismatch" {
    step 1 system "prompts that The password and repeated password must match or an error is displayed."
  }
  postCondition "A success message is displayed and the action is logged."
}
