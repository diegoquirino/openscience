# ==============================================================================
# CLARET Version Control System - Environment Configuration (.env.example)
# Copy this file to .env and fill in your real credentials and paths.
# ==============================================================================

# GitHub Authentication & Default Repository
# Personal Access Token with repo / releases / tags permissions
GITHUB_TOKEN=ghp_exampleFakeToken1234567890abcdefghijklmn

# Default GitHub repository in owner/repo format
GITHUB_REPO=diegoquirino/openscience

# Default working branch name (and default integrator directory name)
GITHUB_BRANCH=claret-version-control-system

# Path to the compiled claret-generator standalone FAT JAR (Java 26 / CLI)
CLARET_JAR_PATH=../claret-generator/target/claret-generator.jar

# Java Executable (Optional: default is 'java' in PATH)
JAVA_CMD=java

# LLM API Configuration for Translation (Optional / Fallback)
# Used when translating complex natural language requirements in .claret files
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyExampleFakeGeminiApiKey123456789
ANTHROPIC_API_KEY=sk-ant-exampleFakeAnthropicApiKey123456789

# Default target locale for translation (e.g., en-us, pt-br, es-es)
DEFAULT_TARGET_LOCALE=en-us

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
