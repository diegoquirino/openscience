# Copy to .env for local staging (docker compose --profile staging up --build).
# Never put production values here; production reads them from Secret Manager.
SPRING_PROFILES_ACTIVE=staging
DB_URL=jdbc:mysql://mysql:3306/veredito
DB_USER=veredito
DB_PASSWORD=veredito-local
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
